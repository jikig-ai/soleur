// Soleur architecture — consolidated C4 model (single source of truth).
// Every element is defined ONCE here; the views in views.c4 scope it to each
// C4 level (context / container / component) with clickable drill-down.
// Migrated 1:1 from the former Mermaid C4 diagrams (system-context, container,
// component-plugin) — union of all elements and relationships, nothing dropped.
model {

  founder = actor "Founder / Operator" {
    description "A workspace Owner using Soleur as their AI organization. Workspaces may have MULTIPLE Owners (ADR-038, ADR-073 team workspaces); Owner-shared surfaces (e.g. the operator email-triage inbox, ADR-066) are readable by every Owner, not just one founder."
  }

  // External actor — third parties whose inbound email is the operator
  // email-triage inbox's source (ADR-066 / mig 102).
  emailSender = actor "Inbound Correspondent" {
    #external
    description "Vendors, regulators, and counsel emailing the operator address. Their statutory/operational mail is the email-triage inbox's inbound source."
  }

  // External actor — an involuntary third-party data subject whose conversation
  // PII the operator captures in the beta-CRM (ADR-102 / mig 126). The operator
  // is the controller; the beta tester never touches the store directly.
  betaContact = actor "Beta Tester / Prospect" {
    #external
    description "A beta tester or prospect the operator is in sales/product conversations with. The origin of the third-party contact + conversation PII captured in the owner-private beta-CRM (beta_contacts / interview_notes). An involuntary data subject (Art. 14); no direct access to the store."
  }

  // External actor — an UNTRUSTED pull-request author, distinct from the trusted
  // `founder` Owner above. In CI their PR-head code executes only in the
  // fix-constraints Stage A recovery producer (`pull_request`, contents:read, no
  // write/secret token); it never runs in the privileged Stage B consumer
  // (ADR-074). Operator-side, preflight Check 10 executes a plan-declared probe
  // inside a bwrap sandbox (ADR-175) — but running a checked-out PR head's tests
  // or scripts by hand is outside both boundaries. Keep this comment and the
  // description below in agreement; they disagreed once (#7393 review).
  contributor = actor "Contributor / PR Author" {
    #external
    description "An untrusted contributor opening a pull request. In CI their PR-head code executes only under pull_request isolation (fix-constraints Stage A: contents:read, no write token) and never in the privileged Stage B consumer, which opens a data-only draft follow-up PR from the default branch (ADR-074). The one PR-head artifact preflight executes on the operator's own workstation — a plan-declared discoverability probe — runs inside a bubblewrap sandbox with no credential stores bound and the repo read-only, failing closed if that sandbox cannot be established (ADR-175); its residual reach is host-loopback and outbound network (#7412). Other operator-side execution of a checked-out PR head (running its tests, its scripts, its hooks) is covered by NEITHER boundary."
  }

  // ---- Soleur Platform (enterprise boundary) -----------------------------
  platform = system "Soleur Platform" {

    webapp = system "Web Application" {
      description "Next.js PWA providing dashboard and conversation UI"

      dashboard = container "Dashboard" {
        technology "React, Next.js"
        description "Conversation UI, knowledge base viewer, session management"
        style { shape browser }
      }
      api = container "API Routes" {
        technology "Next.js API"
        description "REST endpoints for auth, sessions, and agent control. Registers in-process Agent-SDK options.hooks (sandbox, subagent-audit, phase-surface, tool-attempt-telemetry, context-queries) on web agent sessions — settingSources:[] isolates these from the CLI .claude/ shell Hook Engine (ADR-070 #5772, #5843; ADR-086 #6046)."
      }
      auth = container "Auth Module" {
        technology "Supabase Auth"
        description "JWT authentication, OAuth providers, session tokens"
      }
    }

    engine = system "Cloud CLI Engine" {
      description "Claude Code instances executing agent workflows"

      claude = container "Agent Runtime" {
        technology "Claude Code"
        description "Executes agent workflows with full orchestration tools"
      }
      skillloader = container "Skill Loader" {
        technology "Plugin Discovery"
        description "Discovers and loads skills, agents, commands from plugin directory"
      }
      hooks = container "Hook Engine" {
        technology "PreToolUse Guards + Rewriter + PostToolUse hints"
        description "Guards tool calls (blocks commits to main, rm -rf, etc.) AND injects additive context — phase-surface hints (ADR-070) and declarative skill context_queries (ADR-086). CONSUMES a MODEL-CONTROLLED tool-call envelope on stdin: that input is untrusted and is parsed without shell evaluation, with each contracted field type-asserted rather than coerced (ADR-156, #7164 — an array tool_input.command previously reached eval AND evaded every anchored guard). Prior description said only what hooks DO, never what they CONSUME. A PreToolUse hook also has a THIRD disposition beyond allow/deny: it may REWRITE tool_input before execution and let the call proceed (ADR-162, #7165) — grep-rewrite.sh prepends a grep() redefinition that neutralizes the ugrep shim which reached 9.5 GB RSS against a 21 kB file, leaving the command byte-identical. Bounded by a SINGLE-REWRITER invariant: updatedInput REPLACES tool_input (it does not merge), a sibling deny still wins, and permission rules match the ORIGINAL command. Additionally, in the repo-local `.claude/` hook surface only — never the shipped plugin surface — it enforces host resource control: at SessionStart it adopts the agent process tree into a memory-capped systemd transient scope (ADR-161). Where this container runs server-side there is no per-user systemd bus, so that path declines and does nothing. TWO HARNESSES: `.claude/hooks/` (Claude Code) and three blocking PreToolUse mirrors in `.openhands/hooks/`, which consume a different envelope over a protocol with no `ask` state — so ADR-157's posture is split by reason class there (ADR-165). On the `.claude` side exit 0 is the precondition for that posture at all: a non-zero exit makes Claude Code discard the hook's stdout JSON entirely (#7190). The two-harness enumeration describes where hook CODE lives; since ADR-178 (#7409) it no longer describes where its concurrency layer comes from — `lib/incidents.sh`, `lib/log-rotation.sh` and `pre-merge-rebase.sh` source the session-state lock/lease primitives from a THIRD, shipped location inside the deployed plugin root, reaching in from the repo side."
      }
    }

    plugin = system "Soleur Plugin" {
      description "plugins/soleur/ — skills, agents, knowledge base, AND the shared bash primitives shipped for execution on an installed user's machine (ADR-178, #7409): scripts/lib/session-state.sh is the cross-session lock/lease layer that gates worktree reaping. It lived under .claude/hooks/ until #7409, i.e. outside the subtree marketplace.json copies, so every installed user ran with that layer silently replaced by no-op stubs. What this system SHIPS is therefore not only prose for an agent to read — it includes executable concurrency primitives whose absence is unobservable to the user."

      skills = container "Skills" {
        technology "Markdown SKILL.md"
        description "61 workflow skills — brainstorm, plan, work, review, compound, etc."
      }
      agents = container "Agents" {
        technology "Markdown Agent Defs"
        description "65 domain agents across 8 departments"
      }
      kb = database "Knowledge Base" {
        technology "Markdown + YAML"
        description "Conventions, learnings, ADRs, specs, plans, brainstorms, C4 diagrams (spec/model/views .c4 + the layouted model.likec4.json), the domain-model business-rules register, and the sync coverage summary"
      }

      // C4 L3 — components inside the Soleur Plugin
      go = component "go command" {
        technology "Entry Point"
        description "Classifies intent and routes to workflow skills"
      }
      sync = component "sync command" {
        technology "Entry Point"
        description "Populates knowledge-base from existing codebase"
      }
      help = component "help command" {
        technology "Entry Point"
        description "Lists all available commands, skills, and agents"
      }
      brainstorm = component "brainstorm skill" {
        technology "Workflow"
        description "Explores requirements with domain leader assessment"
      }
      plan = component "plan skill" {
        technology "Workflow"
        description "Creates implementation plans with research and domain review"
      }
      work = component "work skill" {
        technology "Workflow"
        description "Executes plans with incremental commits and test-first"
      }
      review = component "review skill" {
        technology "Workflow"
        description "Multi-agent code review with 8 parallel reviewers"
      }
      compound = component "compound skill" {
        technology "Workflow"
        description "Captures learnings and promotes to constitution"
      }
      ship = component "ship skill" {
        technology "Workflow"
        description "Validates artifacts, creates PR, manages merge lifecycle"
      }
      oneshot = component "one-shot skill" {
        technology "Orchestrator"
        description "Full autonomous pipeline: plan, work, review, compound, ship"
      }
      architecture = component "architecture skill" {
        technology "Documentation"
        description "ADR lifecycle and C4 diagram generation"
      }
      cto = component "CTO agent" {
        technology "Domain Leader"
        description "Engineering assessment, architecture decision detection"
      }
      cmo = component "CMO agent" {
        technology "Domain Leader"
        description "Marketing assessment, content opportunities"
      }
      cpo = component "CPO agent" {
        technology "Domain Leader"
        description "Product strategy, UX flow analysis"
      }
      archstrat = component "architecture-strategist" {
        technology "Review Agent"
        description "Architectural compliance and ADR coverage check"
      }
      evalharness = component "eval-harness skill" {
        technology "Validation Gate"
        description "Validation-gates classifier-skill block edits (no-regression + target-passes)"
      }
      constraintscaffold = component "constraint-scaffold skill" {
        technology "Constraint Generator"
        description "Generates the L1 dep-cruiser import-boundary gate (client→server-secret) plus the two-stage pull_request→workflow_run auto-recovery workflows (ADR-074) into the product codebase CI"
      }
    }

    infra = system "Infrastructure" {
      description "Hosting, data, and zero-trust access"

      supabase = database "Supabase PostgreSQL" {
        technology "PostgreSQL"
        description "Users, BYOK-encrypted API keys, conversation sessions"
      }
      operationalInbox = database "Operational Inbox" {
        technology "Supabase (inbox_item, mig 122)"
        description "Severity-ranked operational-notification store (ADR-085, #6007). Mutable read/act/archive state, workspace-grain, Owner-shared reads — SEPARATE from the email-triage WORM statutory ledger. Content-minimized (title + source_ref ids only). GET /api/inbox merges it with email-triage into one severity-ordered feed (statutory pinned first)."
      }
      crmStore = database "Beta-CRM Store" {
        technology "Supabase (beta_contacts, interview_notes, beta_contact_stage_transitions, beta_contact_access_log; mig 126 + 127)"
        description "Owner-private beta-tester / prospect CRM (ADR-102, #6165). Third-party contact PII + dual-lens conversation notes + append-only stage-transition history. Owner-only RLS; writes RPC-only via auth.uid()-pinned SECURITY DEFINER functions; the cro/cpo agents read AND write via the crm_* MCP tools (agent-native parity). 24-month retention; Art. 17 via ON DELETE CASCADE + crm_erase_contact."
      }
      tunnel = container "Cloudflare Tunnel" {
        technology "cloudflared (ONE tunnel; ONE connector live in prod: web-1 — web-2 retired 2026-07-17 (#6538/#6463). The web_tunnel_connector gate is construction-time only)"
        description "Zero-trust inbound access — no exposed ports. ONE tunnel (tunnel.tf) with THREE ingress rules (deploy./ssh./registry.). DETERMINISM IS NOW STRUCTURAL, not one-connector: since #6594/PR-A all three ingress services are ORIGIN-RELATIVE (deploy. → http://10.0.1.10:9000, ssh. → ssh://10.0.1.10:22, registry. → tcp://10.0.1.30:5000), so whichever connector replica CF selects proxies to the correct origin (ADR-114 I2 discharged for all three). This — not 'localhost: means this host' — is what makes the management plane deterministic. NOT AN INVARIANT: the earlier 'exactly ONE connector, ADR-114 I1 enforced #6425' claim is FALSE in production. The server.tf web_tunnel_connector gate lives at cloud-init create-time user_data only, and hcloud_server.web carries ignore_changes=[user_data], so it never re-runs on a booted host. (Historical: web-2 booted 2026-07-13 BEFORE the gate merged 2026-07-15, so TWO connectors were live and measured; web-2 was retired 2026-07-17 (#6538/#6463) and var.web_hosts is now single-host.) I1 is a construction-time gate presented as a runtime precondition — it governs only future fresh hosts, and that stays true after #6441: the NIC gate added there is FIRST-BOOT (runcmd is once-per-instance), so a fresh connector host now waits for its private address before registering and DEFERS rather than aborting on timeout, but no gate re-runs on a host that is already up. CF binds ingress to a TUNNEL and picks a connector per edge colo; before the origin-relative pin a SECOND connector silently made every non-fan-out route (deploy-status, inngest-liveness, infra-config WRITEs, ssh.) answer from whichever replica the caller's colo selected — #6425 (16h of false inngest-down alarms), #6594 (a false-green infra-config apply), #6416. Origin-relative ingress makes that harmless: the coin flip no longer determines correctness. Standing guard: the */15 connector census in scheduled-inngest-health.yml (vantage-independent; a response-poll is colo-sticky and proves nothing). Management plane only: app.soleur.ai does NOT traverse the tunnel (direct CF-proxied A record, dns.tf); no cloudflared on zot/git-data/inngest (ADR-096)."
      }
      hetzner = container "Compute" {
        technology "Hetzner Cloud"
        description "Cluster of Hetzner Cloud hosts (Nomad clients, spread placement) running web app + CLI engine containers. Per-user worktrees are host-local in the ADR-068 §1 sense (they do NOT live on the shared git-data host) but they are NOT on the root NVMe — they sit on a per-host ATTACHED BLOCK VOLUME, workspacesVolume below (#6588 corrected this description, which said 'host-local NVMe' and led readers to conclude there was no volume to encrypt). At first boot a fresh host pulls the web app image from GHCR and extracts its baked bootstrap scripts + hooks.json.tmpl via docker cp (ADR-080, #5921) — a path web-1 can never take: the load-bearing reason is lifecycle{ignore_changes=[user_data]}, which means cloud-init never re-runs, so the bake reaches no live host (ADR-119 §(e)). ADR-143 (adopting, #6459) governs the return of a second web host: because cx33 was unorderable at the ADR-143 decision (2026-07-26 probe; still unorderable in hel1-dc2 on 2026-08-06, though it returned in nbg1-dc3/fsn1-dc14), web-2 returns as a fresh cattle **cpx22** (2c/4g x86, ~€19.49/mo net) — sized to web-1's MEASURED usage (~1.5 GB peak RAM / 0.48 load15 over 30d, not its over-provisioned 8g shape; ADR-143 D1) — a health-monitored standby at serving-weight 0 (NOT in the ingress rotation) until ADR-068 Phase-3 GA, since the sole-copy workspace volume lives on web-1 and a request routed to web-2 pre-flip would hit an empty workspace. TYPE REPINNED cx23 → cpx22 on 2026-07-26 (ADR-143 addendum, #6966), FORCED BY STOCK: the live probe that day (/v1/datacenters .server_types.available) found the ENTIRE cx line — cx23 as well as cx33 — and the ENTIRE cax ARM line orderable in 0 of 3 EU DCs, so the earlier 'cx23, in stock in hel1' claim recorded here is FALSE and is retired. cpx22 matches cx23 on cores and RAM exactly (2c/4g) and doubles local disk, so the D1 sizing rationale is unchanged — this was a price change (+€14.00/mo), not a resize. Read .server_types.available, never .supported (the hcloud CLI has the same trap). A fresh cpx22 CAN take the docker-cp bake path (unlike the frozen web-1). NOTE the DR gap the same probe exposes: web-1 (cx33), soleur-grok-dogfood (cx33) and soleur-registry (then cx23, repinned to cpx22 by #7309) all ran on types that were unorderable ON THAT DATE — restated 2026-08-06, when a live probe found both cx23 and cx33 AVAILABLE again in hel1-dc2, so the gap is not that these types are gone but that availability is not a property of the type and flips in either direction; each rebuild is a type decision even when the probe is green — they run fine but NONE can be COUNTED ON to rebuild on its current type (#6460) — the two cx33 hosts because cx33 is not orderable in hel1 where they run, and the registry (now cpx22) because a green probe is a moment, not a reservation. The fleet remains single-host until web-2 is provisioned by the gated web-host-create dispatch"
      }
      workspacesVolume = database "Workspace Git Data (/workspaces)" {
        technology "Hetzner Cloud block volume — guest-side LUKS2, mounted /mnt/data via /dev/mapper/workspaces, bind-mounted into the app container as /workspaces"
        description "Every user's checked-out repository. SOLE-COPY: refs/checkpoints/* is pushed by no refspec, session-sync.ts autocommits only knowledge-base/**, and signup-provisioned workspaces have no git remote at all — so ADR-068 §1's 'GitHub remains the durable rehydration source' does NOT hold here and there is no durable second copy anywhere (no upstream to rehydrate from). ENCRYPTED AT REST as of the 2026-07-23 cutover — the gap #6588/ADR-119 opened (PLAINTEXT ext4 while the published privacy policy claimed LUKS) is closed. HISTORY: an earlier 2026-07-20 cutover attempt (run 29782780158) landed /mnt/data on crypto_LUKS for ~27 minutes before its own dead-man timer silently remounted the retained plaintext volume over it (#6812) — do not cite that landing as the current state. The 2026-07-23 cutover is the one that certified: `workspaces-luks-verify` run **30040444418** reported `SOLEUR_WORKSPACES_READYZ ready=true writable=true populated=true workspace_count=8 expected=8` against `/dev/mapper/workspaces` — a mechanically measured verdict, not an assumed one (this distinction, per ADR-140, is the whole feature). web-2's instance was knowingly left plaintext (never served, empty) until its 2026-07-17 teardown (#6538/#6463). The fleet is single-host as of this writing, so no plaintext member remains — but that is a statement about the CURRENT fleet, NOT an invariant: the fresh web-2 (repinned cpx22, #6966) is born with its own per-host workspaces volume (hcloud_volume.workspaces, web-2 key) as RAW/empty PLAINTEXT, because the guest-side LUKS path for a FRESH host is the deferred #6931 work (ADR-141 D3) and the workspaces_luks attachment is web-1-bound and outside the birth fan-out (#6964). That member holds NO user data (sole copy is web-1's volume; web-2 is never routed pre-flip, dns.tf app record is web-1-only and the #6575 anti-pooling gate fail-closes), and it MUST NOT take serving weight while plaintext — re-evaluate at the ADR-068 Phase-3 GA flip"
      }
      inngest = container "Inngest Server" {
        technology "Dedicated Hetzner host, private-net 10.0.1.40:8288/:8289"
        description "Durable trigger layer for server-side agents — cron, oneshot, and HTTP-armed reminders. Extracted to its own single-host private-net node so exactly-one-scheduler is enforced by topology, unblocking active-active web (ADR-030, ADR-100, #6178)"
      }
      inngestPostgres = database "Supabase PostgreSQL (Inngest)" {
        technology "PostgreSQL — dedicated EU project, Supavisor session pooler :5432"
        description "Inngest config + run history. Dedicated project isolates connection budget + fate from the main app DB (#5450). Public tables RLS-locked; reachable only as the postgres owner (ADR-030 I8)"
      }
      inngestRedis = container "Inngest Redis" {
        technology "Self-hosted Redis — AOF on /mnt/data"
        description "Inngest durable queue + run-state. AOF on the persistent volume survives a host re-provision — the armed-reminder durability fix (#5450). AT REST: PLAINTEXT ext4 (`hcloud_volume.inngest_redis`, `format = \"ext4\"`, no LUKS apparatus — inngest-host.tf) — a seized/snapshot disk exposes the queue + run-state AOF, i.e. in-flight job payloads. Recorded as a ledgered exception (encryption-posture-ledger.json, tracking #6894), pending its own guest-side LUKS cutover"
      }

      // ---- Multi-host /workspaces cluster (ADR-068, #5274 — adopting) ------
      // Staged Approach A. Live-handle state stays host-local. Phase 3 GA is
      // USER-STICKY (ADR-068 2026-07-01 amendment): a session routes to the host
      // holding that user's per-user worktree lease; control ops are sticky to
      // the owner (NO cross-host forwarding). Redis enters at Phase 4a. GA at P3.
      coordinator = container "Session Router" {
        technology "Node — co-located sticky reverse-proxy"
        description "Co-located stateless sticky router (in each web-host process, not a separate box) — resolves a session's owning host from the per-user worktree lease at the WS-upgrade handshake; local ⇒ serve, remote ⇒ proxy over one-way-TLS private net. Control ops are host-local (no cross-host forwarding). Lease in Postgres (ADR-068 user-sticky amendment)"
      }
      scheduler = container "Nomad Scheduler" {
        technology "Nomad (Phase 4a)"
        description "Placement, health-reschedule, and rolling deploys across the Hetzner cluster (ADR-068 Phase 4a)"
      }
      gitDataStore = database "Shared git-data" {
        technology "Bare git repos over private net"
        description "Shared bare git repos (objects/refs) over the private net; per-user worktrees stay host-local on NVMe. The git-data host holds the per-ref monotonic max generation and writer-side-CAS-rejects stale lease writes (ADR-068). NOT YET PROVISIONED (#6977): this element is DECLARED in IaC and the host has never existed — an authenticated `terraform state list` returns zero git-data members — so every behaviour described here is the TARGET state, not the live one. It remains unborn until the gated `git-data-host-create` dispatch runs. The birth-readiness interlock that held that route is RELEASED by #6982, which ships the off-host emitter (ADR-149 item 1): the host now emits boot-stage fatals to Sentry from a baked DSN, a `stage:boot_complete` signal the birth job POLLS, and gc faults to Better Stack — so a green apply and a dark host are no longer indistinguishable. What holds the route now is MECHANICAL, not prose: `git_data_rung2_rehearsal_gate` (#6982 A3) runs in the same dispatch job before any provider is contacted and refuses unless `git-data-rung2-boot-evidence.env` attests a rung-2 boot rehearsal hash-bound to the CURRENT template — a hash-of-hashes over the cloud-init plus every `file()`-bound payload, so the evidence self-invalidates on any later edit to what ships. That file is absent, so a dispatch exits 1. #7025 shipped the gated rehearsal ROUTE that produces it (a separate Terraform root + `workflow_dispatch`), shipped unfired because a PR merges atomically, so evidence committed alongside its own harness would attest a rehearsal that never ran. CORRECTED 2026-08-03 (#7204): the route is NO LONGER unfired — it has been dispatched FOUR times (one dry-run success 2026-07-30, then three real-host failures) and has consumed three paid cpx22 hosts IN THE SEPARATE #7025 REHEARSAL TERRAFORM ROOT — which is why 'the host has never existed' above stays true: no rehearsal host is ever created at the hcloud_server.git_data address. The most recent, run 30649892865, died at `stage:luks_open` with mount(2) returning ESRCH: the birth `mkfs.ext4 -O quota,project` set the ext4 quota feature, whose mount forces `ext4_enable_quotas()` and a `quota_v2` module the 24.04 cloud image does not ship (linux-modules-extra absent). That is the CURRENT birth-blocking fact, fixed by #7204 (ADR-159) but NOT yet re-rehearsed — the evidence file is still absent, so the gate still refuses. The runbook banner is a FURTHER hold, not the only one. AT REST: the target store is PLAINTEXT ext4 (`hcloud_volume.git_data`, `format = \"ext4\"`, no LUKS apparatus) — a fresh `hcloud_volume.git_data_luks` cutover target is declared alongside it (git-data-luks.tf) but is not the live store (`GIT_DATA_STORE_ENABLED` gates the cutover). Ledgered exception (encryption-posture-ledger.json, tracking #6897), pending cutover"
      }
      sessionStore = database "Session Redis" {
        technology "Self-hosted Redis — TLS, EU (Phase 4a)"
        description "Self-hosted EU Redis — ADR-059 replay buffer + session/control state; network-reachable, per-workspace key namespacing, TLS + requirepass. DISTINCT node from the loopback Inngest Redis (ADR-068 Phase 4a). AT REST: unconfirmed from code alone — no session-store host posture probe exists in the code-sourced audit. Recorded as a ledgered exception rather than asserted (encryption-posture-ledger.json, tracking #6897), pending a live pull of the host's actual state"
      }
    }
  }

  // ---- External systems (third-party, outside the platform boundary) ------
  anthropic = system "Anthropic API" {
    #external
    description "Claude LLM for agent reasoning and tool use"
  }
  github = system "GitHub" {
    #external
    description "Source control, CI/CD, issue tracking, and releases"
  }
  cloudflare = system "Cloudflare" {
    #external
    description "DNS, CDN, R2 storage, and zero-trust tunnel"
  }
  doppler = system "Doppler" {
    #external
    description "Centralized secrets management with runtime injection"
  }
  discord = system "Discord" {
    #external
    description "Community notifications and release announcements"
  }
  stripe = system "Stripe" {
    #external
    description "Payment processing and subscription billing"
  }
  systemdUser = system "systemd (per-user manager)" {
    #external
    description "The operator's own per-user systemd manager, reached over the D-Bus socket at /run/user/<uid>/bus (SO_PEERCRED-authenticated, same uid only, no network). Owns the cgroup v2 hierarchy for the login session: the Hook Engine asks IT to create the memory-capped transient scope each agent session runs in, so systemd stays the SINGLE WRITER to that hierarchy and no component writes cgroup directories directly (ADR-161). Units are transient and self-clean when their last process exits, so nothing is provisioned and nothing persists across a reboot."
  }
  plausible = system "Plausible Analytics" {
    #external
    description "Privacy-focused website analytics"
  }
  resend = system "Resend" {
    #external
    description "Inbound email ingress (operator-inbox webhook, svix-verified) + transactional outbound (statutory triage notifications). Also the PUSH-FAILURE FALLBACK channel: a statutory push that reaches fewer than all devices falls back to Resend email (ADR-136, #6802). ADR-066."
  }
  pushService = system "Web Push Services" {
    #external
    description "FCM / APNs / WNS — the endpoint host each push_subscriptions.endpoint resolves to. Web Push delivery is transport-accepted (a 201), NOT proof of receipt (ADR-136). Non-410 failures do not prune the subscription and fall back to Resend email; the egress firewall's deliberate WNS DROP (#5046 PR-2) is the known trigger."
  }
  ghcr = system "GitHub Container Registry" {
    #external
    description "PRIVATE GHCR registry (ghcr.io/jikig-ai/soleur-web-platform + soleur-inngest-bootstrap) — the ORIGINAL host pull source, now WRITE-ONLY: still dual-pushed by CI, but DEAD AS A FALLBACK since the Phase-5 retirement — the read PAT is revoked (GET api.github.com/user -> 401) and the minter is disabled (GHCR_MINTER_DISABLED=true; pull-token mint -> 403 DENIED), verified 2026-07-30 (#7071). It receives every image and can serve none TO HOSTS. Scope that precisely: since #7277 it demonstrably serves CI, which reads it under packages: read to re-materialise the zot store (ADR-169). The dead edge is host->GHCR, not GHCR itself. This is STRUCTURAL, not a lapsed chore: App installation tokens authenticate docker login but are DENIED docker pull on private repo-linked packages (ADR-088 arm-b), so no zero-touch GHCR pull credential can exist FOR A HOST — only a personal one. This is scoped to App installation tokens on hosts and must not be read as absolute: a CI job's GITHUB_TOKEN in this repo's context is a different credential class, and it is what ADR-169's restore path uses. Consequence: zot is the SOLE pull path and the CI zot mirror is now release-blocking (ADR-096 amendment 2026-07-30). Still bakes the host bootstrap scripts + hooks.json.tmpl, extracted via docker cp at first boot to keep cloud-init user_data under Hetzner's 32,768-byte cap (ADR-080, #5921)."
  }
  projectZot = system "project-zot upstream registry (public)" {
    #external
    description "The PUBLIC upstream registry (ghcr.io/project-zot/zot-linux-{amd64,arm64}) that the registry host pulls its OWN zot binary from at boot. Added 2026-08-05 (#7282): this edge was entirely unmodeled, while the sibling ghcr node — scoped to our PRIVATE ghcr.io/jikig-ai/* packages — is marked DEAD on the pull path. Reading the two as one node is what let a LIVE dependency hide behind a DEAD one. Distinct trust boundary: this is third-party code entering the sole pull path's own host, mitigated ONLY by per-arch @sha256 digest pinning plus a committed provenance analysis (zot-image.provenance.md); there is no cosign verification of the zot binary itself, unlike the app images zot then serves. No bot mutates the pin — Renovate has never run here (measured 2026-08-05)."
  }
  zotRegistry = system "Self-hosted zot registry" {
    #selfhosted
    description "OCI-native container registry (zot) on a dedicated Hetzner host (cpx22, 2 vCPU / 4 GB, hel1, volume-backed) on the private network (10.0.1.30:5000), behind a deny-all-public firewall — the zero-touch machine-credential registry that replaces GHCR on the pull path (ADR-096, #6122). TYPE REPINNED cx23 → cpx22 on 2026-08-06 (#7309) — FORCED BY STOCK VOLATILITY, not by sizing and not by unorderability: cx23 IS orderable in hel1-dc2 as of that day's live probe, but hel1-dc2 cx23 availability changed direction twice across twelve days, the first inside 24 hours (in stock 2026-07-15 and 2026-07-25, unavailable 2026-07-26 and 2026-08-04, available again 2026-08-06 — series and sources single-sourced at zot-registry.tf, anchor 'STOCK REALITY'), and a registry type change is a destroy-then-create with no capacity reservation on the sole pull path (ADR-169), where a failed revert needs a SECOND create. cpx22 was available at all three probes. Same 2c/4g shape, so the derived arch stays amd64 and the cap stays 3072m; +€14.00/mo, operator-accepted, and not billing until the host-replace actually runs. TYPE + CAP CORRECTED 2026-08-05 (#7282): this description named a larger 4 vCPU / 8 GB server type and a hardcoded megabyte cap literal, and BOTH were stale — the file contradicted itself, correctly listing the registry's real type in its own DR-gap enumeration above. History, kept because it explains the shape: #6288 sized it cx33 in hel1 (the plan's cx32 target does not exist as a Hetzner type; cx33 is the real 8 GB type, offered in hel1 not nbg1), then #6497/#6463 REVERTED var.registry_server_type to cx23 on 2026-07-16 and the description never followed. The cap is not a literal at all — it is DERIVED as host RAM − 1024m reserve, so on the live 4 GB type it is 3072m, and the whole point of deriving it is that it cannot disagree with the host the way a hardcoded 7168m did. The cap exists so zot's ~35 GB store boot scan cannot host-OOM restart-loop the box. PINNED IMAGE (CODE-DECLARED / LIVE-PENDING, the same vocabulary this description already uses for LUKS): zot-registry.tf pins v2.1.20 per arch, but the LIVE host still runs v2.1.2 and will until the registry-host-replace apply fires (#7287) -- merging is inert by the OPERATOR_APPLIED_EXCLUSION contract, and the apply is blocked on #7278 and #6929 (#7277 closed by PR #7290; Hetzner stock struck 2026-08-06 by #7309, which repinned this host to a type available at every recorded probe — see the ADR-096 amendment). Do not read the pin as the running version; `zot_image_digest` in SOLEUR_ZOT_DISK is the off-host answer, and it only appears once the replacement host boots. Pulled from the PUBLIC upstream registry at boot, never from itself (the bootstrap paradox — which is also the rollback lever, since a dark zot cannot block its own replacement). FRESHNESS OWNER: no bot manages that pin (Renovate has never run against this repo — measured 2026-08-05, zero PRs, no Dependency Dashboard; its inert config was removed in #7282). Detection is a poll step on rule-audit.yml (1st + 15th) that files one idempotent issue; enforcement is zot-image-staleness.test.sh in infra-validation; the analysis of record is zot-image.provenance.md. Before #7282 the only mechanism was a prose comment telling a human to run crane digest, and the pin sat 18 releases behind for ~18 months. The 60 GB store volume re-fills ONLY from a fresh CI dual-push — NOT from GHCR. Its previous description as a 'disposable GHCR mirror' with an 'atomic GHCR fallback' is RETRACTED 2026-07-30 (#7071): the sibling ghcr node in this same enumeration is now marked DEAD AS A FALLBACK (read PAT revoked -> 401, minter disabled -> 403 DENIED), so an emptied store leaves NO registry any host can pull from until CI re-pushes. The blobs stay reproducible, so this is a recoverability property, never a free one — every recut/replace of this volume takes production's only pull path offline for the gap. Hosts pull the SAME @sha256 digests here (crane-copy from CI preserves them); cosign verifies the zot-stored .sig offline against the unchanged pinned root. Plain-HTTP on the private net (integrity via cosign digest-pinning, not TLS). AT REST: guest-side LUKS, CODE-DECLARED / LIVE-PENDING (`hcloud_volume.registry` is declared RAW — no `format` — and cloud-init-registry.yml luksFormats/luksOpens it as /dev/mapper/registry, keyed by random_password.registry_luks via doppler_secret.registry_luks_key). The LIVE device is still plaintext ext4 until the guarded `registry-luks-recut` workflow_dispatch is fired; that vehicle shipped UNFIRED (#6929), so this is a code-declared posture, NOT a live-verified one. Low sensitivity (our own OCI blobs + cosign signatures, no user/repo data); integrity comes from cosign digest-pinning, not at-rest encryption (encryption-posture-ledger.json) The 60 GB store volume re-fills EITHER from a fresh CI dual-push OR, since #7277/ADR-169, from a CI-mediated GHCR restore (scripts/registry-restore-from-ghcr.sh, chained automatically after registry-luks-recut). Its earlier wording denying any GHCR refill path is RETRACTED 2026-08-05 (the literal phrase is not repeated here: AC18 is a whole-file count, and quoting it would false-fail a corrected model). Note the restore is CI-mediated and carries the REQUIRED pin set only — it is not a mirror and not a host-reachable fallback, and its authorization condition is ADR-169's rehearsed-restore gate."
  }
  // Modeled #6698: the GitHub Pages custom-domain cert is issued by Let's Encrypt
  // via ACME HTTP-01, and that validation path was entirely absent from the model
  // even though a wedged `bad_authz` authorization is a recurring live incident.
  letsencrypt = system "Let's Encrypt" {
    #external
    description "ACME CA issuing the GitHub Pages custom-domain TLS cert for soleur.ai/www (ADR-125, #6657/#6698). Validation is HTTP-01 against GitHub's origin, which is why remediation must transiently flip apex+www to DNS-only — a Cloudflare-proxied record makes LE see CF anycast instead of GitHub's 185.199.x. TWO properties drive the design: (1) LE PREFERS IPv6 and retries over IPv4 only on a NETWORK-level failure of the first request (redirects get no retry), so a proxied AAAA that answers 200 with the wrong content defeats validation at any window length with no fallback — the propagation gate therefore requires AAAA ENODATA and treats a surviving AAAA as terminal, not retryable; (2) failed-validation rate limits are 5 per identifier per account per hour, refilling ~1 per 12 min with a compounding daily cap, and GitHub surfaces NONE of it — `GET /pages` returns the same `bad_authz` string whether the cause is DNS, timing, or a rate-limit pause. That invisibility is why probe-only mode (which consumes no validation attempt) is the DEFAULT for manual fires."
  }

  // Modeled #6698: the propagation gate reads PUBLIC recursive resolvers rather
  // than the container's, so they are a real external dependency of the
  // remediation path — the container's own resolver may be cached or
  // split-horizon and says nothing about what Let's Encrypt will see.
  publicResolvers = system "Public DNS resolvers" {
    #external
    description "Cloudflare 1.1.1.1 and Google 8.8.8.8, queried via node:dns Resolver.setServers() by cron-gh-pages-cert-reissue's DNS-propagation gate (#6698). Used to confirm the DNS-only flip actually reached the public internet before the cert poll begins — Cloudflare's TTL for proxied records is fixed at 300 s, so a proxy-status flip takes ~5-10 min to propagate and a poll started before then is guaranteed-wasted public-TLS-outage window. `dig` is deliberately NOT used: it is not installed in the app image (the Dockerfile installs only ca-certificates, git, bubblewrap, socat, qpdf, jq), so shelling out would throw at runtime."
  }

  betterstack = system "Better Stack" {
    #external
    description "External uptime/heartbeat monitoring (BetterStackHQ/better-uptime) AND a Logs warehouse (source 2457081, ClickHouse-SQL-queryable) that CI both POLLS and — since #7278/ADR-172 — WRITES TO. The 'CI polls read-only' clause this description carried until 2026-08-06 is FALSE and was corrected, not softened: registry-zot-inventory.yml POSTs a SOLEUR_ZOT_INVENTORY line to the Logs INGEST endpoint using BETTERSTACK_LOGS_TOKEN read from soleur/prd, and no GitHub Actions workflow had ever POSTed here before. A CI POST bypasses Vector's VRL scrub (every host emitter reaches this source through a Vector agent that redacts; a runner curl does not), so a CI-emitted marker must be PII-free BY CONSTRUCTION and is asserted so by a field allow-list test. The read direction is unchanged and is still the ONLY thing that grades a CI-emitted marker: the emitter's exit code is not evidence, so a run is green only after it reads its own run_id back out through the ClickHouse path (ADR-172 §2). Apex + inngest + registry-disk heartbeats, plus (#6438/#6548) TWO new per-host web heartbeats — web_zot_consumer (the zot-consumer serviceability probe, #6438 §1) and web_nic_guard (the §3 private-NIC-guard liveness beat, #6438 §3), both for_each var.web_hosts — and git-data, whose git_data_prd beat is FED by the web-host consumer probe (#6548) but is **deliberately NOT armed** — #6982 (D-HB) withdrew the plan to arm it, and #6548 alone now owns the decision. Three reasons, any one disqualifying: the `arm_one` call for it lives in the PER-MERGE apply job, so creating the heartbeat would make an unborn flag-off host's health a merge-blocking dependency for the whole repository; a TCP connect-and-close to :22 proves the port is OPEN, not that git transport SERVES, and sshd is up before runcmd runs — so a host whose LUKS never mounted answers on :22 and beats GREEN, installing a green light over the exact failure the interlock exists to catch; and the object pool may be at 10/10. git-data's boot correctness is instead reported HOST-SIDE by its own emitter (#6982). Registry-liveness remains paused until #6537's feeder ships and a beat is measured. All three new/newly-fed web beats (web_zot_consumer, web_nic_guard, git_data_prd) are arm-gated by the automated measure-then-arm PATCH in apply-web-platform-infra.yml (ADR-117 amendment #6438). ALSO a per-host origin absence detector that probes each web host's CF-proxied hostname (web-N.app.soleur.ai/health) directly, so a dead/never-booted host pages with per-host attribution the round-robin monitors cannot give (#5933 Item 1). The Logs source receives SOLEUR_ZOT_DISK + SOLEUR_PRIVATE_NIC self-reports from the deny-all registry host AND SOLEUR_PRIVATE_NIC from web-1 (the §3 web-host guard, detect+emit+alarm, NO reboot — ADR-123) and is polled from GitHub Actions via betterstack-query.sh for the zot restart-loop recurrence alarm (#6291) + follow-through soak probes — log-content recurrence alarms are in-repo GH-cron pollers, not native Better Stack alerts (ADR-096)."
  }
  // The error-tracking + alerting plane, managed as IaC (ADR-031, apps/web-platform/infra/sentry/).
  // Modeled late (#6436): it was absent while the narrower `betterstack` was present, so the C4
  // implied the platform had no alerting at all.
  sentry = system "Sentry" {
    #external
    description "Error tracking + alerting, Sentry-as-IaC (ADR-031; apps/web-platform/infra/sentry/, auto-applied on push to main by apply-sentry-infra.yml — its `paths:` filter is the whole `infra/sentry/**` tree and the plan is FULL-ROOT since #6589, so declaring a resource applies it and DELETING one really destroys it, gated pre-merge by `sentry-destroy-required` + `[ack-destroy]`. The filter was widened from a 3-file list because the retired `-target=` allowlist had doubled as the gate for declared-but-never-applied). Org `jikigai-eu` on the EU/DE cluster. TWO distinct hostname classes: the Terraform/dashboard API is the ORG SUBDOMAIN (`https://<org>.sentry.io/api/`, see main.tf's provider block — NOT `eu.sentry.io`, whose regional host rewrites `-eu`-suffixed slugs to the literal `eu` org via an activeorg-cookie hijack, 302→401, breaking every read/write); DSN ingest is `de.sentry.io` (DE residency, Art. 30 PA8 §(e)). Holds the LARGER of the two paging surfaces: the issue alerts (issue-alerts.tf), the cron monitors (cron-monitors.tf — one per scheduled workflow, `failure_issue_threshold` opens an issue on a missed check-in) and the uptime monitors (uptime-monitors.tf). It is a no-SSH paging path — a host that never finished booting still pages through here. It is deliberately NOT the only one: `betterstack` is a SECOND-SOURCE vendor that pages independently precisely so a Sentry outage is survivable (see its own edge to founder). Do not 'consolidate' the two — the redundancy is the design."
  }
  sigstore = system "Sigstore" {
    #external
    description "Keyless container-image signing/verification (cosign/Fulcio/Rekor). The release CI keyless-signs the pushed web app image digest (this IS a live sigstore call — github → sigstore below). The host then cosign-verifies the signature FULLY OFFLINE against a pinned trusted_root.json — it makes NO live sigstore call at verify time (ADR-087, #6005) — supply-chain authenticity for the shared host (#5933 Item 4)."
  }

  // External UNTRUSTED plugin SOURCE — the connected repo's OWN committed
  // `plugins/soleur/` directory. When an operator connects a repo that dogfoods
  // Soleur (soleur-in-soleur), that repo's frozen committed plugin copy lands in
  // the user's workspace. It is UNTRUSTED code: its `hooks/hooks.json` registers
  // `type:"command"` hooks that the Agent SDK would run as subprocesses of the
  // Node dispatch process (outside the bwrap tool sandbox, with the server's env +
  // privileges). Distinct from the platform-controlled `plugin` system above. The
  // untrusted-source counterpart to `contributor` (both #external, both gated by an
  // explicit trust boundary — see the `connectedRepoPlugin -> skillloader` edge).
  connectedRepoPlugin = system "Connected-Repo Plugin Copy" {
    #external
    description "The connected repo's own committed plugins/soleur/ dir, present in the user's workspace when they connect a Soleur-dogfooding repo. UNTRUSTED: its hooks/hooks.json command-hooks would run in the Node dispatch process (outside bwrap). INERT for the SDK — both real-SDK factories load plugins:[{path: getPluginPath()}] (the platform-deployed root), never this copy (ADR-093 trust boundary)."
  }

  // The customer's OWN knowledge base, inside their repo — the write target of
  // every sync producer. #external for the same reason connectedRepoPlugin is: it
  // is customer-owned content, not platform-controlled, and Soleur writes into it
  // on a fire-and-forget trigger at connect time (auto-sync-trigger.ts). Two
  // distinct writers reach this one directory (see the edges below), which is why
  // generated files carry a GENERATED header and the producer refuses to
  // overwrite anything lacking it (ADR-171). Durability is NOT assumed: per
  // sync.md's Headless Contract these are local commits in an ephemeral
  // server-side workspace until a PR merges, and the KB viewer reads the GitHub
  // source of truth rather than this on-disk clone.
  connectedRepoKb = database "Connected-Repo Knowledge Base" {
    #external
    description "The connected repo's own knowledge-base/ tree. Written by /soleur:sync producers (conventions, learnings, components, generated C4 diagrams, the domain-model register, kb-coverage.md) and by /soleur:architecture. Customer-owned: content committed here is permanent in their git history, which is why the coverage summary states Soleur's expectations rather than asserting business deficiencies (ADR-171)."
  }

  // ======================================================================
  // Relationships — preserved 1:1 from the three Mermaid sources.
  // ======================================================================

  // ---- C4 L1 (System Context) — 18 relationships -------------------------
  founder -> webapp "Interacts via browser" { technology "HTTPS" }

  // Host resource control (ADR-161). The Hook Engine never writes a cgroup
  // directory itself; it asks the user's systemd manager to create the scope.
  platform.engine.hooks -> systemdUser "Adopts the live agent process tree into a memory-capped transient scope under soleur-agents.slice (StartTransientUnit over D-Bus); systemd is the single writer — no raw cgroup directory writes. Repo-local `.claude/` surface only; declines where there is no per-user bus (ADR-161)" {
    technology "D-Bus (busctl --user)"
  }

  // The operator's only always-available stop mechanism, and what the memory
  // backstop had to preserve: adoption moves claude out of the terminal's cgroup,
  // so the reap is re-established as a unit dependency rather than cgroup
  // co-membership.
  founder -> systemdUser "Closes the terminal (stopping its scope), or runs `systemctl --user stop soleur.slice` as an explicit fallback — which stops EVERY agent session on the machine (ADR-161)" {
    technology "Terminal / systemctl --user"
  }
  systemdUser -> platform.engine.claude "Reaps the agent session by stopping its scope, via BindsTo= on the terminal's own scope — a UNIT dependency, because adoption moves the process out of the terminal's cgroup so co-membership can no longer do it (ADR-161)" {
    technology "systemd unit dependency"
  }
  webapp -> engine "Thin view/control layer" { technology "WebSocket" }
  webapp -> supabase "Auth and data" { technology "HTTPS" }
  webapp -> stripe "Checkout and billing" { technology "HTTPS" }
  webapp -> plausible "Page view events" { technology "JS snippet" }
  webapp -> github "Reads release notes for the in-app Releases page" { technology "HTTPS (GitHub REST API)" }
  engine -> anthropic "LLM calls with BYOK keys" { technology "HTTPS" }
  engine -> github "Git operations and CI" { technology "HTTPS/SSH" }
  engine -> supabase "Sessions and encrypted keys" { technology "HTTPS" }
  engine -> discord "Notifications" { technology "Webhook" }
  cloudflare -> webapp "Tunnel, DNS, CDN" { technology "HTTPS" }
  // #6698 — the cert-reissue remediation path (ADR-125).
  github -> letsencrypt "Places the ACME order for the Pages custom-domain cert whenever the cname is (re-)set — so every cname toggle consumes a validation attempt against limits that are hourly and COMPOUNDING (5 failures per identifier per account per hour). GitHub surfaces none of it: GET /pages returns bad_authz regardless of cause, which is why probe-only mode exists and is the default (ADR-125, #6698)." { technology "ACME" }
  letsencrypt -> github "ACME HTTP-01 validation of the soleur.ai/www Pages custom domain — reaches GitHub's origin ONLY while apex+www are DNS-only (proxied=false)" { technology "HTTP-01" }
  api -> publicResolvers "DNS-propagation gate: resolve4/resolve6 the apex against 1.1.1.1 + 8.8.8.8 to confirm the DNS-only flip propagated before polling the cert" { technology "DNS (node:dns Resolver)" }
  doppler -> engine "Runtime secrets" { technology "CLI" }
  stripe -> webapp "Payment webhooks" { technology "HTTPS" }
  emailSender -> resend "Sends email to the operator address" { technology "SMTP" }
  resend -> webapp "Inbound email webhook (operator inbox ingress)" { technology "HTTPS webhook (svix)" }
  webapp -> resend "Statutory triage notifications (outbound email), incl. the push-failure fallback (ADR-136)" { technology "HTTPS (Resend API)" }
  webapp -> pushService "Web Push delivery (VAPID); non-410 failures fall back to Resend email — the WNS egress DROP (#5046 PR-2) is the known trigger" { technology "HTTPS (Web Push / VAPID)" }

  // ---- Operational inbox (severity-ranked attention queue, ADR-085 / #6007) --
  // notifyInboxItem inserts the durable row (service role) then dispatches the
  // push/email nudge; GET /api/inbox reads the merged severity-ranked feed
  // (user-context client, RLS Owner-scoped); the inbox_list agent tool reads the
  // same merged feed (agent-native parity).
  webapp -> operationalInbox "notifyInboxItem writes inbox_item + GET /api/inbox reads the merged feed (RLS Owner-scoped)" { technology "PostgreSQL / PostgREST" }
  engine -> operationalInbox "inbox_list agent tool reads the same merged severity-ranked feed (agent-native parity)" { technology "MCP tool → PostgREST" }

  // Beta-CRM (ADR-102): two access paths now exist. The agent WRITES + reads via
  // crm_* MCP tools (mig 126); the read-only UI phase (mig 127, #6172) adds the
  // `webapp -> crmStore` read edge below. Both reuse the SAME owner-scoped RLS
  // boundary — the `webapp` path via GET /api/crm/* on the SSR cookie client,
  // with the detail read going through the auth.uid()-pinned crm_get_contact_detail
  // audit RPC. There is still deliberately NO `founder -> crmStore` edge (the
  // founder reaches it only through `webapp` or the agent).
  engine -> crmStore "crm_* MCP tools read AND write the owner-private CRM via auth.uid()-pinned RPCs (agent-native parity)" { technology "MCP tool → PostgREST / RPC" }
  webapp -> crmStore "GET /api/crm/* RLS-owner-scoped read routes (board/funnel/detail); crm_get_contact_detail logs each PII read to beta_contact_access_log (Art. 5(2))" { technology "PostgREST / RPC (SSR cookie client)" }
  betaContact -> founder "Conversation PII origin — the operator captures notes about this third party" { technology "Conversation" }

  // ---- fix-constraints two-stage privileged recovery boundary (ADR-074) ----
  // Trust boundary: the untrusted contributor's PR-head code runs ONLY in the
  // Stage A producer (read-only, no secret/write); the privileged Stage B
  // consumer — always run by GitHub from the default branch — opens a data-only
  // draft follow-up PR into the product codebase via the Git Data API (no
  // untrusted checkout, structurally clearing the toctou sink).
  contributor -> github "Opens untrusted PR — head code runs in fix-constraints Stage A (pull_request, contents:read, no write token) (ADR-074)" { technology "HTTPS" }
  github -> webapp "fix-constraints Stage B (workflow_run, PRIVILEGED, contents:write): opens a data-only draft follow-up PR via Git Data API — never checks out the untrusted tree (ADR-074)" { technology "HTTPS (Git Data API)" }
  // (#7091) DISTINCT from the ADR-074 Stage-B edge above: this one reads prod, it does not
  // write to GitHub. It exists because a release whose `deploy` job is SKIPPED leaves prod
  // stale while /health keeps returning 200 — the absence is the signal, so nothing on the
  // release-outcome path can report it. Deliberately GHA-fired rather than Inngest-fired:
  // an Inngest cron runs from the image currently deployed, so it would judge staleness
  // using the stale build's own logic and go dark exactly when it is needed.
  github -> webapp "Scheduled prod version-drift probe (*/30): reads the public unauthenticated /health for build_sha and asserts prod is missing no commit matching the release path filter, alerting only on staleness sustained past one release cycle" { technology "HTTPS (unauthenticated GET /health)" }

  // ---- C4 L2 (Container) — 24 relationships ------------------------------
  founder -> dashboard "Browses and converses" { technology "HTTPS" }
  dashboard -> api "Calls" { technology "HTTPS" }
  api -> claude "Spawns agent sessions" { technology "WebSocket" }
  claude -> skillloader "Loads plugin from the PLATFORM-DEPLOYED root (getPluginPath(), /app/shared/plugins/soleur) — never the connected-repo workspace copy (ADR-093)" { technology "File I/O" }
  // ---- SDK plugin-source trust boundary (ADR-093, fix-plugin-shadow-deployed-load) --
  // The untrusted connected-repo committed plugins/soleur/ is IGNORED by the loader:
  // both real-SDK factories (cc-dispatcher.ts + agent-runner.ts startAgentSession)
  // bind plugins:[{path: getPluginPath()}] (the platform-deployed root, workspace-
  // independent, boot-validated by verifyPluginMountOnce). Loading the workspace copy
  // would execute its hooks.json command-hooks in the dispatch process (outside bwrap)
  // AND silently shadow every platform plugin fix (#4826 delivery wedge). Even the
  // residual in-process SKILL.md reader (context-queries-hook) sources from the
  // deployed root. See knowledge-base/.../2026-07-06-connected-repo-shadows-deployed-plugin-*.md.
  connectedRepoPlugin -> skillloader "IGNORED by the loader (trust boundary): the committed workspace plugins/soleur/ is never the SDK load source — getPluginPath() (deployed root) is. Loading it would exec the repo's hooks.json in-process + shadow platform fixes (ADR-093, #4826)" { technology "File I/O (rejected)" }
  skillloader -> skills "Discovers" { technology "Directory scan" }
  skillloader -> agents "Discovers" { technology "Recursive scan" }
  hooks -> claude "Guards, annotates, and rewrites tool input before execution" { technology "Event hook" }
  claude -> hooks "Tool-call envelope on stdin — MODEL-CONTROLLED, UNTRUSTED (ADR-156): parsed without eval; input that cannot be fully parsed asks, never continues silently (ADR-157)" { technology "stdin JSON" }
  hooks -> plugin "Sources the shared session-state lock/lease primitives from the deployed plugin root (ADR-178, #7409) — lib/incidents.sh, lib/log-rotation.sh and pre-merge-rebase.sh reach into plugins/soleur/scripts/lib/. The dependency direction is the point: hook code in the repo depends on a file that SHIPS, which is why the file had to live inside the plugin rather than beside its consumers." { technology "Shell source" }
  hooks -> kb "Reads context_queries artifacts (skill-scoped injection)" { technology "File I/O" }
  api -> kb "Reads context_queries artifacts (skill-scoped injection, web in-process)" { technology "File I/O" }
  // #6750 — the ONLY inbound kb edge that is NOT an operator-attended session.
  // Every other one models a human-initiated in-session read/write; this one is a
  // scheduled server-side container authoring committed KB content unattended,
  // which the model previously did not represent at all.
  //
  // Attributed to `api` (container), NOT `inngest`: that host is a Go
  // queue/scheduler (ADR-100) and never opens a git workspace, so `inngest -> kb`
  // would assert an authorship path that does not exist — the same defect class
  // this edge was added to fix. Matches the model's own reasoning for Sentry
  // ("the Inngest-FIRED crons' check-ins are posted by the code `api` serves").
  // NOT `webapp` either: that is a SYSTEM, and all nine other inbound kb edges are
  // container/component level, so a system-level edge would draw a
  // different-altitude parallel edge beside the existing `api -> kb`.
  //
  // A second relationship on an existing pair is legal and already present in this
  // model (hetzner -> zotRegistry x2), and it is why the altitude had to be right.
  api -> kb "Scheduled UNATTENDED authorship: the Inngest-fired claude-eval crons spawn an agent into an ephemeral server-side workspace and land committed KB content via safeCommitAndPr (branch → PR → auto-merge squash). Liveness of that landing is asserted handler-locally per producer class (ADR-126 amendment, #6750)" { technology "Ephemeral git workspace → GitHub push/PR (safeCommitAndPr)" }
  skills -> kb "Reads/writes" { technology "File I/O" }
  agents -> kb "Reads/writes" { technology "File I/O" }
  api -> supabase "Auth and data; per-call audit_github_token_use write for every GitHub App-token use (reads AND Workstream issue writes, Art. 30 PA-16, ADR-109)" { technology "HTTPS" }
  claude -> supabase "Sessions and keys" { technology "HTTPS" }
  claude -> anthropic "LLM calls" { technology "HTTPS" }
  api -> anthropic "Daily org cost/usage report (Admin API, cost-report cron)" { technology "HTTPS" }
  claude -> github "Git operations" { technology "HTTPS/SSH" }
  tunnel -> coordinator "Routes traffic" { technology "HTTPS" }
  // #6425: the tunnel's ACTUAL ingress delivery, previously unmodelled — `tunnel -> coordinator`
  // above models the DEFERRED 3.D rewire, not today's path. Since #6594/PR-A, deploy./ssh. address
  // web-1's private IP (10.0.1.10) directly, so this edge terminates on web-1 no matter which host
  // holds the connector — determinism is now STRUCTURAL (origin-relative ingress), not a property
  // of there being exactly one connector (there are two live in prod; ADR-114 I1 is a create-time
  // gate that never re-ran on the already-booted fleet).
  tunnel -> hetzner "deploy. → http://10.0.1.10:9000 (webhook) and ssh. → ssh://10.0.1.10:22 — ORIGIN-RELATIVE to web-1's private IP since #6594/PR-A (was localhost:, the ADR-114 I2 anti-pattern). Whichever connector replica CF selects now proxies to web-1, the only host that serves these routes — so the edge is deterministic BY CONSTRUCTION (I2 discharged), not merely 'inert while one connector holds'. Matches the registry. edge, already origin-relative (10.0.1.30). /hooks/deploy still fans out to peers over the private net (ADR-068 Option B); deploy-status, inngest-liveness and infra-config do NOT fan out — with the origin-relative pin they no longer need to, since they answer from web-1 regardless of colo. DELIVERY IS NOT ACTIVATION (ADR-161, #7103): the infra-config route WRITES files, and systemd reads a drop-in only when its unit is (re)started — so until #7146 this edge delivered corrected vector/inngest-heartbeat drop-ins, reported ok, and left both units running the revoked credential they had been started with. The handler now restarts the units it configures and reports a per-unit verdict the CI gate adjudicates, graded on effect (ActiveState + an advanced ExecMainStartTimestamp) because try-restart exits 0 on a failed unit and, on Type=simple, means 'forked' rather than 'running'. THE DELIVERY↔ACTIVATION BOUNDARY IS infra-config-install.sh's drop-in shape gate, and it is load-bearing rather than hygienic: systemd merges drop-ins AFTER the unit body and vector.service runs User=deploy, so once anything on this route can root-restart a unit, an unvalidated *.service.d/*.conf becomes arbitrary execution (User=root, a replaced ExecStart=). The gate ships before the DROPIN_TRY_RESTART grant for that reason; the ordering is an invariant, not a preference. #7220 CORRECTS TWO THINGS HERE. (a) 'The handler now restarts the units it configures' was only half-true from #7146 until #7220: the handler's own `systemctl daemon-reload` ran as User=deploy with NO sudoers grant, returned 'Interactive authentication required', and set -e aborted AFTER all 19 files were written but BEFORE any unit was reconciled — so this edge delivered 19/19 files, published a frame of HARDCODED ZEROS naming nothing (files_total=0, restarts:[] — the EXIT trap's constants, not measurements), and activated nothing, for ~3 months. It did NOT report per-unit verdicts: the handler died before the reconciliation loop, so there was never a verdict to report — that absence is PR-A's whole narrative and the reason the CI gate read files_total=0 as 'delivered nothing'. The two drop-in-only units carry drop-ins in FILE_MAP and are absent from RESTART_MAP, so THIS channel never restarted them — but 'neither RESTART_MAP nor the grant set' was wrong: inngest-server IS in the grant set (INNGEST_RESTART/START/STOP/QUIESCE/ENABLE). The honest claim, and it is no softer: the HANDLER's reload never ran, so activation VIA THE CONFIG CHANNEL never happened for either unit. A second, co-located channel exists — ci-deploy.sh's `case inngest)` runs inngest-bootstrap.sh as root, which itself does daemon-reload plus `systemctl restart inngest-server.service` and the heartbeat units — so incidental reconciliation may have covered some units on some deploys, and the config channel had no way to know which. Unknown coverage, not proven staleness. (b) The boundary is now TWO gates, not one: the drop-in shape gate PLUS a *.service CONTENT PIN (exact sha256), because a reload grant lets systemd adopt a rewritten FULL unit and a permitted-directive grammar cannot bound a file whose job is to carry ExecStart=. Generalised invariant: every content gate ships before the grant that makes its file class ADOPTABLE — not merely before the grant that restarts it." { technology "cloudflared ingress → 10.0.1.10 (ORIGIN-relative — ADR-114 I2 discharged, #6594)" }
  // #6416 / ADR-114 — the tunnel's three ingress rules, made explicit. The registry edge is
  // the ONLY origin-relative one (it addresses 10.0.1.30 directly), which is why it is the
  // pattern to generalize; the other two are connector-relative (`localhost:`) and therefore
  // resolve to whichever replica CF load-balanced onto, NOT to a chosen host.
  tunnel -> zotRegistry "registry. ingress → tcp://10.0.1.30:5000. ORIGIN-RELATIVE — whichever connector replica answers proxies to the correct zot host, but ONLY if that replica is a 10.0.1.0/24 member (ADR-114 I1). #6416 (historical): web-2 was not a subnet member, so CI's registry bridge failed and the zot mirror silently skipped (masked green by continue-on-error). web-2 was retired 2026-07-17 (#6538); the surviving web-1 connector is a subnet member, so this failure mode is closed. 2026-07-29 CAUSE CLASS (#7071) — a DIFFERENT failure on this same edge, recorded so the closed #6416 mode above is not re-derived as the explanation: CI's bridge failed with websocket: bad handshake, and THAT TIME the cause was the EDGE refusing the upgrade (CF Access rejecting a rotated service token), NOT a missing origin route — a missing route would handshake and fail origin-side. Root cause: every doppler_secret carrying a token declares lifecycle{ignore_changes=[value]}, so Terraform REPLACED the registry_push Access service token and could never propagate the new value; the stale one was still being served. Detected by scripts/check-cloudflare-token-drift.sh, now wired into scheduled-terraform-drift.yml + a release preflight. 2026-08-03 THIRD CAUSE CLASS (#7242) — this record's dichotomy (edge-refusal vs missing-route) was NOT exhaustive, and reading it as exhaustive is what misdirected the next investigation. A bad handshake means only that the tunnel could not complete an ORIGIN DIAL. Third case, measured: the route was present AND Access ADMITTED the request, but the origin was RESTARTING — zot crash-looping at ~4/min, which a tens-of-seconds docker login + three-tag crane copy is near-certain to straddle. The Access policy was intact and the connector had never dropped. So bad handshake is a SYMPTOM, never a cause: since #7242 the failing step branches on a verdict the job measured (scripts/zot-mirror-diagnosis.sh, ADR-166) rather than naming one. NOTE also that a plain HTTPS GET here returns an empty 200 BY DESIGN (tcp:// ingress is not a WS upgrade) and is not a health probe." { technology "cloudflared access tcp → raw TCP over WebSocket (tcp://, NOT http:// — #6122)" }
  github -> tunnel "CI reaches the deny-all-public zot host to dual-push release images, and reaches web-1's shell for the 16 terraform_data SSH provisioners — both ONLY through this tunnel, via CF Access service tokens (separate tokens per route, so registry-write rotates independently of host-shell access). ACCESS AND TUNNEL ARE SEPARABLE AND THIS EDGE DEPENDS ON BOTH — a distinction this model otherwise elides (there is no distinct Access node; it lives only in edge descriptions like this one). ADMISSION is decided by CF Access at the edge; TRANSPORT is the tunnel. They fail independently, and the Access failure is the one that looks healthy: cloudflared connects, the local 127.0.0.1:2222 listener opens, and `nc -z` succeeds, because the service-token handshake is refused only when a connection is actually proxied. 2026-07-28 CAUSE CLASS (#7095), a SECOND instance of the token-rotation shape recorded on the registry. edge above but on the ssh. route: the ci_ssh Access service token was rotated out-of-band during incident response, and since Cloudflare returns client_secret ONLY at create, both Terraform state and Doppler went stale invisibly while `terraform plan` stayed clean. Run 30650564509 built this bridge, DESTROYED terraform_data.{infra_config_handler_bootstrap,deploy_pipeline_fix}, and only then failed on `ssh: handshake failed: connection reset by peer` — leaving state emptier than reality and production undeployable for 3 days on a host whose cx33 type had 0/6 datacenter stock, i.e. unreplaceable. GATED SINCE #7133 (ADR-154): the shared cf-tunnel-ssh-bridge composite's FINAL step asserts Access still admits the credential and fails with a named reason (ci_ssh_access_denied / ci_ssh_liveness_unverifiable / ci_ssh_liveness_unavailable) BEFORE any caller's terraform runs. Repair path is the ci-ssh-token-replace dispatch arm, never a host replace." { technology "cloudflared access tcp/ssh (CF Access service token; admission liveness-gated in-bridge since #7133)" }
  hetzner -> tunnel "ONE web host runs a cloudflared connector in prod (web-1); web-2 was retired 2026-07-17 (#6538/#6463) and var.web_hosts is single-host. Historically TWO were live: the server.tf web_tunnel_connector gate (#6425) was meant to leave only web-1, but it lives at cloud-init create-time user_data and hcloud_server.web has ignore_changes=[user_data], so it never re-ran on web-2 (booted 2026-07-13, before the gate merged 2026-07-15). Registration is ALSO NIC-gated at first boot since #6441 (ADR-114 I1): runcmd waits for the host's expected private address before `cloudflared service install`, then defers rather than aborting — post-#6594 a connector without its private NIC serves NOTHING, since all three ingress services are private-IP-relative. Like the #6425 gate this is create-time user_data only, so NO gate re-runs on a host that is already up: web-1's LIVE registration is not NIC-gated and never will be by this mechanism. So ssh:// and deploy. ingress are NOT deterministic by one-connector — they are deterministic because #6594/PR-A made their services origin-relative to web-1 (ADR-114 I2 discharged). CF still picks a connector per edge colo; the origin-relative pin makes that choice irrelevant to correctness. NOTE: the 'in-band hostname tripwire' this edge previously credited to the SSH provisioners does NOT exist — measured 2026-07-17, zero host-identity assertions in the 12 connection{} inlines (ADR-068:413's claim is false). The only retained absorption layer is ADR-068's private-net fan-out (deploy only)." { technology "cloudflared (outbound QUIC; ONE connector live: web-1)" }
  hetzner -> claude "Hosts" { technology "Docker" }
  hetzner -> workspacesVolume "Stores every user's checked-out repository. Mounted at /mnt/data and bind-mounted into the app container as /workspaces (cloud-init.yml). The app container is the SOLE writer, which is what makes a container stop a sufficient freeze for the ADR-119 cutover — though `docker stop` defaults to a 10s grace then SIGKILL, so the cutover uses -t 120 plus interrupted-write asserts: a truncated file is otherwise rsynced and certified correct" { technology "guest-side LUKS2 on a Hetzner block volume, /dev/mapper/workspaces (ADR-119 cutover certified 2026-07-23; workspaces-luks-verify run 30040444418: ready=true, workspace_count=8 expected=8 — the earlier 2026-07-20 landing was auto-reverted by its dead-man 27 min later, #6812, and is superseded)" }
  doppler -> hetzner "Injects the web-host boot credential. The LUKS-at-rest passphrase (WORKSPACES_LUKS_KEY, ADR-119) is deliberately scoped to a DEDICATED prd_workspaces_luks config read by a read-only host token — NOT the shared soleur/prd config. Rationale is host-vs-CONTAINER, not host-vs-host (web-1 already carries full-prd, so there is no host blast radius left to buy): cloud-init runs `doppler secrets download --config prd` into the TMPENV that feeds `docker run --env-file`, so a key in shared prd would be readable via /proc/self/environ by the very agent code whose data it encrypts (CWE-522). The #6649 header-escrow R2 S3 creds (WORKSPACES_HEADER_R2_ACCESS_KEY_ID/_SECRET_ACCESS_KEY) + bucket name + endpoint are delivered via the SAME prd_workspaces_luks scoped read — never on the cutover's sudo argv" { technology "CLI (doppler run / scoped read-only service token)" }
  hetzner -> cloudflare "Uploads the LUKS header backup off-host to an R2 bucket (soleur-workspaces-luks-header) DISTINCT from the tfstate bucket (C4 escrow, ADR-119 #6649) — a BLOCKING pre-freeze gate: no off-host header ⇒ the cutover aborts before touching sole-copy data. LIMITATION: this single edge collapses BOTH R2 buckets (tfstate + header) into the one cloudflare node, so it does NOT visually encode the 'distinct blast radius' property — that lives only at runtime (workspaces-cutover.sh:185) + the workspaces-luks-header.test.sh reference-not-literal guard" { technology "aws-cli s3 (R2 S3-compat, --endpoint-url)" }
  doppler -> claude "Injects secrets" { technology "CLI" }
  auth -> supabase "Validates tokens" { technology "HTTPS" }
  api -> stripe "Checkout and webhooks" { technology "HTTPS" }
  claude -> stripe "invoice skill: create/finalize/send/chase via hosted Stripe MCP — OAuth, operator's OWN account; distinct credential plane from the webapp -> stripe billing edge; test-mode only in v1 (ADR-107)" { technology "MCP tool → mcp.stripe.com (HTTPS)" }
  api -> github "Workstream tab: reads connected-repo issues (REST) + Project v2 board Status (GraphQL); AND writes issues — create / title / label-driven status / close-reopen — via the audited GitHub App-token client (ADR-109). The board is the canonical Status store (ADR-097); a status write is a label mutation that the board-status-sync workflow (github-internal) mirrors. owner/repo/installation resolve from the active workspace (ADR-044), never request input. ALSO Pages cert admin: the cron-gh-pages-cert-reissue routine (served by this container, event-triggered) does PUT /pages cname-toggle to re-order a bad_authz TLS cert via a least-privilege App token holding BOTH administration:write AND pages:write — PUT /pages requires both, proven empirically (pages-only 403, admin-only 403, both 204); GitHub's REST docs do not state it (ADR-125, #6698)." { technology "HTTPS (REST + GraphQL)" }
  api -> cloudflare "cron-gh-pages-cert-reissue (ADR-125, AP-019): transiently PATCHes the apex+www dns_records proxied flag false→true to open a DNS-only window so GitHub/LE can validate the Pages cert origin, then restores proxied=true. A distinct Zone.DNS:Edit-only token (CF_API_TOKEN_DNS_EDIT), separate from the broad cf_api_token. This is the sanctioned narrow AP-001 exception — transient, self-reverting, single-attempt, human-gated (v1)." { technology "HTTPS (CF API v4 dns_records PATCH)" }
  github -> doppler "scheduled-terraform-drift's token-drift scan reads token-shaped keys across the soleur project's configs using per-config read-only service tokens delivered as ONE Actions secret holding a config-keyed JSON map; the config list comes from the committed inventory, never from a live listing, because no credential here can enumerate the project (ADR-168, #7234)" { technology "doppler CLI (config-scoped read service tokens)" }
  github -> cloudflare "apply-web-platform-infra.yml issues READ-ONLY GETs to the Cloudflare rulesets API (ADR-136, #6767): the pre-apply entrypoint gate (a step AFTER `terraform plan` and BEFORE the main `terraform apply`) and the guarded entrypoint-audit dispatch both enumerate a `kind=zone`/`kind=root` ruleset's phase entrypoint via CF_API_TOKEN_RULESETS and FAIL-CLOSED if a whole-list create-from-absent would clobber live dashboard-created rules. GETs only — no writes ride this edge; the ruleset APPLY itself goes through Terraform's cloudflare provider. Distinct from the api -> cloudflare DNS-edit edge (different token, different concern)." { technology "HTTPS (CF API v4 rulesets phase entrypoint GET, curl --max-time)" }
  dashboard -> plausible "Page view events" { technology "JS snippet" }
  api -> inngest "Sends events; serves functions" { technology "HTTP private-net :8288" }
  resend -> api "Inbound email webhook (svix-verified) → email-triage ingress" { technology "HTTPS" }
  api -> resend "Statutory triage notifications (single configured recipient; reads are Owner-shared per ADR-066). Also the push-failure fallback: the cron falls back here when a statutory push reaches fewer than all devices (ADR-136)" { technology "HTTPS" }
  api -> pushService "Web Push delivery (VAPID) for statutory deadline reminders; transport-accepted, not receipt (ADR-136)" { technology "HTTPS (Web Push / VAPID)" }
  inngest -> supabase "Email-triage claim/finalize writes (email-on-received)" { technology "PostgreSQL" }
  inngest -> inngestPostgres "Config + run history" { technology "PostgreSQL session pooler :5432" }
  inngest -> inngestRedis "Durable queue + run-state" { technology "Redis (AOF)" }
  inngest -> betterstack "Ships journald + host_metrics via Vector (arm64, aarch64 build) to Logs source 2457081; token in soleur-inngest/prd (ADR-100 Phase-1 caveat resolved, #6197). Source 2457081 is NOT isolated to this node — the web hosts ship to the SAME source (see the hetzner edge), and the two are told apart only by the per-host host_name discriminator, which web-1 currently POISONS: web-1 wears this node's host_name=soleur-inngest-prd until its recreate clears the stale label (#6616). The dedicated node's telemetry host (auto OS hostname) is soleur-inngest, which equals its hcloud_server.inngest name (inngest-host.tf) — NOT soleur-inngest-server-prd, which is a Better Stack heartbeat monitor name (inngest.tf), never a telemetry value" { technology "Vector → Better Stack Logs (HTTPS)" }
  hetzner -> betterstack "Ships journald + host_metrics via Vector to the shared Logs source 2457081 (per-host host_name discriminator; token BETTERSTACK_LOGS_TOKEN in soleur/prd); ungated from web_colocate_inngest so every web host ships logs post-ADR-100 (#6396). CREATE-TIME-RENDER CAVEAT (#6616, same class as the tunnel-connector coin-flip): the per-host host_name is a construction-time render, so web-1 — which predates #6396 and, under lifecycle{ignore_changes=[user_data]}, never re-ran cloud-init — still ships host_name=soleur-inngest-prd (its inngest-owned vector.service from the co-located era), colliding on source 2457081 with the dedicated Inngest node until web-1's next recreate. The invariant is enforced by the #6616 follow-through, not by the render alone" { technology "Vector → Better Stack Logs (HTTPS)" }
  hetzner -> inngest "Hosts (dedicated single-host node, private-net 10.0.1.40; removed from web cloud-init — ADR-100, #6178)" { technology "systemd" }
  hetzner -> zotRegistry "Pulls app image + baked bootstrap scripts/hooks + the cosign .sig at boot/deploy — zot-primary, dark-launch gated (attempts zot only when configured + /v2/-reachable + login ok); the SAME @sha256 digest dual-pushed from CI; verify is offline against the unchanged pinned root, no live sigstore call (ADR-096, #6122)" { technology "Docker/zot (private-net, plain-HTTP + insecure-registries)" }
  hetzner -> ghcr "DEAD EDGE as of 2026-07-30 (#7071) — kept because the CODE PATH still exists, not because it works. ci-deploy.sh still attempts this atomic fallback when zot is unconfigured/unreachable, but it CANNOT AUTHENTICATE: the read:packages PAT is revoked (401) and the minter is off (403 DENIED). Every traversal ends image_pull_failed, which is exactly how v0.244.1 left prod undeployable ~5h. Do NOT read THIS EDGE as redundancy for hetzner -> zotRegistry; there is none at host-pull latency. Scoped 2026-08-05: redundancy now exists OFF this edge — CI can re-materialise the store from GHCR (github -> ghcr read, ADR-169) — but that is a recovery path measured in minutes, not a fallback a host can take mid-pull. Restoring it needs a non-personal GHCR pull credential, which ADR-088 arm-b shows cannot exist today (#5921, #5887, #6005)" { technology "Docker/GHCR (code path live, credential DEAD)" }
  // #6438 §1 — the CONSUMER-perspective ("L3") private-net probe. The web host verifies from its
  // OWN vantage that it can actually SERVE an image from zot over the private net: an authenticated
  // (htpasswd Basic auth) HEAD of a known manifest at 10.0.1.30:5000 (200=servable→ping,
  // 404=store empty/detached→suppress, 401=auth broke=HARD fail). Closes the gap L1/L2 (ADR-115) +
  // the registry self-ping cannot see: the private net broken from a CONSUMER's view while the
  // registry thinks its own NIC is fine (#6400 shape). Feeds web_zot_consumer via a systemd timer.
  hetzner -> zotRegistry "CONSUMER serviceability probe (#6438 §1): web-zot-consumer-probe.sh HEADs a known manifest over the private net (authenticated htpasswd Basic auth) and pings the per-host web_zot_consumer heartbeat only on a 200; 404 (empty/detached store) suppresses the ping so absence alarms; 401 is a HARD auth failure, not 'alive'. Distinct from the pull edge above — this proves the store SERVES, not just that the auth gate answers" { technology "curl -u (private-net, plain-HTTP HEAD /v2/<repo>/manifests/<tag>)" }
  // #6548 — the git-data CONSUMER probe (fail-soft overlay). A bounded SSH connect-and-close to
  // 10.0.1.20:22 proves the private-net path to git transport is reachable; git-data is an OVERLAY
  // (not a hard dependency), so a single transient blip must not page — grace is relaxed and it
  // arms the previously-unfed git_data_prd beat.
  hetzner -> gitDataStore "CONSUMER reachability probe (#6548): web-git-data-probe.sh does a bounded SSH connect-and-close to 10.0.1.20:22 over the private net and pings the git_data_prd heartbeat on success. Fail-soft (connect-and-close, not a git ls-remote — the accepted reachability-vs-serviceability tradeoff for a v1 overlay); this is what finally FEEDS git_data_prd, previously unfed. NOTE (#6977): the probe RUNS today, but its target host has never been provisioned, so it is currently probing an address nothing answers on — the feeder is real, the endpoint is not yet" { technology "SSH connect-and-close (private-net, BatchMode ConnectTimeout)" }
  // #6438 §3 / ADR-123 — the web-host private-NIC self-report guard. Same in-surface emit as the
  // registry's SOLEUR_PRIVATE_NIC (this edge is the SECOND source of that event), but the web host
  // makes a STRUCTURALLY DIFFERENT decision: detect + emit + alarm, NO reboot (a web-1 reboot would
  // power-off the sole live origin). Re-anchored to content 2026-07-20 (#6575,
  // cq-cite-content-anchor-not-line-number): this cited apply-web-platform-infra.yml:878, which was
  // inside the `warm_standby` dispatch job deleted with the web-2 sweep — that line number now
  // points at unrelated apply-job SSH-key setup. The reasoning stands on its own. Cites ADR-115's reboot
  // blockers as the REASON it does not self-converge; remediation deferred to #6459 + operator.
  hetzner -> betterstack "Ships SOLEUR_PRIVATE_NIC from web-1 (the §3 private-NIC guard, #6438 §3/ADR-123) to the shared Logs source 2457081 — detect + emit + alarm, NO reboot (unlike the registry's self-converging guard). ALSO pings the web_nic_guard liveness heartbeat every healthy run so the fault-emitter is observable-when-healthy (a SOLEUR_PRIVATE_NIC that never fires is indistinguishable from a dead guard). Distinct from the Vector journald edge above" { technology "curl → Better Stack Logs + heartbeat (HTTPS)" }
  betterstack -> hetzner "Origin uptime probe at the LB-fronted app.soleur.ai surface (betteruptime_monitor.app/soleur_apex) — covers web-1 (the app A-record → web-1, dns.tf); the #5933 per-host web-<n> probe was RETIRED (CF 521, no per-host origin vhost). web-2 (the fsn1 warm standby) was retired 2026-07-17 (#6538/#6463) — the fleet is single-host, fully covered by the app.soleur.ai probe; no second host needs separate uptime coverage" { technology "HTTPS via CF edge" }
  github -> sigstore "Keyless-signs the released app image digest (cosign, OIDC→Fulcio→Rekor) (#5933 Item 4)" { technology "HTTPS (cosign)" }
  // ADR-136 / #6780 — the config-refresh channel for the dedicated Inngest host. CI ALSO
  // keyless-signs a SECOND artifact (the config bundle's manifest blob), dual-pushes it to
  // GHCR + zot, and the inngest host pulls+verifies+applies it in-place. Distinct from the
  // app-image edges above: a different OCI repo, a `sign-blob`/`verify-blob` shape (not image
  // sign), and a monotonic VERSION carried INSIDE the signed bytes (HARD-2). The host-side pull
  // edge is `adopting` — it activates when the consumer bake rides the #6178 cutover (PR #6348).
  github -> sigstore "Keyless-signs the config-refresh bundle manifest (cosign sign-blob, OIDC→Fulcio→Rekor) — the *.sh in-place refresh channel for the sole Inngest scheduler (ADR-136, #6780)" { technology "HTTPS (cosign sign-blob)" }
  github -> ghcr "READ path, added 2026-08-05 (#7277/ADR-169) and distinct from the config-bundle publish edge below. CI resolves production's pinned image digests and copies them (image + cosign sha256-<hex> signature tag) OUT of GHCR to re-materialise the zot store after a registry-luks-recut. This is the edge the whole recut authorization rests on, and it is deliberately NOT the failing component: the release pipeline's failing half is the PUSH into prod zot, while this READ half is measurably working. Runs under the job's GITHUB_TOKEN with packages: read — a different credential class from the host App-installation token ADR-088 arm-b rules out." { technology "crane digest + crane copy (GHCR read, packages: read)" }

  github -> zotRegistry "RESTORE path, added 2026-08-05 (#7277/ADR-169). After the recut destroys the store, a needs:-chained job copies the required pin set GHCR -> zot over the CF Tunnel bridge and verifies each reference's BLOBS with crane validate --remote, not just its manifest — zot gc can evict a layer, so a digest-only check goes green on an image no host can pull (measured). Rehearsed against a throwaway zot in the runner BEFORE the destroy; that rehearsal is what authorizes the destroy at all. Fail-loud with one operator action per enumerated exit code; resumable, so a partial pass is recovered by re-running. SECOND, INDEPENDENT TRAVERSAL added 2026-08-06 (#7278/ADR-172) — the READ-ONLY INVENTORY sweep: registry-zot-inventory.yml walks GET /v2/ -> /v2/_catalog -> /v2/<repo>/tags/list -> /v2/<repo>/manifests/<ref> (+ index recursion and the referrers API) over the SAME cloudflared access tcp bridge, as the PULL user, with curl+jq and NOT crane (crane collapses every failure to exit 1, so the verdict taxonomy could not key on status codes, and it would move egress into a second binary). GET/HEAD only, asserted at the wire by a recording origin in the tests. It accumulates blob sizes DEDUPLICATED BY DIGEST — a naive per-tag sum multiplies every shared base layer and yields a number with no relationship to the disk. It reaches the bridge with skip-docker-login: true, so ZOT_PUSH_* is never materialized into the runner; the guarantee is NON-MATERIALIZATION, not non-possession (the job still holds a soleur/prd-root Doppler token that COULD read them — Doppler tokens are config-scoped, not secret-scoped — so the script asserts at entry that ZOT_PUSH_USER/ZOT_PUSH_TOKEN are unset and exits non-zero otherwise). The WRITE half of this surface is NOT reachable and must not be re-proposed as though it were: the deny-by-default accessControl grants the pull user ['read'] and the push user ['read','create','update'], so NO user holds 'delete' (measured) and manifest DELETE is refused whatever the pinned build implements." { technology "crane copy + crane validate --remote (RESTORE); curl + jq GET/HEAD over /v2/ (INVENTORY) — both via cloudflared access tcp" }

  github -> ghcr "Publishes the keyless-signed config-refresh bundle (host-executed *.sh set + per-file sha256 manifest + signed monotonic VERSION) to GHCR (authoritative) + a best-effort zot mirror (continue-on-error, GHCR-direct host pull in v1); a Terraform-promoted INNGEST_CONFIG_DIGEST pointer in soleur-inngest/prd names the digest (ADR-136/ADR-128/ADR-096, #6780)" { technology "docker buildx push (GHCR) + crane copy (zot mirror, best-effort)" }
  inngest -> ghcr "ADOPTING (rides #6178 cutover, PR #6348): the config-refresh timer resolves INNGEST_CONFIG_DIGEST, pulls the signed bundle @sha256 GHCR-direct, cosign-verify-blob OFFLINE against the baked trusted root + config-workflow identity regexp (ADR-087), checks per-file sha256 + monotonic VERSION, and applies atomically via infra-config-install.sh — no host replace, outbound-only, no new inbound (ADR-136, #6780)" { technology "Docker/GHCR pull + cosign verify-blob (offline)" }
  // NOTE: the former `hetzner -> sigstore` verify edge was REMOVED (#6005/ADR-087) — it was
  // falsified: with a pinned local trusted_root.json + offline verify the host makes NO live
  // sigstore call at verify time. The signature bundle is fetched from `ghcr` (edge above).
  doppler -> inngest "Injects secrets — dedicated host's boot credential is scoped to the SEPARATE Doppler project `soleur-inngest` (its own `prd` root holds only inngest secrets: Postgres URI, freshly-rotated signing/event keys, Redis pw), NOT a `prd` branch config that would inherit all ~116 soleur/prd secrets (ADR-100, #6178; mirrors the soleur-registry isolation #6122)" { technology "CLI (doppler run soleur-inngest)" }
  // #6122 (ADR-096, isolation amendment) — the registry host's boot credential is scoped to a
  // SEPARATE Doppler project `soleur-registry` (its own `prd` root holds ONLY the 2 ZOT htpasswd
  // tokens), NOT a `prd` branch config that would inherit all 116 soleur/prd secrets. #6167 audits
  // the sibling branch-config over-reads (prd_git_data / prd_kb_drift_walker / prd_cla).
  zotRegistry -> projectZot "Pulls its OWN zot binary at boot from the PUBLIC upstream registry — NEVER from itself (bootstrap paradox). Per-arch @sha256 digest-pinned (local.zot_image_{amd64,arm64}), pinned at v2.1.20. The arch in each local's NAME must match the arch in its VALUE: the ternary on local.registry_arch picks one, so a swap boots an arm64 binary on the amd64 host and darks the sole pull path — zot-image-staleness.test.sh checks 2/4/5 are arch-keyed for exactly this. This edge is also the ROLLBACK LEVER: because it points at the public upstream rather than at our own zot, a dark zot cannot block its own replacement. Freshness is owned by a rule-audit.yml poll (issue-filing, advisory) + a CI gate; nothing auto-writes the pin (#7282, ADR-096)" { technology "Docker pull over HTTPS (public ghcr.io, digest-pinned, unauthenticated)" }
  doppler -> zotRegistry "Injects the registry-host boot credential (scoped to the isolated soleur-registry project's prd root — the 3 admitted secrets ZOT_PULL/PUSH_TOKEN + BETTERSTACK_LOGS_TOKEN, no soleur/prd inheritance)" { technology "CLI (doppler run soleur-registry)" }
  // #6244 (ADR-096, disk-observability amendment) — the deny-all-ingress, no-SSH registry host
  // self-reports its disk state directly to Better Stack Logs (was a heartbeat pinger only, via
  // the web-host probe). SOLEUR_ZOT_DISK is the in-surface probe that disambiguates
  // fs-not-grown / gc-too-slow / zot-crash without a host login.
  // #6415 / ADR-115 — a SECOND event type on this same edge: SOLEUR_PRIVATE_NIC. The host
  // self-asserts that its private IP is configured. It is emitted FROM the affected (blind)
  // surface because a NIC-less host keeps PUBLIC egress, so every off-host signal stays green
  // while the fleet's primary pull path is dead (#6400: 14 days).
  zotRegistry -> betterstack "Ships disk-state observability — df% of /var/lib/zot + resize2fs before/after + zot health — as one SOLEUR_ZOT_DISK event, plus a SOLEUR_PRIVATE_NIC private-NIC convergence event (#6415), to the isolated Logs source 2457081; token in soleur-registry/prd, queried via betterstack-query.sh --grep SOLEUR_ZOT_DISK|SOLEUR_PRIVATE_NIC (#6244/#6415). ALSO pushes two distinct absence-based heartbeats, whose scopes must not be conflated: the 900s disk beat pings on df alone, so it alarms HOST death but stays green with zot dead; the 60s liveness beat (zot-liveness-heartbeat.timer, #6537) pings ONLY while zot answers on the host's own PRIVATE IP — never loopback, since zot binds 0.0.0.0 and loopback answers on a NIC-less host (#6400). The liveness beat's monitor stays PAUSED until #6537's post-merge reprovision measures a real beat and arms it; consumer-perspective reachability is unbuilt (#6438 §1). DO NOT LOOK FOR A HOST-SIDE SOLEUR_ZOT_INVENTORY EMITTER — THERE IS NONE. That marker lands on the same source 2457081 but is emitted by GITHUB ACTIONS (see the github -> betterstack edge), not by this host, and it reads the token from soleur/prd rather than this host's isolated soleur-registry/prd copy. The reason is structural, not stylistic: the registry host is cloud-init-only (ADR-096), so adding any host-side emitter needs a host REPLACE, and a replace today opens /dev/mapper/registry against a still-plaintext ext4 volume (the LUKS recut is UNFIRED — #7287) and darks the sole pull path. CI-side emission is the entire near side of that deadlock (ADR-172 §8)" { technology "curl → Better Stack Logs + heartbeats (HTTPS, eu-fsn-3)" }
  // #6291 — CI reads back the SOLEUR_ZOT_DISK Logs source it ships to. The standing restart-loop
  // recurrence alarm (scheduled-zot-restart-loop.yml, */30) + the follow-through soak probes poll
  // source 2457081 over the ClickHouse SQL API; previously an un-modelled load-bearing edge.
  // #6415 — the same alarm now ALSO polls SOLEUR_PRIVATE_NIC and carries an independent NIC
  // verdict (not folded into its exit code, so a NIC fire is never mis-reported as a probe fault).
  github -> betterstack "Polls the SOLEUR_ZOT_DISK + SOLEUR_PRIVATE_NIC Logs sources (ClickHouse SQL via betterstack-query.sh) for the zot restart-loop recurrence alarm, the private-NIC convergence alarm (#6415), and follow-through soak probes. ALSO reads the heartbeats API read-only (GET /api/v2/heartbeats) from the scheduled-terraform-drift.yml heartbeat-live-reconcile job (#6549 item 2): it reconciles the LIVE paused/existence of each monitored heartbeat against the executable MANIFEST (heartbeat-manifest.ts) and flags fed-but-paused (the #6537 shape) or non-count-gated-absent-live (the #6548 git-data shape) — the live-state layer ADR-117's static guard cannot see. Distinct surface from the Logs poll above. SINCE #6178/ADR-146 this edge also carries a SAFETY-CRITICAL read: cutover-inngest.yml op=verify derives the double-fire scan window's trust anchor from the on-host flip-FSM transition row via the same Logs query path, so a retention miss or query failure degrades the anchor and ultimately FAILS the verify closed. SINCE #7278/ADR-172 THIS EDGE IS NO LONGER READ-ONLY: registry-zot-inventory.yml POSTs a SOLEUR_ZOT_INVENTORY marker to the Logs INGEST endpoint (https://s2457081.eu-fsn-3.betterstackdata.com/, Authorization: Bearer BETTERSTACK_LOGS_TOKEN). READ THE CONFIG NAME: CI reads that token from the **soleur/prd** root via secrets.DOPPLER_TOKEN_PRD — NOT from soleur-registry/prd, which is what the zotRegistry -> betterstack edge names for the HOST's copy. A reader who takes the isolated project's credential as CI's requirement will conclude, wrongly, that this needs a new Doppler grant; it needs none, and that is why the design is zero-Terraform (the soleur/prd copy is out-of-band and deliberately NOT Terraform-declared — ADR-172 §6). The POST is measured, not assumed: 202 on ingest, ~17 s POST->queryable, and the run is green only after the SAME ClickHouse read path returns the line carrying this run's run_id with enumeration_complete=true. Zero SOLEUR_ZOT_DISK control rows in the poll window means channel_dark, never marker_absent" { technology "HTTPS (ClickHouse SQL Logs read + Logs INGEST write + Uptime heartbeats API, eu-fsn-3)" }

  // ---- Sentry — the LARGER of two alerting planes (#6436, ADR-031) --------
  // Three emitters + a paging exit. It is NOT the only exit: `betterstack` pages
  // independently (see its edge to founder) — that second source exists so a Sentry
  // outage is survivable, and it is the property most worth not "simplifying" away.
  //
  // Deliberately NO `inngest -> sentry` edge: the Inngest Server host has no Sentry path
  // — its Vector sink was pivoted OFF Sentry's HTTP envelope endpoint onto Better Stack
  // Logs after ~6 PR cycles of interop failures (#4273; grep `[sinks.betterstack]` in
  // inngest.tf and the pivot note in inngest-bootstrap.sh). The Inngest-FIRED crons'
  // check-ins are posted by the code `api` serves (the `api -> inngest "serves functions"`
  // edge above), i.e. on the `webapp` edge below — EXCEPT the two Inngest-dispatched
  // monitors noted on the `github` edge, which check in from GitHub Actions.
  // Anchored on grep-able tokens, not line numbers — #6447's own rule, which this PR's
  // first draft broke here by minting fresh `file:<N>` citations into the C4.
  hetzner -> sentry "Host-side fatal + deploy telemetry, POSTed straight to the store API with the baked ${sentry_dsn} — the boot fatal-emit trap armed at the TOP of `runcmd:` in cloud-init.yml (before Doppler exists), ci-deploy.sh's deploy/sandbox-canary/cosign-verify/zot-fallback events, and container-restart-monitor.sh. Fail-open and SSH-free by construction: this is how a host that never finished booting still pages" { technology "HTTPS (Sentry store API, X-Sentry-Auth sentry_version=7)" }
  webapp -> sentry "Exceptions + debounced warns via the @sentry/nextjs SDK (sentry.client.config.ts / sentry.server.config.ts / instrumentation.ts, SENTRY_DSN) — the stack-keyed capture shape the issue alerts group on; AND the Inngest-fired crons' end-of-run check-ins (`postSentryHeartbeat` in _cron-shared.ts → /api/{id}/cron/{slug}/{key}/?status=ok|error, bounded retry #5728) that satisfy the 43 Inngest-substrate sentry_cron_monitors" { technology "HTTPS (Sentry SDK envelope + cron check-in API)" }
  github -> sentry "CI is both an emitter and the applier: the ./.github/actions/sentry-heartbeat composite posts ok|error check-ins from 9 workflows, in two groups — 5 GHA-`schedule:`-fired (scheduled-inngest-health, -zot-restart-loop, -realtime-probe, -prod-version-drift, and workspaces-luks-verify, whose native schedule is deliberate rather than incidental: it verifies web-1's own LUKS mount, and although the Inngest SCHEDULER moved to its own dedicated host at the #6178 cutover (ADR-100 — which supersedes the #5450 same-host durable-backend framing), Inngest still EXECUTES functions via a callback pinned to web-1 (sdk_url 10.0.1.10:3000/api/inngest), so an Inngest-dispatched verifier would die with its own subject — ADR-033's anti-circularity corollary, #6808) and 4 `workflow_dispatch`-only ones that Inngest DISPATCHES per ADR-033 (scheduled-terraform-drift, -domain-model-drift, -supabase-advisor-scan, and main-health-monitor — the fourth added by #7307, which REVERSED that workflow's documented Design-A posture of having no own Sentry monitor: Design A rested end-to-end liveness on a broken main going un-issued being a readable signal, and #7307 is the counterexample, since the executor filed nothing for four months). That second group is the third substrate: Inngest-scheduled but GHA-executed, so their check-in rides this edge, not webapp's. Of 54 cron monitors, 10 check in from here and 44 from webapp — these counts are parity-gated against their live derivations by plugins/soleur/test/c4-count-parity.test.sh (#7209), so a new emitter or monitor fails loudly here instead of staling this prose. apply-sentry-infra.yml also auto-applies the sentry root on push to main via the jianyuan/sentry provider (ADR-031 — no dashboard step; its `paths:` filter covers the WHOLE infra/sentry/ tree, per that workflow's own header). SEPARATELY, web-platform-release.yml POSTs directly to the store API from two inline curls — live-verify's emit, and the release-outcome job's mirror when the operator email does not deliver (tags gate=release-outcome, op=release-alert-undelivered, classifier=ok|failed) — an inline curl from the runner, on no SDK and no composite (#7138)" { technology "HTTPS (cron check-in API + Terraform provider, SENTRY_AUTH_TOKEN)" }
  github -> resend "The release-outcome operator email: an inline `curl` to the Resend API from the runner (NOT via webapp/api, which carry the statutory-triage edges), one of twelve Resend emitters under .github/ (#7299 added the twelfth: infra-validation.yml's notify-main-failure, which gives the new push-on-main infra trigger a consumer — a red main run nobody reads is the failure mode that PR exists to close) and the only one that fires regardless of which job in the release graph failed — `deploy`'s inline email and `reusable-release.yml`'s `notify-ops-email` step are job-scoped, so they are structurally silent for a failure outside their own job (#7138)" { technology "HTTPS (Resend API, inline curl from the runner)" }
  sentry -> founder "Pages the operator — the LARGER of two independent exits (betterstack is the other; a Sentry outage is survivable BY DESIGN). Issue alerts route actions_v2 notify_email → target_type IssueOwners with fallthrough_type ActiveMembers — 28 of the 29 IaC rules in issue-alerts.tf; `byok_cap_exceeded` alone deliberately sets fallthrough_type NoOne. A 30th rule is live in the project and ABSENT FROM IaC: the Sentry-default `Send a notification for high priority issues` — empty filters, null environment, NotifyEmailAction with target_type IssueOwners and fallthrough_type ActiveMembers. Its conditions are New/ExistingHighPriorityIssueCondition, i.e. FIRST-SEEN and ESCALATED-TO — NOT a recurrence of an issue that is already high priority. Since Sentry derives high priority from level, it is what actually routes a level=error event carrying no matching tag filter (the release-outcome mirror among them), and a repeat of an identical event is silent on this route. It is UI-managed, so ADR-031's IaC-is-the-source-of-truth posture does not cover it; tracked as #7142. NB IssueOwners has no ownership rule on this project, so the fallthrough is what actually reaches a human: a NoOne rule fires and pages nobody, by design there and a defect anywhere else. The cron monitors open an issue on a missed/failed check-in (failure_issue_threshold = 1) and the uptime monitors on downtime, both of which then fire that same email route" { technology "Sentry issue alert → email notification" }
  // The second-source exit. Load-bearing: uptime-alerts.tf's apex monitor says it plainly
  // — "independent vendor from Sentry. If Sentry itself is degraded ... this monitor still
  // pages." Absent from the model until #6436's review noticed the new sentry->founder edge
  // had claimed exclusivity it does not have.
  // (#6982) git-data reports its OWN boot correctness. TARGET STATE — the wire exists at
  // merge but is UNOBSERVED until the birth dispatch, exactly like the hetzner -> gitDataStore
  // probe edge below, whose description carries the same honesty marker.
  gitDataStore -> sentry "Boot-stage fatals and stage markers from a BAKED DSN, with NO Doppler fallback — so the channel still works when Doppler is itself the broken stage, which on this host is the most likely one. This is the interlock's sentinel: the deny-all host has no SSH, no console and no log shipper, so before #6982 a failed boot was readable only from on-host /var/log/cloud-init-output.log, i.e. by nobody. TARGET state — wired at merge, unobserved until the birth dispatch" {
    technology "curl -> Sentry store API (HTTPS)"
  }
  gitDataStore -> betterstack "A queryable second copy of the boot-completion signal and gc-fault events, posted by direct curl (NOT a Vector agent — git-data ships no host_metrics and so structurally cannot reopen the 3 GB/mo quota breach of 2026-06-10). Post-Doppler stages ONLY, by construction: the ingest token is readable only under `doppler run`, so early boot stages and fatals are Sentry-only without needing a flag. This is the channel the birth job POLLS for stage:boot_complete, because it is the only one scheduled-followthrough-sweeper.yml can authenticate. TARGET state — wired at merge, unobserved until the birth dispatch" {
    technology "curl -> Better Stack Logs (HTTPS)"
  }

  betterstack -> founder "Pages the operator INDEPENDENTLY of Sentry — the second source. The apex uptime monitor and the inngest + registry-disk heartbeats alert on downtime/missed beats (the git-data heartbeat does NOT — its FEEDER shipped (the web-host reachability probe, #6548) but the monitor itself is absent from live Better Stack and ships paused, so the beat has nowhere to land; #6548 alone owns arming it — #6982 examined and DECLINED to, see the betterstack element description; the registry LIVENESS heartbeat does not yet either — its feeder ships in #6537 and it is armed only once a real beat is measured post-reprovision); on the free tier this is email to the managed recipient, escalating via betteruptime_policy when var.betterstack_paid_tier is set. This is the exit that survives a Sentry-side outage, which is the entire reason the vendor is duplicated" { technology "Better Stack monitor/heartbeat → email (+ policy escalation on paid tier)" }
  // #6031 / ADR-088 — control-plane GHCR installation-token minter (cron-ghcr-token-minter,
  // every 20 min). Mints a 1h packages:read App installation token and writes it to Doppler,
  // retiring the interim read:packages PAT; hosts read GHCR_READ_TOKEN unchanged.
  // #6750 — the two edges below attribute an Inngest-FIRED
  // cron's writes to `inngest`, but `cron-ghcr-token-minter` is an `api`-served
  // Inngest function just like the claude-eval cohort, so by the rule applied at
  // `api -> kb` they belong on `api`. Left as-is deliberately rather than
  // re-pointed in an unrelated PR; tracked in #7046. Annotated rather than left
  // silent so the newer convention is not the minority with its rationale
  // attached only to the new edge.
  inngest -> github "Mints packages:read installation token every 20 min (ADR-088)" { technology "HTTPS (GitHub App JWT → /app/installations/{id}/access_tokens)" }
  inngest -> doppler "Writes GHCR_READ_TOKEN (1h scoped, prd_ghcr) (ADR-088)" { technology "HTTPS (Doppler REST API)" }

  // ---- C4 L2 — Multi-host /workspaces cluster (ADR-068, #5274) -----------
  // tunnel -> coordinator (above) replaces the former tunnel -> api ingress.
  coordinator -> claude "Places/routes sessions (lease-keyed)" { technology "HTTPS (private net)" }
  coordinator -> supabase "Reads worktree lease" { technology "PostgreSQL" }
  api -> sessionStore "Session/replay state" { technology "Redis (TLS)" }
  claude -> sessionStore "Replay buffer + control state" { technology "Redis (TLS)" }
  claude -> gitDataStore "Bare repo data; worktrees local (TARGET state — the store is declared but unprovisioned, #6977/ADR-149)" { technology "git over private net" }
  scheduler -> hetzner "Schedules" { technology "Nomad" }

  // ---- C4 L3 (Component — Soleur Plugin) — 21 relationships --------------
  // (the L3 `hooks -> claude` edge is identical to the L2 one above and is not
  //  re-declared; it still renders in the component view, which includes both.)
  go -> brainstorm "Routes explore/generate"
  go -> oneshot "Routes build"
  oneshot -> plan "Step 1"
  oneshot -> work "Step 2"
  oneshot -> review "Step 3"
  oneshot -> compound "Step 4"
  oneshot -> ship "Step 5"
  brainstorm -> cto "Phase 0.5 assessment"
  brainstorm -> cmo "Phase 0.5 assessment"
  brainstorm -> cpo "Phase 0.5 assessment"
  plan -> cto "Phase 2.5 domain review"
  review -> archstrat "Parallel review agent"
  cto -> architecture "Recommends ADR creation"
  archstrat -> architecture "Checks ADR coverage"
  claude -> go "User invokes /soleur:go"
  brainstorm -> kb "Writes brainstorms"
  plan -> kb "Writes plans and specs"
  work -> kb "Reads plans, writes code"
  compound -> kb "Writes learnings, promotes to constitution"
  architecture -> kb "Writes ADRs and diagrams"
  // sync had NO relationship edge at all until #7332, while every sibling skill
  // had one — the producers were invisible in the model that documents them.
  sync -> connectedRepoKb "Writes conventions, learnings, component docs, generated C4 (generated-components.c4 + model.likec4.json + c4-model.md), domain-model rows, and kb-coverage.md" { technology "File I/O + local git commit" }
  // The second writer of the SAME directory. /soleur:architecture writes spec.c4 /
  // model.c4 / views.c4 cwd-relative and the sandbox pins cwd = workspacePath, so
  // both skills land in one diagrams dir. ADR-171's precedence rule resolves it:
  // sync emits a distinct composing file and never overwrites a file lacking its
  // GENERATED header, so a hand edit always wins.
  architecture -> connectedRepoKb "Writes spec.c4 / model.c4 / views.c4 cwd-relative — same directory sync generates into (ADR-171 two-writer precedence)" { technology "File I/O" }
  compound -> evalharness "Validates classifier-skill edits before applying"
  constraintscaffold -> webapp "Generates L1 import-boundary gate (CI)"
}
