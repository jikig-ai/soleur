ref	scripts/followthrough-varq-ban	scripts/lib/trusted-verdict.sh	scripts/lint-followthrough-varq-ban.sh:318	a156176796ef/1	echo "$f:${lineno:-1}: rule 4: reads issue comments AND branches on a RESULT: verdict or an S<n>- soak marker WITHOUT routing the decision through scripts/lib/trusted-verdict.sh. This repo is PUBLIC with issues open, so an unfiltered '.comments[].body' accepts a verdict from ANY authenticated GitHub user -- one HTTP POST of 'RESULT: PASS' closes the tracker (#7448). Source the lib and call trusted_verdict_bodies (verdict text) or trusted_verdict_comments ({t,b} per comment, for markers). Do NOT re-inline an author-association select instead (rule 5): it is computed against the READING token's visibility, so a member with PRIVATE org membership renders as CONTRIBUTOR under GITHUB_TOKEN and their verdict is dropped silently (#6617: two months of nightly FAIL on an already-recorded verdict)." >&2
ref	scripts/followthrough-varq-ban	scripts/lib/trusted-verdict.sh	scripts/lint-followthrough-varq-ban.sh:354	0e28e1d32b7b/1	echo "$f:${hit%%:*}: rule 5: names the comment-author-association field on an executable line. A comment's association is computed against the READING token's visibility, so under the sweeper's GITHUB_TOKEN a member with PRIVATE org membership renders as CONTRIBUTOR and their comment is dropped silently (#6617, #8389, #9818). Decide trust from scripts/lib/trusted-verdict.sh (trusted_verdict_bodies / trusted_verdict_comments), which resolves effective repository permission. There is no per-line opt-out." >&2
ref	scripts/followthrough-varq-ban	scripts/lib/trusted-verdict.sh	scripts/lint-followthrough-varq-ban.sh:599	538ede2b0768/1	echo "FAILED: $violations violation(s) -- banned \x5c${VAR:?}/\x5c${VAR?} on an executable line (rule 1), the retired credential name (rule 2), a repo-relative path absent from this checkout (rule 3), a comment-verdict or soak-marker read that bypasses scripts/lib/trusted-verdict.sh (rule 4), the comment-author-association field named on an executable line (rule 5), and/or an /events/ call with no ordering bound (rule 6). See followthrough-convention.md §Author workflow." >&2
