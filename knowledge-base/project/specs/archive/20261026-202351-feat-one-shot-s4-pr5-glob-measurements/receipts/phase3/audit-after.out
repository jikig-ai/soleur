ref	.claude/hooks/pre-merge-rebase.test.sh	knowledge-base/engineering/architecture/diagrams/model.likec4.json	plugins/soleur/scripts/resolve-regenerable-conflicts.sh:160	032e0f0a25a5/1	RESOLVABLE_PATHS=("knowledge-base/engineering/architecture/diagrams/model.likec4.json") # RESOLVABLE-SET: default
ref	.claude/hooks/pre-merge-rebase.test.sh	plugins/soleur/skills/ship/references/merge-queue-dequeue.md	.claude/hooks/pre-merge-rebase.sh:740	58edbc2db184/1	_Q_NOTE=" Merge-queue state unreadable (cause=$_q_cause) for PR #$PR_HEAD_NUMBER, so the origin/main sync ran as if it were not queued; if it was queued, that push dequeued it. Re-check: bash plugins/soleur/scripts/sync-pr-behind.sh $PR_HEAD_NUMBER --queue-state; a result of dequeued: plugins/soleur/skills/ship/references/merge-queue-dequeue.md."
ref	.claude/hooks/pre-merge-rebase.test.sh	plugins/soleur/skills/ship/references/merge-queue-dequeue.md	.claude/hooks/pre-merge-rebase.sh:786	61e8481e2d27/1	additionalContext: ("Pre-merge hook: PR #" + $n + " is BEHIND with auto-merge armed (GitHub merge state BEHIND or UNKNOWN) and is not in the queue yet; skipped the origin/main sync. This skip is ALSO a refusal when the PR\x5cu0027s base branch has no merge queue or is not a supported branch name (both print the same answer, so this hook cannot tell them apart; read the base with gh pr view " + $n + " --json baseRefName): this hook and the Phase 7 poll\x5cu0027s fallback only merge origin/main, which is wrong for a PR on another base. For such a PR whose base has no merge queue, sync by hand against its own base (git fetch origin <base> && git merge origin/<base>, then push); if that base has a merge queue of its own, the queue makes the PR current and no sync is needed. Either way do NOT disarm and re-arm: disarming makes the next check find the PR disarmed, and this hook then merges origin/main. If the PR is based on main (a merge-queue repo): no sync is needed, the queue makes the PR current itself and a resync push restarts every required check for nothing. Red required check? Push the fix itself, not a resync. Green and never enqueued? Follow plugins/soleur/skills/ship/references/merge-queue-dequeue.md (\x5cu0027Armed and green but never enqueued\x5cu0027). For a main-based PR keep polling for MERGED: the Phase 7 poll\x5cu0027s expiry fallback is the sanctioned sync, and only for a main-based PR, if you truly need a hand sync, disarm first (gh pr merge " + $n + " --disable-auto), sync, then re-arm. A --admin merge bypasses the queue and lands the head as pushed, so a not-up-to-date refusal there is real: gate it with plugins/soleur/scripts/admin-merge-ready.sh.")
