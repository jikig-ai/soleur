          "fill": "$text-2",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "- Hosted version lives in a separate bordered card (bg-secondary, 1px border, 8px radius, 560px wide = existing .hero-waitlist-form max-width), labelled in sentence case.",
          "lineHeight": 1.5,
          "fontFamily": "$font-body",
          "fontSize": 13,
          "fontWeight": "normal"
