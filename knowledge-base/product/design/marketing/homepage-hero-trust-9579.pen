          "content": "- plugins/soleur/docs/index.njk lines 11-36; tokens from docs/css/style.css (.landing-hero, .hero-waitlist-form, .newsletter-privacy).",
          "lineHeight": 1.5,
          "fontFamily": "$font-body",
