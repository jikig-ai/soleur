        {
          "type": "text",
          "id": "sDMXv",
          "name": "Bullet",
          "fill": "$text-2",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "- Waitlist button is demoted to the outline (btn-secondary) style so two gold buttons do not compete. See open question on the 768px selector in C.",
          "lineHeight": 1.5,
          "fontFamily": "$font-body",
          "fontSize": 13,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "f6LeW",
          "name": "Bullet",
          "fill": "$text-2",
          "textGrowth": "fixed-width",
