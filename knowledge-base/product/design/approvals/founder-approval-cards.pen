                          "name": "Para 2",
                          "fill": "$text-soft",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "2. What we provide. We give you access to Soleur so that your team and your agents can plan, write and carry out work for your business, as described on our pricing page.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
