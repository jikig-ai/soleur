                          "type": "text",
                          "id": "EBJMN",
                          "name": "Para 1",
                          "fill": "$text-soft",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "1. Who these terms are between. These terms are between Jikigai (\"we\") and the business that signs up to Soleur (\"you\").",
