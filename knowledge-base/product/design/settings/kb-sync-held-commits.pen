                        {
                          "type": "text",
                          "id": "ymyUM",
                          "name": "held warning text",
                          "fill": "$--text-primary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "3 changed code files are not on your repository's main branch yet, and disconnecting deletes them with your workspace files. If they are not on a branch on GitHub yet, cancel and ask your agent to push them to a new branch, then approve the push.",
                          "lineHeight": 1.5,
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "oIRpZ",
                      "name": "dialog paragraph (unchanged)",
                      "fill": "$--text-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "This will unlink acme-co/web-platform from your account. Your workspace files will be removed. You can reconnect a repository at any time.",
                      "lineHeight": 1.5,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "h1lAxm",
                      "name": "actions",
