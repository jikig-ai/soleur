              "fontFamily": "Inter",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "uL9AM",
              "name": "Note",
              "fill": "$text-secondary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "5c: if Reconnect fails again the card is replaced in place (never stacked) and says when it re-checked and that the result is new, so it reads as a fresh answer, not a loop. Nothing is sent or retried behind the scenes.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 12,
              "fontWeight": "normal"
            }
          ]
