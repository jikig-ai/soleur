              "fontFamily": "Inter",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "EmDcd",
              "name": "Note",
              "fill": "$text-secondary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "5b: Reconnect shows a spinner and the word Reconnecting, and is disabled while it runs. The composer stays disabled until the check passes.",
