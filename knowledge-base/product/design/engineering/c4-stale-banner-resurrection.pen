              "fontSize": 11
            },
            {
              "type": "text",
              "id": "c4sb28",
              "name": "note2",
              "fill": "$--text-tertiary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Line-2 copy matrix: c4-edit ON → 'Save again to render the latest version' · flag OFF + canonical diagrams dir → 'Ask the Concierge…' (shown here) · non-canonical dir → 're-run the diagram export for this folder'. Warning-only by design while c4-edit is flag-gated — retry affordance tracked in #8987. aria-live=polite announces async resurrection to AT.",
              "fontFamily": "Inter",
              "fontSize": 11
            }
          ]
