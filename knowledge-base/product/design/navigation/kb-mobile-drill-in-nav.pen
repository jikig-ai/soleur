    {
      "type": "frame",
      "id": "XnyMe",
      "x": 3120,
      "y": 176,
      "name": "Constraints",
      "width": 420,
      "fill": "$canvas",
      "cornerRadius": 8,
      "stroke": {
        "thickness": 1,
        "fill": "$border"
      },
      "layout": "vertical",
      "gap": 16,
      "padding": 26,
      "children": [
        {
          "type": "text",
          "id": "Lnnbi",
          "fill": "$gold",
          "content": "CONSTRAINTS",
          "fontFamily": "Inter",
          "fontSize": 12,
          "fontWeight": "600",
          "letterSpacing": 3
        },
        {
          "type": "text",
          "id": "6LPvi",
          "fill": "$text2",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Touch targets\nEvery tree row is 48 px tall. Back arrow, hamburger, Ask trigger, sheet close and send are each 44 × 44. The drawer rows are 48 and 60.",
          "lineHeight": 1.6,
          "fontFamily": "Inter",
          "fontSize": 13.5,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "wSCiW",
          "fill": "$text2",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Same tree component as desktop\nRow anatomy is unchanged — chevron, icon, name, 10 px gap, 22 px indent per level. Only the container width changes: 300 px rail on desktop, 390 px content column on phone. This is not a redesigned mobile list.",
          "lineHeight": 1.6,
          "fontFamily": "Inter",
          "fontSize": 13.5,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "noIiE",
          "fill": "$text2",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Breakpoint\nDrill-in applies below 768 px only. At and above 768 px frame 08 is what ships today and keeps shipping.",
          "lineHeight": 1.6,
          "fontFamily": "Inter",
          "fontSize": 13.5,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "J04x3",
          "fill": "$text2",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Two header affordances, two jobs\nThe back arrow always means up one level: document to browse, browse to /dashboard. The hamburger always means global navigation. They never do the same thing.",
          "lineHeight": 1.6,
          "fontFamily": "Inter",
          "fontSize": 13.5,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "7a2g3",
          "fill": "$text2",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Gold is load-bearing\nGold marks exactly one thing per screen: the primary action or the current selection. Sync now, the Ask trigger, the connect CTA, the selected row. Nothing decorative.",
          "lineHeight": 1.6,
          "fontFamily": "Inter",
          "fontSize": 13.5,
          "fontWeight": "normal"
        }
      ]
    },
