                          "type": "text",
                          "id": "CNn29",
                          "fill": "$text2",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Collapse both rails into one. The drawer owns global navigation; the content column owns the knowledge base. At and above 768px this rail stays exactly where it is — persistent, expanded, and holding the tree.",
                          "lineHeight": 1.7,
                          "fontFamily": "Inter",
                          "fontSize": 15.5,
                          "fontWeight": "normal"
                        },
