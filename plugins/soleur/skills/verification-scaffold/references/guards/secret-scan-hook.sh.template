#!/usr/bin/env bash
# secret-scan.sh — PreToolUse hook emitted by soleur:verification-scaffold.
# Scans the staged index for secret-shaped strings (PEM bodies, vendor tokens,
# cloud keys) via gitleaks and reports before a `git commit` tool call lands.
#
# MODE=@MODE@ — stamped at emit time:
#   advisory (the installed default): real findings surface as `ask`; tool
#     errors (missing/unrunnable gitleaks, absent ruleset, empty report) warn
#     and allow — loudly, never silently.
#   enforce: findings deny; tool errors deny with the install remediation.
# Promote by changing MODE to "enforce" — a one-line flip. The predicates are
# identical in both modes; only the terminal decision changes.
#
# Hook stdin: JSON payload with tool_input. Hook stdout: the PreToolUse JSON
# decision envelope. Exit code is always 0 — the envelope carries the verdict.
#
# Portability floor: bash + POSIX tools only (stock macOS included — the
# timeout->gtimeout->bare-fallback below is deliberate). No network egress.
set -euo pipefail

MODE="@MODE@"

# --- decision envelopes -------------------------------------------------------
# _vs_decide <allow|ask|deny> [reason]: one JSON envelope on stdout, exit 0.
# Reasons are escaped (backslash, quote, newline) before embedding.
_vs_escape() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr '\n' ' '; }
_vs_decide() {
  local d="$1" r="${2:-}"
  if [ -n "$r" ]; then
    printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"%s","permissionDecisionReason":"%s"}}\n' \
      "$d" "$(_vs_escape "$r")"
  else
    printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"%s"}}\n' "$d"
  fi
  exit 0
}
_vs_allow() { _vs_decide allow; }
# _vs_tool_error <msg>: a scanner/tool problem, never a finding. Advisory warns
# and allows; enforce denies with remediation. `ask` can never fire on this path.
_vs_tool_error() {
  local msg="secret-scan: $1"
  printf '[secret-scan] WARN: %s\n' "$msg" >&2
  if [ "$MODE" = "enforce" ]; then
    _vs_decide deny "BLOCKED: $msg"
  else
    _vs_decide allow
  fi
}
# _vs_finding <msg>: a REAL finding — the only path that may `ask`.
_vs_finding() {
  if [ "$MODE" = "enforce" ]; then
    _vs_decide deny "BLOCKED: $1"
  else
    _vs_decide ask "$1"
  fi
}

# --- stdin command extraction (jq -> node -> sed fallback) --------------------
_vs_payload="$(cat)"
_vs_cmd=""
if command -v jq >/dev/null 2>&1; then
  _vs_cmd="$(printf '%s' "$_vs_payload" | jq -r '.tool_input.command // ""' 2>/dev/null || true)"
elif command -v node >/dev/null 2>&1; then
  _vs_cmd="$(printf '%s' "$_vs_payload" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{const c=JSON.parse(s).tool_input.command;process.stdout.write(typeof c==="string"?c:"")}catch(e){}})' 2>/dev/null || true)"
else
  # Last-resort extraction: handles the common single-quoted-string shape.
  # Documented limit: escaped quotes inside the command truncate the value,
  # which only ever DE-escalates this hook (the CI job still scans the push).
  _vs_cmd="$(printf '%s' "$_vs_payload" | sed -n 's/.*"command"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)"
fi
[ -n "$_vs_cmd" ] || _vs_allow

# `git commit` at a command boundary: start, or after &&, ||, ;, |, $(.
# Trailing space-or-end rejects commit-tree/commit-graph.
if ! grep -qE '(^|[[:space:]]|&&|\|\||;|\$\()[[:space:]]*git[[:space:]]+commit([[:space:]]|$)' <<<"$_vs_cmd"; then
  _vs_allow
fi

# --- environment guards -------------------------------------------------------
GL_REMEDIATION="install gitleaks 8.24.x (e.g. 'mise use gitleaks@8.24.2' or 'brew install gitleaks') — the CI job scans every PR regardless."

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  _vs_allow
fi
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$repo_root" ] || [ ! -f "$repo_root/.gitleaks.toml" ]; then
  _vs_tool_error ".gitleaks.toml not found at the repo root — the staged scan was skipped. $GL_REMEDIATION"
fi
if ! command -v gitleaks >/dev/null 2>&1; then
  _vs_tool_error "gitleaks is not on PATH — the staged scan was skipped. $GL_REMEDIATION"
fi

# Resolvable is not runnable: probe the binary, bounded when a bound exists
# (stock macOS has neither timeout nor gtimeout — a missing bound must never
# read as a broken scanner).
gl_to=()
if command -v timeout >/dev/null 2>&1; then gl_to=(timeout 10)
elif command -v gtimeout >/dev/null 2>&1; then gl_to=(gtimeout 10); fi
gl_rc=0
{ ${gl_to[@]+"${gl_to[@]}"} gitleaks version >/dev/null; } 2>/dev/null || gl_rc=$?
if [ "$gl_rc" -ne 0 ]; then
  _vs_tool_error "gitleaks resolves on PATH but cannot run (rc=$gl_rc — an unpinned version-manager shim?). $GL_REMEDIATION"
fi

# --- staged scan ---------------------------------------------------------------
# Colour is pinned off on BOTH config surfaces: gitleaks runs git itself, and a
# user-side color.ui/color.diff=always wraps patch lines in ANSI, which makes
# the scan report ZERO findings on a staged key (measured). GIT_CONFIG_COUNT
# appends so a caller's own -c settings survive; GIT_CONFIG_PARAMETERS is a
# separate source read AFTER the count list, so it is pinned too.
report_file="$(mktemp -t verification-scan-XXXXXX.json)"
nodiff_dir="$(mktemp -d -t verification-nodiff-XXXXXX)"
nodiff_report="$(mktemp -t verification-nodiff-XXXXXX.json)"
trap 'rm -f "$report_file" "$nodiff_report"; rm -rf "$nodiff_dir"' EXIT INT TERM

gl_cfg_n="${GIT_CONFIG_COUNT:-0}"
case "$gl_cfg_n" in ''|*[!0-9]*) gl_cfg_n=0 ;; esac
scan_rc=0
(
  cd "$repo_root" || exit 1
  env "GIT_CONFIG_COUNT=$((gl_cfg_n + 2))" \
    "GIT_CONFIG_KEY_${gl_cfg_n}=color.ui" "GIT_CONFIG_VALUE_${gl_cfg_n}=never" \
    "GIT_CONFIG_KEY_$((gl_cfg_n + 1))=color.diff" "GIT_CONFIG_VALUE_$((gl_cfg_n + 1))=never" \
    "GIT_CONFIG_PARAMETERS=${GIT_CONFIG_PARAMETERS:+${GIT_CONFIG_PARAMETERS} }'color.ui'='never' 'color.diff'='never'" \
    gitleaks git --pre-commit --staged --redact --no-banner --exit-code 1 \
      --report-format json --report-path "$report_file" >/dev/null 2>&1
) || scan_rc=$?

# -diff gitattribute bypass: a path marked -diff renders "Binary files …
# differ" with no `+` lines, so the staged scan sees nothing in it. Re-scan
# those paths from their STAGED blobs with `detect --no-git`, which never
# consults git's diff machinery.
gl_nodiff=()
while IFS= read -r -d '' _p; do
  [ -n "$_p" ] || continue
  if [ "$(git -C "$repo_root" check-attr diff -- "$_p" 2>/dev/null | sed 's/.*: //')" = "unset" ]; then
    gl_nodiff+=("$_p")
  fi
done < <(git -C "$repo_root" diff --cached --name-only -z --diff-filter=ACMR 2>/dev/null)

if (( ${#gl_nodiff[@]} > 0 )); then
  for _p in "${gl_nodiff[@]}"; do
    mkdir -p "$nodiff_dir/$(dirname "$_p")" 2>/dev/null || true
    git -C "$repo_root" show ":$_p" > "$nodiff_dir/$_p" 2>/dev/null || true
  done
  nodiff_rc=0
  gitleaks detect --no-git --source "$nodiff_dir" --redact --no-banner --exit-code 1 \
    --report-format json --report-path "$nodiff_report" >/dev/null 2>&1 || nodiff_rc=$?
  if [ "$nodiff_rc" -eq 1 ] && [ -s "$nodiff_report" ]; then
    nd_count="$(grep -c '"RuleID"' "$nodiff_report" 2>/dev/null || echo 0)"
    nd_files="$(printf '%s, ' "${gl_nodiff[@]}")"
    _vs_finding "gitleaks found ${nd_count} secret-shaped string(s) in staged file(s) carrying a \`-diff\` gitattribute (${nd_files%, }), which hides them from the staged scan — they were re-scanned from their staged blobs. Scrub the secret bytes; if the attribute is not deliberate, remove it."
  elif [ "$nodiff_rc" -ne 0 ] && [ "$nodiff_rc" -ne 1 ]; then
    _vs_tool_error "the -diff re-scan exited $nodiff_rc without a findings report; those paths were NOT verified."
  fi
fi

if [ "$scan_rc" -eq 0 ]; then
  _vs_allow
fi

# Non-zero scan rc with an empty/absent report is a scanner failure, not a
# finding — it takes the tool-error path in both modes.
if [ ! -s "$report_file" ] || ! grep -q '"RuleID"' "$report_file" 2>/dev/null; then
  _vs_tool_error "gitleaks exited $scan_rc but produced no findings report; the staged content was NOT scanned. Run 'gitleaks git --pre-commit --staged' locally to diagnose. $GL_REMEDIATION"
fi

count="$(grep -c '"RuleID"' "$report_file" 2>/dev/null || echo 0)"
if command -v jq >/dev/null 2>&1; then
  summary="$(jq -r '[.[] | "\(.File):\(.StartLine) (\(.RuleID))"] | .[0:5] | join("; ")' "$report_file" 2>/dev/null || echo "")"
else
  summary="$(grep -o '"File": *"[^"]*"' "$report_file" 2>/dev/null | head -n 5 | sed 's/"File": *"//; s/"$//' | tr '\n' '; ' || true)"
fi
reason="gitleaks found ${count} secret-shaped string(s) in the staged index. Locations: ${summary:-<redacted>}. Scrub the secrets — never commit-then-rotate. Unstage with 'git restore --staged <path>', redact in place, re-stage and retry. To mark a known-safe line, annotate it '# gitleaks:allow issue:#NNN <reason>'." # waiver-doc string (issue:#10404 teaches trailer form)

_vs_finding "$reason"
