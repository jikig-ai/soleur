#!/usr/bin/env bash
# pre-push hook: run the affected test gate for the current branch's changes.
# Blocks the push if any suite fails.
#
# Install: git config core.hooksPath scripts/hooks
#
# How it works:
#   1. Diffs the current branch against origin/HEAD to find changed files
#   2. Delegates to `test-all.sh --affected` (#8322), which runs the suites
#      the diff can move — classified through the maintained edge index —
#      plus every always-on repo-global ratchet. Minutes-scale, not the
#      ~45-minute serial battery.
#   3. Blocks the push if the gate exits non-zero
#
# Why the delegation: this hook previously mapped changed files to test files
# by basename stem and ran them directly — a hand-rolled file→suite index that
# drifted silently whenever a suite's naming deviated from the convention.
# `--affected` is the same idea with a maintained index, fail-safe
# classification (unclassified suites run rather than vanish), and an
# operator-visible `--full` escape when the whole battery is wanted.
#
# Skips gracefully when:
#   - bun is not installed
#   - The branch carries no changes vs its base
#   - Pushing to a non-main remote (e.g., forks)

set -euo pipefail

# Git hook isolation: git sets GIT_DIR, GIT_INDEX_FILE, GIT_WORK_TREE
# in hook environments. These cause test-spawned git commands (e.g., in
# workspace.test.ts) to operate on the parent repo instead of temp dirs,
# potentially contaminating the feature branch with rogue commits.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE GIT_TEMPLATE_DIR GIT_EXEC_PATH

# Skip if bun is not available
if ! command -v bun &>/dev/null; then
  exit 0
fi

# Determine base branch
base_branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@') || base_branch="main"

# Skip when the branch carries no changes vs its base — nothing to gate.
if [[ -z "$(git diff --name-only "origin/$base_branch"...HEAD 2>/dev/null)" ]]; then
  exit 0
fi

echo "pre-push: running the affected test gate (test-all.sh --affected)."
echo "        For the full battery: bash scripts/test-all.sh --full"
echo ""

exec bash scripts/test-all.sh --affected
