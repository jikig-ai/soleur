{
  "_comment": "#12910 CTO ruling T3a: one table drives BOTH the app's key verification (host-identity.test.ts, describeHostIdentity) and ci-deploy.sh host_key_running_verified (ci-deploy.test.sh HKV rows), so the shell copy cannot drift from the TypeScript rules. `verified` is the key the container verified, or empty.",
  "cases": [
    {"name": "verified web-2", "env": {"SOLEUR_HOST_KEY": "web-2", "SOLEUR_HOST_PRIVATE_IP": "10.0.1.11", "SOLEUR_HOST_ROSTER": "{\"web-3\":\"10.0.1.12\",\"web-2\":\"10.0.1.11\"}"}, "verified": "web-2"},
    {"name": "key and IP are trimmed", "env": {"SOLEUR_HOST_KEY": "  web-3 ", "SOLEUR_HOST_PRIVATE_IP": " 10.0.1.12 ", "SOLEUR_HOST_ROSTER": " {\"web-3\":\"10.0.1.12\"} "}, "verified": "web-3"},
    {"name": "T1 collision: web-3 claimed on web-2's IP", "env": {"SOLEUR_HOST_KEY": "web-3", "SOLEUR_HOST_PRIVATE_IP": "10.0.1.11", "SOLEUR_HOST_ROSTER": "{\"web-3\":\"10.0.1.12\",\"web-2\":\"10.0.1.11\"}"}, "verified": ""},
    {"name": "key absent", "env": {"SOLEUR_HOST_PRIVATE_IP": "10.0.1.11", "SOLEUR_HOST_ROSTER": "{\"web-2\":\"10.0.1.11\"}"}, "verified": ""},
    {"name": "empty key", "env": {"SOLEUR_HOST_KEY": "", "SOLEUR_HOST_PRIVATE_IP": "10.0.1.11", "SOLEUR_HOST_ROSTER": "{\"web-2\":\"10.0.1.11\"}"}, "verified": ""},
    {"name": "malformed key", "env": {"SOLEUR_HOST_KEY": "Web_2", "SOLEUR_HOST_PRIVATE_IP": "10.0.1.11", "SOLEUR_HOST_ROSTER": "{\"Web_2\":\"10.0.1.11\"}"}, "verified": ""},
    {"name": "empty private IP (late NIC)", "env": {"SOLEUR_HOST_KEY": "web-2", "SOLEUR_HOST_PRIVATE_IP": "", "SOLEUR_HOST_ROSTER": "{\"web-2\":\"10.0.1.11\"}"}, "verified": ""},
    {"name": "0.0.0.0 is not a private IP", "env": {"SOLEUR_HOST_KEY": "web-2", "SOLEUR_HOST_PRIVATE_IP": "0.0.0.0", "SOLEUR_HOST_ROSTER": "{\"web-2\":\"0.0.0.0\"}"}, "verified": ""},
    {"name": "roster absent", "env": {"SOLEUR_HOST_KEY": "web-2", "SOLEUR_HOST_PRIVATE_IP": "10.0.1.11"}, "verified": ""},
    {"name": "roster not JSON", "env": {"SOLEUR_HOST_KEY": "web-2", "SOLEUR_HOST_PRIVATE_IP": "10.0.1.11", "SOLEUR_HOST_ROSTER": "web-2=10.0.1.11"}, "verified": ""},
    {"name": "roster is an array", "env": {"SOLEUR_HOST_KEY": "web-2", "SOLEUR_HOST_PRIVATE_IP": "10.0.1.11", "SOLEUR_HOST_ROSTER": "[\"10.0.1.11\"]"}, "verified": ""},
    {"name": "roster value not a string", "env": {"SOLEUR_HOST_KEY": "web-2", "SOLEUR_HOST_PRIVATE_IP": "10.0.1.11", "SOLEUR_HOST_ROSTER": "{\"web-2\":101}"}, "verified": ""},
    {"name": "an instance-id key is not in the roster", "env": {"SOLEUR_HOST_KEY": "hetzner-176328334", "SOLEUR_HOST_PRIVATE_IP": "10.0.1.11", "SOLEUR_HOST_ROSTER": "{\"web-2\":\"10.0.1.11\"}"}, "verified": ""},
    {"name": "prototype-shaped key never verifies", "env": {"SOLEUR_HOST_KEY": "constructor", "SOLEUR_HOST_PRIVATE_IP": "10.0.1.11", "SOLEUR_HOST_ROSTER": "{\"web-2\":\"10.0.1.11\"}"}, "verified": ""},
    {"name": "a 31-char key (the regex's upper bound) verifies", "env": {"SOLEUR_HOST_KEY": "abbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "SOLEUR_HOST_PRIVATE_IP": "10.0.1.11", "SOLEUR_HOST_ROSTER": "{\"abbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\":\"10.0.1.11\"}"}, "verified": "abbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"},
    {"name": "a 32-char key is malformed even when the roster maps it", "env": {"SOLEUR_HOST_KEY": "abbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "SOLEUR_HOST_PRIVATE_IP": "10.0.1.11", "SOLEUR_HOST_ROSTER": "{\"abbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\":\"10.0.1.11\"}"}, "verified": ""},
    {"name": "a key starting with a digit is malformed", "env": {"SOLEUR_HOST_KEY": "2web", "SOLEUR_HOST_PRIVATE_IP": "10.0.1.11", "SOLEUR_HOST_ROSTER": "{\"2web\":\"10.0.1.11\"}"}, "verified": ""},
    {"name": "a trailing U+0085 is not trimmed (JS trim keeps it), so the key is malformed", "env": {"SOLEUR_HOST_KEY": "web-2\u0085", "SOLEUR_HOST_PRIVATE_IP": "10.0.1.11", "SOLEUR_HOST_ROSTER": "{\"web-2\":\"10.0.1.11\"}"}, "verified": ""},
    {"name": "a leading U+FEFF is trimmed (JS trim strips it)", "env": {"SOLEUR_HOST_KEY": "\ufeffweb-2", "SOLEUR_HOST_PRIVATE_IP": "10.0.1.11", "SOLEUR_HOST_ROSTER": "{\"web-2\":\"10.0.1.11\"}"}, "verified": "web-2"},
    {"name": "a roster with a NaN value is rejected whole (JSON.parse)", "env": {"SOLEUR_HOST_KEY": "web-2", "SOLEUR_HOST_PRIVATE_IP": "10.0.1.11", "SOLEUR_HOST_ROSTER": "{\"web-2\":\"10.0.1.11\",\"x\":NaN}"}, "verified": ""},
    {"name": "a roster with a leading-zero number is rejected whole (JSON.parse)", "env": {"SOLEUR_HOST_KEY": "web-2", "SOLEUR_HOST_PRIVATE_IP": "10.0.1.11", "SOLEUR_HOST_ROSTER": "{\"web-2\":\"10.0.1.11\",\"x\":01}"}, "verified": ""},
    {"name": "non-string values elsewhere in the roster are dropped, not fatal", "env": {"SOLEUR_HOST_KEY": "web-2", "SOLEUR_HOST_PRIVATE_IP": "10.0.1.11", "SOLEUR_HOST_ROSTER": "{\"web-2\":\"10.0.1.11\",\"x\":-0.5e3,\"y\":[true,null]}"}, "verified": "web-2"},
    {"name": "a roster with a trailing comma is rejected whole (JSON.parse and fromjson both refuse it)", "env": {"SOLEUR_HOST_KEY": "web-2", "SOLEUR_HOST_PRIVATE_IP": "10.0.1.11", "SOLEUR_HOST_ROSTER": "{\"web-2\":\"10.0.1.11\",}"}, "verified": ""}
  ]
