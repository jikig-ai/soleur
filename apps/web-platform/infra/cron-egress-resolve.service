[Unit]
Description=Soleur egress allowlist re-resolve
After=network-online.target
Wants=network-online.target
OnFailure=cron-egress-alarm@%n.service

[Service]
Type=oneshot
# Bounded so a wedged dockerd cannot hold the unit in `activating` forever
# (OnUnitActiveSec timers do not re-fire while activating, and OnFailure=
# never fires for a hang) — a timeout converts the hang into a paged failure.
TimeoutStartSec=120
# Persistent store for the grace-window IP-retention pool (LB-rotation fix).
# systemd creates/owns /var/lib/cron-egress-resolve (root, 0755) BEFORE ExecStart
# and it survives reboots — /run (tmpfs) would wipe the accumulated rotation pool
# and re-open the egress-drop outage for up to one grace window after every boot.
StateDirectory=cron-egress-resolve
# Doppler env wiring — see cron-egress-firewall.service for the rationale.
EnvironmentFile=-/etc/default/inngest-server
# #7095 — the re-deliverable Doppler credential. MUST stay AFTER the inngest-server line:
# systemd applies EnvironmentFile= in order and later-wins, so this overrides the DOPPLER_TOKEN
# inherited from /etc/default/inngest-server. That file holds a COPY of the web-host token,
# extracted out of /etc/default/webhook-deploy by inngest-bootstrap.sh:586 and then PINNED
# forever by :567-568 (which preserves it whenever the value still matches ^DOPPLER_TOKEN=dp.),
# so a dead-but-well-formed token never self-heals there. That copy is why one revocation at
# 11:19:30.614Z killed this unit too: measured onset +18.17s to +26.14s, with zero failures in
# the preceding 53h. Do NOT rewrite /etc/default/inngest-server instead — inngest-bootstrap.sh:616-617
# fail-closes the host if DOPPLER_PROJECT goes missing from it, and a host replace is not available.
# The '-' prefix keeps this a no-op on a host that has not received the file yet.
EnvironmentFile=-/etc/default/soleur-doppler-token
Environment=HOME=/root
ExecStart=/bin/sh -c 'D="$(command -v doppler || true)"; if [ -n "$D" ] && [ -n "$DOPPLER_TOKEN" ]; then exec "$D" run --project soleur --config prd -- /usr/local/bin/cron-egress-resolve.sh; else exec /usr/local/bin/cron-egress-resolve.sh; fi'
