[Unit]
Description=inngest consumer-perspective serviceability probe (web host, #7228 Phase 1)
After=network-online.target
Wants=network-online.target
# SKIP-VS-FAIL (#10078, the #9962/#9939 pattern): /etc/default/inngest-consumer-probe is
# written by web-probe-envwrite.sh, a `|| true`-tolerated late-runcmd write, and the 60s
# timer is armed unconditionally — an absent file must SKIP this start (one "skipped,
# unmet condition check" notice per fire), never FAIL it into an every-60s journal
# storm. The EnvironmentFile= line stays unprefixed: once a start IS attempted, an
# absent file still fails the unit — the fail-closed contract is retained. The
# condition re-evaluates on every timer fire, so the probe self-heals when the file
# appears. The detectors that do NOT share this gated dependency: the
# `soleur-boot-emit web_probe_envwrite fatal` boot row on a writer failure, and the
# missing betteruptime_heartbeat.inngest_consumer beat — a skipped probe pings
# nothing.
ConditionPathExists=/etc/default/inngest-consumer-probe

[Service]
Type=oneshot
# HOME=/root: the ExecStart runs `doppler run` as ROOT (no User=). The Doppler CLI's
# os.UserHomeDir() init dies "Doppler Error: $HOME is not defined" for a root systemd service
# (which gets no $HOME) BEFORE it can exec the probe — the reason every working root-doppler unit
# on the fleet (container-restart-monitor, cron-egress-*, inngest-cutover-flip, and both sibling
# web probes) sets this. With HOME=/root doppler uses /root/.doppler; the prd DOPPLER_TOKEN
# arrives via the EnvironmentFile below (written by the *_install provisioner from
# doppler_service_token.web_probes). No DOPPLER_CONFIG_DIR → never /tmp/.doppler (#6536).
Environment=HOME=/root
# SyslogIdentifier retags the unit's journal output away from the ExecStart basename `bash`
# (systemd default) to a diagnostic-critical identifier shipped by vector.toml Source 4
# (host_scripts_journald) — so the probe's fault classification ("UNREACHABLE — no TCP listener",
# "EMPTY REGISTRY", "WEDGED") reaches Better Stack off-box rather than SSH-only
# (hr-no-ssh-fallback-in-runbooks; the #6556 inngest-heartbeat lesson). Mirrored in vector.toml —
# Source 4 is sd_journal_add_match EXACT-VALUE equality, so this literal and that entry are ONE
# change in two files; either alone is a permanently-dead no-op that reads like coverage.
#
# This is the half that makes the probe diagnostic rather than merely binary. The heartbeat's
# absence says "something is wrong with the dedicated inngest host"; only this channel says which
# of unreachable / empty-registry / wedged it is — and #7228 is precisely a twelve-day outage in
# which the binary signal was green and no channel carried the WHY.
SyslogIdentifier=inngest-consumer-probe
# /etc/default/inngest-consumer-probe (baked by the *_install provisioner in server.tf) carries
# INNGEST_REMOTE_GQL_URL and INNGEST_CONSUMER_URL_KEY (the Doppler var name holding this probe's
# heartbeat URL). There is ONE dedicated inngest host, so unlike the per-host zot/NIC beats this
# is a single shared beat and the mapping is an identity — the git-data probe precedent (C3:
# "single-host makes masking moot"). The indirection is kept anyway so all three web probes read
# identically. `doppler run` injects INNGEST_CONSUMER_URL, and the probe resolves it through the
# key NAME itself, AFTER its xtrace refusal. The ExecStart below expands and exports NOTHING
# (#9639, #10637): the URL is a credential, and a wrapper that expanded it would print it under a
# traced launch before the probe could refuse. doppler-injection-bound.test.sh rejects an indirect
# expansion in the Exec directives of a doppler-run unit.
EnvironmentFile=/etc/default/inngest-consumer-probe
ExecStart=/bin/bash -c 'doppler run --project soleur --config prd -- /usr/local/bin/inngest-consumer-probe.sh'
