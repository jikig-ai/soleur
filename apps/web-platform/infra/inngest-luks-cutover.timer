[Unit]
Description=Poll the Inngest LUKS cutover flag every 30s (#6894)
# Evaluated at ACTIVATION — enable --now in inngest-bootstrap.sh, or timers.target on later
# boots — not per-elapse (#9939). When a LUKS stage abort leaves the env files unwritten, the
# timer never arms at all: one skip notice per boot instead of a Failed-to-start every ~30s,
# and it re-evaluates on the next boot's activation, so it self-heals once the files exist.
# The file set mirrors the service's EnvironmentFile= set so a partially staged file set still
# skips; the service carries the same conditions for its non-timer triggers.
ConditionPathExists=/etc/default/inngest-server
ConditionPathExists=/etc/default/inngest-luks-volumes

[Timer]
# The dedicated host has no inbound control channel; a 30s Doppler-flag poll is the only no-SSH
# trigger. The flag is the sole gate — the terminal and unset states are no-ops.
OnBootSec=30s
OnUnitActiveSec=30s
# Persistent=true is deliberately NOT copied from inngest-cutover-flip.timer: there a missed run is
# an idempotent flag read, here it would fire at boot, so a host rebooted mid-window would re-enter
# the cutover before anyone had read why it stopped.

[Install]
WantedBy=timers.target
