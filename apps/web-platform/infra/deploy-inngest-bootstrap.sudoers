# /etc/sudoers.d/deploy-inngest-bootstrap — permits the `deploy` user to run
# inngest-bootstrap.sh as root from a fixed extract path (/tmp/inngest-extract/).
#
# Why no wildcards: Ubuntu 24.04's sudo-rs rejects wildcards in command
# arguments (it parses them as literal `*`). ci-deploy.sh was updated in #4144
# to use a fixed path (rm -rf + mkdir + extract) so the sudoers form below
# pins the exact command. Concurrent deploys collide on the path but webhook
# serializes them.
#
# env_keep is the modern alternative to `sudo -E env K=V ...`: the two
# version pins are preserved across the sudo boundary by name.
#
# (#6555) DOPPLER_PROJECT was previously kept here as a deliberate forward-guard: a caller that
# DID set it could not have it silently stripped across the sudo boundary, for the day the inngest
# units would resolve their Doppler project from that variable. #6555 landed exactly that — but
# the other way: the units now read DOPPLER_PROJECT from EnvironmentFile=/etc/default/inngest-server
# (written at cloud-init:324 / the bootstrap heredoc + in-place augment), NOT from the
# sudo-inherited env. Preserving it here is therefore no longer load-bearing, so it is removed.
# (It was never a secret regardless — a project NAME; the token it selects is fetched separately.)
#
# Provisioned via cloud-init (fresh hosts) and terraform_data.deploy_pipeline_fix
# (already-running hosts). See #4144 / #4118.
Cmnd_Alias INNGEST_BOOTSTRAP = /usr/bin/bash /tmp/inngest-extract/inngest-bootstrap.sh
Defaults!INNGEST_BOOTSTRAP env_keep += "INNGEST_CLI_VERSION INNGEST_CLI_SHA256 VECTOR_CLI_VERSION VECTOR_CLI_SHA256"
deploy ALL=(root) NOPASSWD: INNGEST_BOOTSTRAP

# #3756 — permits infra-config-apply.sh to schedule a delayed webhook restart
# via systemd-run. The handler runs as the deploy user inside webhook.service's
# mount namespace; systemctl restart requires root.
#
# #7220 AC-B2.2 — `--collect` was added, and the argv here moved with it because sudo matches
# the FULL resolved command (a drift denies rather than widens). --unit=webhook-self-restart is
# a FIXED name, and systemd does NOT garbage-collect a transient unit that FAILED, so without
# --collect the first failed self-restart leaves the unit lingering and every subsequent apply's
# systemd-run dies with "unit already exists" — permanently, silently, on the only remediation
# channel this host has. That path had never once executed in production before #7220 (it shipped
# after the ungranted reload in the same set -e block, so it was unreachable from ~2026-05), so
# this is a first-run hardening, not a regression fix.
Cmnd_Alias WEBHOOK_SELF_RESTART = /usr/bin/systemd-run --collect --on-active=3s --unit=webhook-self-restart /usr/bin/systemctl restart webhook
deploy ALL=(root) NOPASSWD: WEBHOOK_SELF_RESTART

# #4538 — permits ci-deploy.sh to restart inngest-server.service via the
# `restart inngest _ latest` command. Pins the exact systemctl invocation;
# no wildcards, no argument injection.
Cmnd_Alias INNGEST_RESTART = /usr/bin/systemctl restart inngest-server.service
deploy ALL=(root) NOPASSWD: INNGEST_RESTART

# #5450 — permits inngest-wiped-volume-verify.sh (the OPT-IN destructive cutover
# durability proof, invoked via the /hooks/inngest-wiped-volume-verify handler as
# the deploy user) to stop THEN start inngest-server.service around the volume
# wipe. It cannot be a `restart` — the wipe of /var/lib/inngest happens while the
# unit is DOWN. Two pinned, wildcard-free aliases (sudo-rs safe); the wipe itself
# needs no root (the dir is deploy:deploy 0750). Delivered root-only with the rest
# of this file (cloud-init write_files + the handler-bootstrap bridge), never via
# the webhook handler.
Cmnd_Alias INNGEST_STOP = /usr/bin/systemctl stop inngest-server.service
deploy ALL=(root) NOPASSWD: INNGEST_STOP
Cmnd_Alias INNGEST_START = /usr/bin/systemctl start inngest-server.service
deploy ALL=(root) NOPASSWD: INNGEST_START

# #6178 (no-SSH inngest quiesce/enable web) — closes the dedicated-host cutover 2.2
# gap: operators have NO SSH, so the co-located web scheduler cannot be quiesced by
# hand (hr-no-ssh-fallback-in-runbooks). ci-deploy.sh's `quiesce inngest _ _` handler
# (op=quiesce-web) stop+disables inngest-server.service, mirroring the no-SSH
# INNGEST_RESTART (#4538) precedent over the deploy webhook. Two pinned, wildcard-free
# argv (sudo-rs safe). The stop verb INTENTIONALLY mirrors the pre-existing INNGEST_STOP
# (#5450) alias — sudo matches a command against ANY granting alias, so the overlap is
# harmless; the genuinely-new verb is `disable` (removes the [Install] WantedBy symlink
# so a mid-window reboot cannot auto-restart the quiesced old scheduler → the exact
# double-fire the quiesce prevents).
Cmnd_Alias INNGEST_QUIESCE = /usr/bin/systemctl stop inngest-server.service, /usr/bin/systemctl disable inngest-server.service
deploy ALL=(root) NOPASSWD: INNGEST_QUIESCE

# #6178 — permits ci-deploy.sh's `enable inngest _ _` handler (the no-SSH REVERSE of
# quiesce, driven ONLY by op=rollback) to re-enable inngest-server.service — restoring
# the [Install] symlink a quiesce-disable removed so the scheduler survives a reboot
# (a `restart` never touches [Install]). The enable handler's `start` half reuses the
# pre-existing INNGEST_START (#5450) grant above — NO new start grant is added here.
# Pinned, wildcard-free (sudo-rs safe).
Cmnd_Alias INNGEST_ENABLE = /usr/bin/systemctl enable inngest-server.service
deploy ALL=(root) NOPASSWD: INNGEST_ENABLE

# #4827 — permits infra-config-apply.sh (the /hooks/infra-config handler, running
# as the deploy user) to escalate the atomic install of its managed files into
# their root:root 0755 destination dirs, which the deploy user cannot mktemp into
# (EACCES). The command is pinned to a fixed helper path with NO argument
# wildcards (sudo-rs safe); the helper itself hardcodes the dest allowlist and
# TOCTOU-guards the staged source, so the bare-command grant is the safe form.
Cmnd_Alias INFRA_CONFIG_INSTALL = /usr/local/bin/infra-config-install
deploy ALL=(root) NOPASSWD: INFRA_CONFIG_INSTALL

# #5934 / ADR-081 — permits ci-deploy.sh's pre-canary durable substrate sweep
# (`sudo timeout 60 /usr/local/bin/git-lock-chardevice-sweep.sh`) to run as root.
# The sweep clears any residual CHARACTER-DEVICE .git/config.lock the container
# substrate leaves on /mnt/data/workspaces, which otherwise wedges worktree
# creation for every agent session (#5912). WITHOUT this grant sudo denies the
# sweep ("command not allowed") and the durable remediation is a SILENT no-op —
# ci-deploy.sh's `|| true` swallows the denial, so the wedge persists into live
# sessions and #5934's soak probe never sees a DONE marker. The alias pins the
# EXACT argv ci-deploy.sh invokes, including the resolved `/usr/bin/timeout 60`
# prefix (sudo matches the full resolved command) — no wildcards, sudo-rs safe.
# The `timeout 60` value is COUPLED to ci-deploy.sh's invocation; the two must
# change in lockstep (git-lock-chardevice-sweep.test.sh asserts consistency).
Cmnd_Alias GIT_LOCK_CHARDEVICE_SWEEP = /usr/bin/timeout 60 /usr/local/bin/git-lock-chardevice-sweep.sh
deploy ALL=(root) NOPASSWD: GIT_LOCK_CHARDEVICE_SWEEP

# #7103 R2 — permits infra-config-apply.sh (the /hooks/infra-config handler, running as the
# deploy user) to restart the two units whose systemd drop-ins it delivers. Delivery is not
# activation: a drop-in re-pointing vector.service and inngest-heartbeat.service at the
# re-deliverable credential lands on disk, and the running process keeps its old configuration
# until something restarts it. Nothing did — so the credential channel reported success while
# the units it exists to repair carried on with the stale environment.
#
# `try-restart` and not `restart`: an inactive unit must stay inactive. Starting a unit the
# operator (or a failure) stopped is a decision this handler has no standing to make.
#
# PRECONDITION, NOT A DETAIL: /usr/local/bin/infra-config-install validates drop-in content
# against a permitted-directive whitelist before any of this can activate it. Granting a root
# restart of a unit whose configuration can be written without validation converts a delivery
# capability into an execution capability — vector.service runs User=deploy, and systemd merges
# drop-ins after the unit body. The gate ships first for that reason; do not reorder them.
#
# Sudoers argument matching is EXACT, so `try-restart vector.service --no-block` is denied rather
# than silently widened: the failure mode of a drift here is denial, which
# infra-config-apply.test.sh's sudoers-to-caller argv lockstep pins in both directions.
#
# ONE unit, deliberately. inngest-heartbeat.service was granted here when this shipped and has
# been removed: it is a Type=oneshot with no RemainAfterExit on a 60s timer, so it re-reads its
# drop-in on its next tick after daemon-reload and never needed a restart grant at all. Keeping
# it would have been a standing root-restart capability on the unreplaceable host in exchange for
# nothing. Full rationale at RESTART_MAP in infra-config-apply.sh; the argv lockstep asserts this
# alias and that map agree, so the two cannot drift apart silently.
Cmnd_Alias DROPIN_TRY_RESTART = /usr/bin/systemctl try-restart vector.service
deploy ALL=(root) NOPASSWD: DROPIN_TRY_RESTART

# #7220 — daemon-reload. THE REPAIR: this verb has been called by infra-config-apply.sh since
# ~2026-05 with no grant at all. It returned "Interactive authentication required" and set -e
# aborted the handler AFTER all 19 managed files were written but BEFORE any unit was
# reconciled, so delivery looked healthy while ACTIVATION never happened. Every managed unit
# has been running the environment it was started with.
#
# SCOPE, stated plainly because it is wider than every other alias here and cannot be narrowed:
# `daemon-reload` takes no unit argument, so exact-argv pinning buys NOTHING on the scope axis.
# It reloads every unit file on the host. The control that bounds what it can adopt is therefore
# NOT this line — it is the content gate in infra-config-install.sh, which pins
# /etc/systemd/system/*.service dests to an exact digest (#7220 AC-B1) and refuses any drop-in
# carrying User=, ExecStart=, AmbientCapabilities= or NoNewPrivileges=. That gate ships before
# or with this grant, never after.
#
# It reloads unit FILES; it does not start, stop or restart anything, so on its own it cannot
# move a unit into a new state — a separate grant is still required for that, and the only one
# is DROPIN_TRY_RESTART above.
#
# ============================================================================================
# WHAT THE `deploy` USER ALREADY IS — the canonical statement, referenced from
# infra-config-install.sh and cloud-init.yml rather than restated there (#7220 review).
#
# `deploy` is ALREADY ROOT-EQUIVALENT on this host, by design and by documented decision. Read
# every content gate in this subsystem as an INTEGRITY control on its own delivery path, never as
# a privilege boundary — there is no privilege boundary here to breach.
#
# Three independent paths, all verified by reading the shipped artifacts rather than assumed:
#
#   1. cloud-init.yml puts `deploy` in the `docker` group, which is root-equivalent by
#      construction (`docker run -v /:/host`). This is an ACCEPTED tradeoff, argued and recorded
#      in knowledge-base/project/plans/2026-03-20-security-deploy-ssh-user-privilege-boundary-plan.md
#      ("Docker group membership is effectively root-equivalent ... accepted tradeoff for this
#      PR"), whose whole point was reducing blast radius from unrestricted root to
#      root-equivalent-via-docker.
#   2. The 14 `/usr/local/bin/*` dests in infra-config-install.sh's DEST_SPEC get a path, mode
#      and owner check and NO content gate. `git-lock-chardevice-sweep.sh` is one of them AND is
#      run as root via GIT_LOCK_CHARDEVICE_SWEEP above, so deploy can put arbitrary content into
#      a 0755 root:root file that root then executes.
#   3. INNGEST_BOOTSTRAP runs `/usr/bin/bash /tmp/inngest-extract/inngest-bootstrap.sh` as root,
#      and ci-deploy.sh creates and populates that directory AS deploy.
#
# So what the *.service digest pin actually buys is worth stating precisely, because it is real
# and it is narrower than "security": it makes THIS delivery channel's effect on what systemd
# ADOPTS deterministic and reviewable — a unit either matches its committed bytes or is refused.
# That is what keeps a config-delivery bug from silently becoming a unit-definition change, and
# it is the property #7220 needs. It buys nothing against a `deploy` that chooses to use path 1,
# 2 or 3, and no comment in this subsystem should imply otherwise.
#
# The consequence for a reviewer: do NOT treat these gates as the thing standing between deploy
# and root, and do NOT relax one on the reasoning that deploy is untrusted anyway — the gates
# earn their place as integrity controls on a channel that must be debuggable on a host with no
# SSH runbook, which is a different and independently sufficient justification.
# ============================================================================================
Cmnd_Alias SYSTEMCTL_DAEMON_RELOAD = /usr/bin/systemctl daemon-reload
deploy ALL=(root) NOPASSWD: SYSTEMCTL_DAEMON_RELOAD
