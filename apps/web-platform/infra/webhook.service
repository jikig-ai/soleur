[Unit]
Description=Webhook deploy listener
After=network.target
# #7220 AC-B2.3 — disable systemd's start rate limit for this unit.
#
# Restart=on-failure with RestartSec=5 (below) and no override means systemd's default
# StartLimitBurst=5 within StartLimitIntervalSec=10s applies.
#
# CORRECTED (#7220 review): an earlier version of this comment claimed the TWO restarts the first
# post-grant apply performs — terraform_data's synchronous one, then the handler's delayed
# self-restart 3s later — would blow that limit. Two cannot: the burst is 5. The directive is
# still right, and the real mechanism is the one that makes it necessary: with Restart=on-failure
# and RestartSec=5, a genuinely crash-looping webhook reaches 5 starts inside 10s on its own, and
# the two deliberate restarts consume budget that a crash loop then only has to top up. Blowing
# the limit leaves webhook in `failed` and needing
# `systemctl reset-failed` to recover — which means SSH, on the one host that has no SSH runbook
# and no orderable replacement. The unit is the sole remediation channel, so a rate limit that
# can strand it buys nothing: a genuinely crash-looping webhook is a louder, separate problem
# than a webhook systemd refuses to start.
StartLimitIntervalSec=0
# DELIBERATELY UNCONDITIONED (#10078, CTO ruling): the five web probe units gained
# ConditionPathExists= skip-vs-fail on their late-written env files; this unit stays loud.
# /etc/default/webhook-deploy is written UNCONDITIONALLY by the same cloud-init runcmd
# (the bare printf before `enable --now webhook`), earlier than this unit's first start —
# an absent file is a real fault already covered by the on_err fatal trap, not benign
# ordering. A skipped Type=simple service never re-evaluates the condition, so a transient
# fault would become a permanently dead deploy channel with no self-heal — strictly worse
# than the RestartSec=5 crash-loop, which IS the designed signal (and the reason
# StartLimitIntervalSec=0 above must keep it firing). THE SIGNAL'S RECEIVERS:
# `soleur-wait-ready port 9000 webhook_bound` is the boot-time detector — a dead
# listener fails the :9000 bind gate and the host's boot/deploy run goes red;
# betteruptime_monitor.github_webhook_failures (alerts-github-webhook.tf) pages on
# sustained 4xx/5xx at /api/webhooks/github; and Vector ships the unit's restart
# journal rows to Better Stack logs, where the crash-loop shape itself is the
# queryable signal. Do not add a condition here without a written rationale.

[Service]
Type=simple
EnvironmentFile=/etc/default/webhook-deploy
# -ip 0.0.0.0 (was 127.0.0.1): the private-net peer must reach /hooks/deploy-peer
# for the 2-host deploy fan-out (#5274 Phase 3, ADR-068). SAFE because
# hcloud_firewall.web default-denies 9000 on the PUBLIC interface (only 22/80/443/
# icmp are allowed) — so only loopback + the private net (10.0.1.0/24) can connect.
# That default-deny is load-bearing; firewall-9000-deny.test.sh pins it.
ExecStart=/usr/local/bin/webhook -verbose -hooks /etc/webhook/hooks.json -port 9000 -ip 0.0.0.0
Restart=on-failure
RestartSec=5
User=deploy
Group=deploy
# NoNewPrivileges omitted: ci-deploy.sh requires sudo for chown (#967)
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
# Bootstrap path needs to install systemd units + binaries + env files under
# `sudo` (inngest-bootstrap.sh + any future `deploy <component>` handler).
# ProtectSystem=strict makes /etc/ /usr/ read-only at the mount-namespace
# level — sudo elevates UID but does NOT escape the namespace. Without these
# paths in ReadWritePaths, `cat > /etc/systemd/system/...` and
# `chown root:deploy /etc/default/...` fail with `Read-only file system` or
# silently mangled error messages (`invalid group: 'root:deploy'` because the
# initial `printf >` redirect actually failed but chown still ran).
# Surfaced 2026-05-19 via #4017 — PR-F's inngest substrate was never installed
# in production because the webhook deploy of the bootstrap image failed at
# the chown step inside this sandbox. /var/lib/inngest is `-`-optional (see the
# `-` prefix note below): when web_colocate_inngest is on, inngest-bootstrap's
# mkdir+chown for SQLite's data dir runs ahead of this unit's own ReadWritePaths.
# /etc/vector + /var/lib/vector added 2026-05-21 (TR9 PR-5): inngest-bootstrap.sh
# now also installs Vector (observability shipper) alongside the inngest CLI;
# its config + state dirs need bootstrap-time write access from inside this
# namespace. Surfaced via v1.1.1 deploy diagnostic capture
# (reason="mkdir: cannot create directory /etc/vector: Read-only file system").
# `-` prefix on /var/lib/inngest + /var/lib/vector + /etc/vector marks them
# optional: systemd silently ignores the path if absent, instead of refusing to
# set up the mount namespace (which on prior PR #4257 took webhook.service down
# entirely until the dirs were created). Once inngest-bootstrap.sh creates them
# (only when web_colocate_inngest is on), they become real ReadWritePaths.
# /var/lib/inngest got the `-` in #6090: web_colocate_inngest=false (default)
# gates off the dir-creator, so a mandatory token 226/NAMESPACE'd fresh web-2
# boots (:9000 never bound -> ok_peer_fanout_degraded).
ReadWritePaths=/mnt/data /var/lock /etc/systemd/system /etc/default /etc/sudoers.d /etc/webhook -/var/lib/inngest -/var/lib/vector -/etc/vector /usr/local/bin
ReadOnlyPaths=/etc/default/webhook-deploy
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
