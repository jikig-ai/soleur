# ARTIFACT 1 — source-liveness anchor. Excludes this host BY DESIGN: an anchor a
# silent host could satisfy would collapse "dark boot" and "broken instrument".
# QUERY: SELECT /* __ANCHOR__ source-liveness: is this log source answering AT ALL? */ dt, JSONExtractString(raw,'host_name') AS host FROM (SELECT dt, raw FROM remote($BS_TABLE) UNION ALL SELECT dt, raw FROM s3Cluster(primary, $BS_TABLE_S3) WHERE _row_type = 1) WHERE dt > now() - INTERVAL 7 DAY AND JSONExtractString(raw,'host_name') != '' AND JSONExtractString(raw,'host_name') != 'soleur-git-data-rehearsal-33888071954' ORDER BY dt DESC LIMIT 5 FORMAT JSONEachRow
#
# ARTIFACT 2 — every stage this host reported, and ARTIFACT 3 — the fatal/false-assertion
# arms, both read from this one result set.
# QUERY: SELECT /* __HOSTROWS__ every stage this rehearsal host reported */ dt, JSONExtractString(raw,'stage') AS stage, JSONExtractString(raw,'level') AS level, JSONExtractString(raw,'host_name') AS host, JSONExtractString(raw,'detail') AS detail, JSONExtractString(raw,'rc') AS rc, JSONExtractString(raw,'luks_mounted') AS luks_mounted, JSONExtractString(raw,'repo_root') AS repo_root, JSONExtractString(raw,'hooks_path') AS hooks_path, JSONExtractString(raw,'provision') AS provision FROM (SELECT dt, raw FROM remote($BS_TABLE) UNION ALL SELECT dt, raw FROM s3Cluster(primary, $BS_TABLE_S3) WHERE _row_type = 1) WHERE dt > now() - INTERVAL 7 DAY AND JSONExtractString(raw,'host_name') = 'soleur-git-data-rehearsal-33888071954' ORDER BY dt DESC LIMIT 50 FORMAT JSONEachRow
# QUERY_FATAL: SELECT /* __FATALROWS__ every FATAL this rehearsal host reported, unbounded by row chatter */ dt, JSONExtractString(raw,'stage') AS stage, JSONExtractString(raw,'level') AS level, JSONExtractString(raw,'host_name') AS host, JSONExtractString(raw,'detail') AS detail, JSONExtractString(raw,'rc') AS rc FROM (SELECT dt, raw FROM remote($BS_TABLE) UNION ALL SELECT dt, raw FROM s3Cluster(primary, $BS_TABLE_S3) WHERE _row_type = 1) WHERE dt > now() - INTERVAL 7 DAY AND JSONExtractString(raw,'host_name') = 'soleur-git-data-rehearsal-33888071954' AND JSONExtractString(raw,'level') = 'fatal' ORDER BY dt ASC LIMIT 1000 FORMAT JSONEachRow
