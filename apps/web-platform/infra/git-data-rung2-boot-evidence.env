# silent host could satisfy would collapse "dark boot" and "broken instrument".
# QUERY: SELECT /* __ANCHOR__ source-liveness: is this log source answering AT ALL? */ dt, JSONExtractString(raw,'host_name') AS host FROM (SELECT dt, raw FROM remote($BS_TABLE) UNION ALL SELECT dt, raw FROM s3Cluster(primary, $BS_TABLE_S3) WHERE _row_type = 1) WHERE dt > now() - INTERVAL 30 DAY AND JSONExtractString(raw,'host_name') != '' AND JSONExtractString(raw,'host_name') != 'soleur-git-data-rehearsal-36029201848' ORDER BY dt DESC LIMIT 5 FORMAT JSONEachRow
