[Unit]
# (#6982, W4) Daily trigger for the bounded git-data maintenance run.
Description=Daily git-data bare-repo maintenance
Documentation=https://github.com/jikig-ai/soleur/issues/6982

[Timer]
# DAILY at 03:20 UTC, not weekly. With gc.auto=0 and receive.autogc=false this timer is the
# only thing that ever packs or prunes, so the interval IS the store's worst-case unmaintained
# window -- and --unpack-unreachable=2.weeks.ago loosens objects that then sit until the next
# run, maximising loose-object (and therefore inode) residency between runs. Daily costs
# essentially nothing: the run is idempotent, holds a non-blocking flock, and is bounded by
# the unit's own MemoryMax/CPUQuota/IOSchedulingClass caps.
OnCalendar=*-*-* 03:20:00
RandomizedDelaySec=1800
# Run a missed occurrence after a reboot. Cheap: the script is idempotent and holds a
# non-blocking flock.
Persistent=true

[Install]
WantedBy=timers.target
