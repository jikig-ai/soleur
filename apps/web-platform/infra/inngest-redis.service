[Unit]
Description=Inngest durable Redis (AOF queue/run-state on /mnt/data, #5450)
After=network-online.target
Wants=network-online.target
# LOAD-BEARING (architecture review P1-2): without RequiresMountsFor, Redis can
# start before the `|| true` volume mount in cloud-init and write its AOF to the
# ephemeral ROOT disk — silently reproducing the exact data-loss trap this
# migration fixes. This pins the unit to the persistent /mnt/data mount.
RequiresMountsFor=/mnt/data
# DELIBERATELY UNCONDITIONED (#9962): the sibling units gained ConditionPathExists=
# skip-vs-fail on the same env file, but this unit stays loud — a missing
# /etc/default/inngest-server on the data-bearing Redis unit is a designed-loud
# mount-class failure, not benign ordering noise. Do not add a condition here
# without a written rationale.

[Service]
Type=simple
# Runs as deploy (same as inngest-server.service) so it can read the shared
# Doppler env file and own /mnt/data/redis — NOT the distro `redis` user (which
# cannot read /etc/default/inngest-server and would split the doppler-auth source).
User=deploy
Group=deploy
EnvironmentFile=/etc/default/inngest-server
# #6617c: WITHOUT this, systemd derives SYSLOG_IDENTIFIER from the ExecStart basename ->
# `doppler`, which matches ZERO vector.toml sources, so this unit's stderr (redis-server's AND
# doppler's) never leaves the host. Same defect the heartbeat unit had for 3 days (#6536) —
# and the reason a `inngest-redis` entry in Vector's Source 4 allowlist was, until now, a
# permanently-dead no-op: Source 4 is EXACT-VALUE SYSLOG_IDENTIFIER equality, never a prefix
# match, so the tag and the allowlist entry only work as a pair. journald-config.test.sh
# asserts both sides; do not change this literal without changing vector.toml with it.
SyslogIdentifier=inngest-redis
# #7695 — TWO-STATE /mnt/data guard, installed by inngest-redis-bootstrap.sh step 3.5.
# RequiresMountsFor above orders this unit after the fstab-generated mount unit, but the failure
# that actually loses data is the one where NO mount unit exists: cloud-init's LUKS stage aborted,
# /mnt/data is a plain directory on the ephemeral root disk, RequiresMountsFor resolves to nothing,
# and Redis writes its AOF somewhere a host replace erases. The guard refuses that start.
# It is deliberately NOT one-state: demanding /dev/mapper/inngest-redis unconditionally would
# refuse to start Redis on the PRE-recut host (still plaintext ext4) and deadlock the cutover this
# apparatus exists to enable. See the script's own header for the two states.
ExecStartPre=/usr/local/bin/inngest-redis-mount-guard.sh
# Password delivery via aclfile (#11103). The writer runs under `doppler run
# --only-secrets INNGEST_REDIS_PASSWORD` — it sees exactly ONE secret name (the
# whole prd config is no longer injected), refuses unconditionally under xtrace,
# and atomically writes /mnt/data/redis/inngest-redis.acl (0600), which the conf
# declares via `aclfile`. It runs AFTER the mount-guard so the file lands on the
# proven persistent mount, and as User=deploy inside ReadWritePaths=/mnt/data/redis
# it can only write there. This replaces the old inner-shell `-c` expansion: a
# traced launch (SHELLOPTS=xtrace / BASH_ENV) printed the resolved password to
# stderr and journald shipped it off-box, and --requirepass also left the
# cleartext on redis-server's argv (/proc/<pid>/cmdline, 0444) and readable via
# CONFIG GET — the ACL stores SHA256, so none of those surfaces carries it now.
ExecStartPre=/usr/bin/doppler run --config ${DOPPLER_CONFIG} --only-secrets INNGEST_REDIS_PASSWORD -- /usr/local/bin/inngest-redis-acl.sh
# The ExecStart expands NOTHING: no doppler run, no inner `-c` wrapper, no $ of any spelling.
ExecStart=/usr/bin/redis-server /mnt/data/redis/inngest-redis.conf
Restart=on-failure
RestartSec=5
# Sized for the modest queue/run-state; bound so a runaway cannot starve the
# co-located web-platform + inngest-server on the shared cx33 (8GB).
MemoryMax=384M
CPUQuota=50%
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
# conf + AOF both live under /mnt/data/redis (the only path writable from the
# webhook.service deploy namespace — /etc is read-only there, ProtectSystem=strict).
ReadWritePaths=/mnt/data/redis
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
