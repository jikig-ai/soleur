[Unit]
# (#8210) THE STANDING RETRY for the boot-time LUKS reopen, and the reason it is its own timer.
#
# The unit's `Restart=on-failure` budget is 5 attempts over an hour, so a Doppler or DNS outage
# lasting longer than that leaves the encrypted store CLOSED with no further automatic attempt.
# Review found the unattended-restoration claim in ADR-198's Art. 32(1)(c) amendment was true
# only inside that budget.
#
# The first fix hung recovery off `git-data-gc.timer` with a `Wants=` — which the simplicity
# lens cut, correctly: a WEEKLY maintenance timer is the wrong layer and the wrong cadence for a
# boot-critical unit, it re-fires the OnFailure reporter every week on a host nobody is fixing by
# waiting, and it bounds recovery at 7 days. A dedicated timer answers both objections: the
# retry lives with the unit it retries, at a cadence matched to the outage it absorbs.
#
# WHAT A TICK RECOVERS, PRECISELY: A FAILED UNIT, AND ONLY THAT. The service is Type=oneshot
# with RemainAfterExit=yes, so after a healthy boot it sits active(exited) and a timer tick's
# `start` job is a NO-OP — ExecStart does not re-run, so a tick against a healthy host costs
# NOTHING, not even a `cryptsetup status` (an earlier revision of this comment said otherwise).
# Once the unit has FAILED — the restart budget spent against a Doppler or DNS outage — the
# tick's start re-runs ExecStart, and that is the recovery this timer buys. The case it does
# NOT cover is a mapper closed AFTER a healthy boot under a still-active unit (a luksClose, a
# volume detach): nothing re-attempts the reopen there and git-data-gc's weekly mountpoint
# FATAL is what notices, up to seven days later. That residual is scope-outed in the plan's
# failure-modes table as the "host up, mapper closed later" row; it is not closed here.
Description=Standing retry for the git-data LUKS mapper reopen (#8210)
Documentation=https://github.com/jikig-ai/soleur/issues/8210

[Timer]
# 15 minutes is the TICK, not the recovery bound. A tick inside the unit's still-open
# StartLimitIntervalSec=1h window is refused on an already-failed unit and does nothing
# (measured on 261 at review: zero reporter runs for refused starts), so a multi-hour Doppler
# outage self-heals at the first tick after that hour closes — within ~1h15 of the vendor
# recovering, not a quarter-hour as an earlier revision claimed, and instead of the next weekly
# maintenance window. The window cannot be shortened below the slow ladder (5x300 + 4x60 s):
# a shorter one never trips the start limit, so a slow-failing unit would restart forever with
# no terminal state and no report. OnUnitActiveSec (not OnCalendar) so the clock restarts from
# the last run rather than firing a thundering burst after a long outage.
OnUnitActiveSec=15min
OnBootSec=15min
RandomizedDelaySec=120
# NO Persistent=. It was here, copied from git-data-gc.timer with its "catch-up tick after a
# long outage" reasoning — and systemd.timer(5) says the directive "only has an effect on
# timers configured with OnCalendar=", which gc's is and this one is not. It was inert, and
# its comment was a load-bearing falsehood waiting to be cited. OnBootSec= above is what
# actually provides the post-boot tick.
# COST ON A HOST THAT STAYS BROKEN, measured rather than reasoned (an earlier revision of this
# comment said "four fatals an hour"; it was wrong in both directions). A refused tick fires
# nothing. The first tick after the 1h window closes re-runs a full ladder, which — because the
# service carries RestartMode=direct — emits ONE fatal at convergence, not one per attempt. So:
# about one fatal and ~6 Doppler calls per hour, ~20-24 events a day, collapsed by Sentry into
# one issue (constant message, no fingerprint). The right signal for an unresolved fatal; the
# alternative (silence with the store closed) is the defect #8210 exists to remove. The
# operator reading is in git-data-luks-cutover-5274.md, under "Event counts".

[Install]
WantedBy=timers.target
