[Unit]
Description=git-data consumer-perspective reachability probe (web host, #6548)
After=network-online.target
Wants=network-online.target
# SKIP-VS-FAIL (#10078, the #9962/#9939 pattern): /etc/default/web-git-data-probe is
# written by web-probe-envwrite.sh, a `|| true`-tolerated late-runcmd write, and the
# 60s timer is armed unconditionally — an absent file must SKIP this start (one
# "skipped, unmet condition check" notice per fire), never FAIL it into an
# every-60s journal storm. The EnvironmentFile= line stays unprefixed: once a start
# IS attempted, an absent file still fails the unit — the fail-closed contract is
# retained. The condition re-evaluates on every timer fire, so the probe self-heals
# when the file appears. The detectors that do NOT share this gated dependency: the
# `soleur-boot-emit web_probe_envwrite fatal` boot row on a writer failure, and the
# missing betteruptime_heartbeat.git_data_prd beat — a skipped probe pings nothing.
ConditionPathExists=/etc/default/web-git-data-probe

[Service]
Type=oneshot
# HOME=/root: the ExecStart runs `doppler run` as ROOT (no User=). The Doppler CLI's
# os.UserHomeDir() init dies "Doppler Error: $HOME is not defined" for a root systemd service
# (which gets no $HOME) BEFORE it can exec the probe — the reason every working root-doppler unit
# on the fleet (container-restart-monitor, cron-egress-*, inngest-cutover-flip) sets this. With
# HOME=/root doppler uses /root/.doppler; the prd DOPPLER_TOKEN arrives via the EnvironmentFile
# below (written by the *_install provisioner from doppler_service_token.web_probes). No
# DOPPLER_CONFIG_DIR → never /tmp/.doppler (the #6536 clash surface). #6438/#6548.
Environment=HOME=/root
# SyslogIdentifier retags the unit's journal output away from the ExecStart basename `bash`
# (systemd default) to a diagnostic-critical identifier shipped by vector.toml Source 4
# (host_scripts_journald) — so the probe's fault-classification stderr ("SUPPRESS ping: UNREACHABLE
# over the private net", "heartbeat ping FAILED") reaches Better Stack off-box, not SSH-only
# (hr-no-ssh-fallback-in-runbooks; the #6556 inngest-heartbeat lesson). Mirrored in vector.toml.
SyslogIdentifier=web-git-data-probe
# /etc/default/web-git-data-probe (baked per-host) carries GIT_DATA_ENDPOINT +
# GIT_DATA_HEARTBEAT_URL_KEY (the Doppler var name for this host's git_data_prd URL; git-data
# uses ONE shared beat today — single-host makes masking moot, C3). doppler run injects
# GIT_DATA_HEARTBEAT_URL, and the script resolves it through that key NAME itself, AFTER its
# xtrace refusal. The ExecStart below expands and exports NOTHING (#9639): the URL is a
# credential, and a wrapper that expanded it would print it under a traced launch before the
# script could refuse. doppler-injection-bound.test.sh rejects an indirect expansion in the Exec
# directives of a doppler-run unit.
EnvironmentFile=/etc/default/web-git-data-probe
ExecStart=/bin/bash -c 'doppler run --project soleur --config prd -- /usr/local/bin/web-git-data-probe.sh'
