#!/usr/bin/bash
# bwrap PATH shim (#8752) — the Agent SDK spawns PATH-resolved `bwrap` (the
# vendored argv builder's fd-passing contract is set in stone), so this shim
# gives the agent sandbox what we control directly in the C4 chain:
#
#   1. inherited-fd hygiene — every fd above stderr that the argv does not
#      reference is closed before the real bwrap runs (bwrap and libuv close
#      nothing; a leaked socket/secret fd was measured reachable inside the
#      sandbox).
#   2. the shared nested-userns seccomp filter, injected as --add-seccomp-fd
#      (repeatable, stacks with any future SDK filter; a hypothetical SDK
#      --seccomp conflicts loudly at parse time instead of silently
#      last-wins-overriding ours).
#
# Fd-contract notes:
#   * `--args FD` carries the whole setup argv NUL-separated on a pipe. For
#     the #10032 neutralization the payload IS consumed — read to EOF
#     pre-sweep, filtered, re-emitted on a fresh post-sweep fd, and the argv
#     fd reference renumbered (an unreadable or EMPTY payload refuses the
#     spawn: a silent empty re-emit would drop the entire setup argv →
#     unsandboxed exec).
#   * Command-side fds named by PATH (`/proc/self/fd/N` — the vendored
#     apply-seccomp multicall) are preserved: the scan covers only
#     command-position tokens (after the boundary / first operand), never
#     option values — an option-position match would over-preserve (the leak
#     direction).
#   * The filter fd is auto-allocated (`exec {v}<`) so it cannot collide with
#     an SDK-chosen fd number.
#   * This script's own fd is preserved: bash reads it lazily, and the sweep
#     would truncate the script mid-parse.
#
# Fail-closed: any setup anomaly exits 65 with a `bwrap-shim:` stderr marker —
# never fall back to an unfiltered/unscrubbed spawn.
#
# /proc mask realization (#9723 intent, #10032 mechanism — ADR-075 addenda).
# The vendored builder's enableWeakerNestedSandbox handling appends
# `--bind /proc /proc` at the END of the setup argv — landing AFTER the
# config's denyRead `--tmpfs /proc` and, because later mounts win,
# re-exposing host procfs (cross-tenant /proc/<pid>/environ reads). The
# #9723 fix spliced a fresh pidns-scoped `--proc /proc` over the tail bind —
# but a fresh procfs mount EPERMs under docker's default masked /proc
# (mount_too_revealing; bwrap 0.8.0, "Can't mount proc on /newroot/proc"),
# so every spawn failed closed in prod (#9860 canary).
#
# The realization therefore changed shape (candidate 2+3, no fresh procfs):
#   * NEUTRALIZE — every procfs-mount-at-/proc token in the merged setup
#     stream is DROPPED (bind-family and --proc with normalized dest /proc,
#     --bind-fd/--ro-bind-fd with dest /proc), in the outer argv AND inside
#     every consumed --args payload (re-emit is selective, never verbatim).
#     The vendored denyRead `--tmpfs /proc` then lands as the realized mask
#     — an empty /proc tmpfs (the container's procfs sits beneath it, see
#     below), stronger than a pidns-scoped procfs and
#     impossible to defeat with mount ordering. Dropping (not covering) makes
#     the stream carry NO argv-requested procfs mount at /proc, which is the
#     property this shim states and the docker suite's recorder arm asserts.
#     It is NOT a claim that no procfs object exists beneath the tmpfs: the
#     vendored argv's recursive --ro-bind / / carries the container's procfs
#     there after a drop as well (measured, #10065 measurements.md M3), and a
#     drop and a cover differ only for a process holding CAP_SYS_ADMIN over the
#     mount namespace; the barrier against that is INFERRED to be the vendor's
#     --cap-drop ALL on an unelevated bwrap (every umount2 is EPERM in every
#     arm; the attribution is not measured; the docker run tuples must also keep
#     their posture, see ADR-075 addendum 2026-10-12). When the merged stream
#     carries no `--tmpfs /proc` of its own, the shim appends one at the
#     last setup position so the dropped exposure is never replaced by the
#     root bind's procfs.
#   * RE-HOME — the one /proc path the vendored inner command needs is its
#     apply-seccomp multicall exec path `/proc/self/fd/N`. For each unique
#     command-side ref the shim emits a setup mount at the LITERAL path
#     `/proc/self/fd/N` (token-preserving — no command-token rewrite).
#     Prod's bwrap 0.8.0 collapses the rung ladder to one viable rung:
#       --ro-bind <resolved-source> /proc/self/fd/N   (readlink resolves a
#         real, readable file path — the vendored CLI binary case)
#     --bind-data/--ro-bind-data EBADF at write on 0.8.0, --bind-fd parses
#     but cannot resolve its fd source, and /proc/self/fd/N is not a
#     source bwrap can bind — so an fd whose readlink yields a deleted
#     path, pipe:, socket:, anon_inode:, or nothing at all REFUSES (exit
#     65) rather than shipping a silently-broken multicall.
#   * Order — the appended `--tmpfs /proc` (when needed) always precedes
#     the re-home mounts: a later /proc mount would cover them, and their
#     dests must be creatable under the tmpfs.
#   * Gates — an exposure-carrying argv still requires option-position
#     --unshare-pid AND --unshare-user (unchanged fail-closed contract);
#     re-home mounts additionally require --unshare-user (unprivileged
#     mounts need the namespace).
#   * A merged setup argv that never mounts procfs at /proc and names no
#     command-side /proc/self/fd refs passes through byte-identical — the
#     ci-deploy canary probe shape (v0.330.10) stays untouched.
#
# Placement: re-home/mask mounts land at the LAST setup position of the
# MERGED stream — always in the OUTER argv (upstream parse_args_recurse
# resumes outer-argv option parsing after every payload, so trailing
# outer tokens are still setup; an inner `--` ends only that payload's
# options):
#   Arm A  first outer `--` (no --args, or no `--` inside any payload):
#          inserted immediately before it — after every setup token.
#   Arm B  a `--` carried INSIDE an --args payload: the outer parser
#          resumes option parsing after the payload ends, so outer emits
#          still land after every payload mount (verified on bwrap
#          0.12.0); payloads are filtered, never verbatim.
#   Arm C  no boundary anywhere (command starts at the first bare
#          operand, or the argv is pure options): emit lands before the
#          operand / at tail.
# Fail-closed applies to the rewrite too: an unreadable or EMPTY --args
# payload, a re-emit failure, or an unresolvable fd ref refuses the
# spawn — never an unmasked namespace (a non-numeric fd value passes
# through for real bwrap to report).
#
# Known limits: `--opt=value` equals-forms are invisible to the arity walk —
# getopt accepts them, and they evade BOTH fd preservation AND the /proc
# exposure gate (a `--bind=/x /proc` would pass through unmasked); the
# vendored builder emits none. An option this table doesn't know can still
# desync after it (over-preserve — the leak direction, so conservative). The
# dest check is exact-`/proc` after normalization: a procfs mount at a
# descendant (`--bind /proc /proc/sub`) is out-of-shape (the vendored builder
# emits /proc dests only) and survives both the filter and the canary's
# `/proc/[0-9]*` glob — a shape-boundary, not universal coverage. Same for
# implicit exposure: a stream whose `/proc` view comes only from a root
# bind (no explicit /proc-dest token, no fd refs) passes through unmasked;
# the vendored stream always co-carries the tail bind or the denyRead tmpfs,
# so this never fires on the real shape. BWRAP_FD_VALUED_OPTS
# (scripts/sandbox-canary.mjs) mirrors the fd sets — asserted
# byte-identical by sandbox-canary-regression.test.sh §D4.
set -u

REAL=${SOLEUR_BWRAP_REAL:-/usr/bin/bwrap}
BPF=${SOLEUR_BWRAP_SECCOMP_BPF:-/app/infra/bwrap-userns-clone3-deny.bpf}

fail() {
  printf 'bwrap-shim: %s\n' "$1" >&2
  exit 65
}

# Probe passthrough: the SDK checks availability with `bwrap --version`
# (failIfUnavailable). A lone probe builds no sandbox — exec verbatim.
if [ "$#" -le 1 ]; then
  case "${1:-}" in
    --version|--help|"") [ -x "$REAL" ] || fail "real bwrap not executable: $REAL"
                         exec "$REAL" "$@" ;;
  esac
fi

# Preserve-set: fds the outer argv references by number. The scan is
# ARITY-AWARE, not prev-token — a value-position token that happens to equal
# an fd-option name (`--setenv --args 9`) must not preserve an fd, and an
# option must not eat another option's value.
#
#   fd1: arg1 is an fd, nothing else consumed.
#   fd2: arg1 is an fd, arg2 (dest/pid) also consumed.
#   a1/a2/a3: non-fd options consuming 1/2/3 tokens — their values are SKIPPED
#     so a flag-named value can't desync the scan.
#
# The ONE option-arity table, shared by the outer argv, every `--args`
# payload, and the neutralize filter. Echoes the token's parse class —
#   fd1:  arg1 is an fd, nothing else consumed.
#   fd2:  arg1 is an fd, arg2 (dest/pid) also consumed.
#   a1/a2/a3: non-fd options consuming 1/2/3 tokens — their values are
#     SKIPPED so a flag-named value can't desync the scan.
#   boundary: literal `--` in OPTION position (a `--` consumed as an option
#     VALUE — e.g. `--setenv K --` — is not a boundary).
#   operand: a bare token = command start under the no-`--` form.
#   other:  an unknown option — zero-arg assumption (fail toward loudness).
opt_kind() { # opt_kind <tok> — sets OPT_KIND (never echoes: a per-token $()
             # fork-per-call would dominate spawn latency).
  case "$1" in
    --) OPT_KIND=boundary ;;
    --args|--seccomp|--add-seccomp-fd|--sync-fd|--info-fd|--json-status-fd|--block-fd|--userns-block-fd|--userns|--pidns) OPT_KIND=fd1 ;;
    --file|--bind-data|--ro-bind-data|--bind-fd|--ro-bind-fd|--userns2) OPT_KIND=fd2 ;;
    --argv0|--uid|--gid|--hostname|--chdir|--unsetenv|--lock-file|--remount-ro|--overlay-src|--tmp-overlay|--ro-overlay|--exec-label|--file-label|--proc|--dev|--tmpfs|--mqueue|--dir|--cap-add|--cap-drop|--perms|--size) OPT_KIND=a1 ;;
    --setenv|--bind|--bind-try|--dev-bind|--dev-bind-try|--ro-bind|--ro-bind-try|--chmod|--symlink) OPT_KIND=a2 ;;
    --overlay) OPT_KIND=a3 ;;
    -*) OPT_KIND=other ;;
    *) OPT_KIND=operand ;;
  esac
}

# Canonicalize a mount DEST for the exposure check: collapse duplicate
# slashes, resolve `/./` and `/../` components. The dest is a NEWROOT path —
# never host filesystem — so this is pure path algebra, no stat. Mount
# semantics treat /proc//, //proc, /proc/./, /a/../proc as /proc; without
# normalization each is a silent-evasion spelling of the /proc exposure.
norm_dest() { # norm_dest <path> → stdout
  local d="$1" out="" seg
  # collapse duplicate slashes
  while [[ "$d" == *///* ]]; do d="${d//\//\/}"; done
  local IFS='/'
  for seg in $d; do
    case "$seg" in
      ''|.) ;;
      ..) out="${out%/*}" ;;
      *) out="$out/$seg" ;;
    esac
  done
  printf '%s' "${out:-/}"
}

# proc_dest <raw-dest> — truthy iff the dest normalizes to /proc. Literal
# fast-path for the common case: only a dest containing `//`, a `.`/`..`
# segment, or a trailing slash can normalize to /proc without already being
# it — the $(norm_dest) fork runs only on those spellings (the file's
# latency discipline: per-token $() dominates spawn cost — perf review).
proc_dest() {
  case "$1" in
    /proc) return 0 ;;
    [!/]*|*//*|*/|*/.*) [ "$(norm_dest "$1")" = "/proc" ] ;;
    *) return 1 ;;
  esac
}

# proc_src <src> — truthy iff a bind SOURCE normalizes at-or-under /proc:
# a bind whose source is procfs-resident mounts procfs AT ITS DEST —
# dest-only detection would let `--bind /proc /x` carry host procfs into
# the sandbox at /x (security-review F3). Bare-token fast-path first;
# non-absolute or mutable spellings normalize.
proc_src() {
  case "$1" in
    /proc|/proc/*|[!/]*|*//*|*/|*/.*)
      local n="$(norm_dest "$1")"
      [ "$n" = /proc ] || [[ "$n" == /proc/* ]] ;;
    *) return 1 ;;
  esac
}

# The ONE arity walk over a token array. Emits "<boundary> <operand> <pidns>
# <userns> <procexpose> <fdlist>" — indices of the first option-position `--`
# and first bare operand (-1 when absent), whether an option-position
# `--unshare-pid`/`--unshare-all` / `--unshare-user`/`--unshare-all` was seen
# (VALUE-position tokens — e.g. `--setenv K --unshare-pid` — must not count:
# they mount no namespace), whether the setup stream MOUNTS procfs at /proc
# (a bind-family option or --proc whose DEST is /proc — the vendored tail
# `--bind /proc /proc` the neutralization exists to defeat; a bare
# `--tmpfs /proc` is a mask itself, not an exposure, and does not trigger),
# plus a space-separated list of fd-valued option values found before either
# marker (fds the setup argv references by NUMBER; a `--` or operand ends
# the scan). Command-side tokens never walked.
setup_marks() { # setup_marks <tok>… → stdout "<boundary> <operand> <pidns> <userns> <expose> <mask> <fds>"
  local toks=("$@") n=$# i=0 tok kind="" skip=0 expect_fd=0 extra_skip=0
  local fds="" pidns=0 userns=0 expose=0 mask=0
  while [ "$i" -lt "$n" ]; do
    tok="${toks[$i]}"
    if [ "$skip" -gt 0 ]; then skip=$((skip - 1))
    elif [ "$expect_fd" = 1 ]; then
      case "$tok" in
        ''|*[!0-9]*) ;;             # non-numeric: real bwrap reports it
        *) fds="$fds $tok" ;;
      esac
      expect_fd=0; skip=$extra_skip; extra_skip=0
    else
      opt_kind "$tok"; kind="$OPT_KIND"
      [ "$kind" = other ] && case "$tok" in
        --unshare-pid) pidns=1 ;;
        --unshare-user) userns=1 ;;
        --unshare-all) pidns=1; userns=1 ;;
      esac
      case "$kind" in
        boundary) printf '%s -1 %s %s %s %s%s\n' "$i" "$pidns" "$userns" "$expose" "$mask" "$fds"; return ;;
        fd1) expect_fd=1 ;;
        fd2)
          # --bind-fd/--ro-bind-fd: arg1 is the fd, arg2 is the DEST — a
          # procfs fd bound at /proc is the same exposure class.
          case "$tok" in
            --bind-fd|--ro-bind-fd)
              proc_dest "${toks[$((i + 2))]:-}" && expose=1 ;;
          esac
          expect_fd=1; extra_skip=1 ;;
        a1)
          [ "$tok" = "--proc" ] && expose=1
          [ "$tok" = "--tmpfs" ] && proc_dest "${toks[$((i + 1))]:-}" && mask=1
          skip=1 ;;
        a2)
          case "$tok" in
            --bind|--bind-try|--dev-bind|--dev-bind-try|--ro-bind|--ro-bind-try)
              { proc_dest "${toks[$((i + 2))]:-}" || proc_src "${toks[$((i + 1))]:-}"; } && expose=1 ;;
          esac
          skip=2 ;;
        a3) skip=3 ;;
        operand) printf -- '-1 %s %s %s %s %s%s\n' "$i" "$pidns" "$userns" "$expose" "$mask" "$fds"; return ;;
        *) ;;                       # other — zero-arg assumption
      esac
    fi
    i=$((i + 1))
  done
  printf -- '-1 -1 %s %s %s %s%s\n' "$pidns" "$userns" "$expose" "$mask" "$fds"
}

# Drop every procfs-mount-at-/proc token run from the setup side of the
# array named by $1 (the walk stops verbatim at the first boundary/operand
# token — command-side tokens are never touched). Sets FDROPPED (count of
# mount ops removed) and FMASK (1 when a `--tmpfs /proc` mask remains in the
# stream — the denyRead entry the tail bind exists to shadow). Same dest
# detection as the exposure gate: bind-family and --proc with normalized
# dest /proc, plus --bind-fd/--ro-bind-fd with dest /proc.
filter_proc_exposure() { # filter_proc_exposure <array-name> [payload]
  # [payload] mode: an --args token in option position would hand upstream a
  # nested stream this shim never filtered — refuse (vendored builder emits
  # flat --args only; security-review F2).
  local -n _A=$1
  local _i=0 _n=${#_A[@]} _tok _kind _pl=${2:-}
  local _out=()
  FDROPPED=0; FMASK=0
  while [ "$_i" -lt "$_n" ]; do
    _tok="${_A[$_i]}"
    opt_kind "$_tok"; _kind="$OPT_KIND"
    case "$_kind" in
      boundary|operand) _out+=("${_A[@]:$_i}"); break ;;
      a1)
        if [ "$_tok" = "--proc" ]; then
          FDROPPED=$((FDROPPED + 1)); _i=$((_i + 2)); continue
        elif [ "$_tok" = "--tmpfs" ]; then
          proc_dest "${_A[$((_i + 1))]:-}" && FMASK=1
        fi
        _out+=("${_A[@]:$_i:2}"); _i=$((_i + 2)) ;;
      a2)
        case "$_tok" in
          --bind|--bind-try|--dev-bind|--dev-bind-try|--ro-bind|--ro-bind-try)
            # procfs at dest OR procfs as SOURCE — a `--bind /proc /x` mount
            # carries host procfs into the sandbox at /x (security F3)
            if proc_dest "${_A[$((_i + 2))]:-}" || proc_src "${_A[$((_i + 1))]:-}"; then
              FDROPPED=$((FDROPPED + 1)); _i=$((_i + 3)); continue
            fi ;;
        esac
        _out+=("${_A[@]:$_i:3}"); _i=$((_i + 3)) ;;
      fd2)
        case "$_tok" in
          --bind-fd|--ro-bind-fd)
            if proc_dest "${_A[$((_i + 2))]:-}"; then
              # The mount is gone — its fd has no surviving consumer. Strip it
              # from `preserve` so the sweep closes it: an O_PATH procfs dirfd
              # riding into the sandbox re-opens the cross-tenant read
              # channel via openat, unmasking what the drop just masked
              # (review R1). Wrap before substituting — the last token has no
              # trailing delimiter.
              preserve=" ${preserve} "
              case "${_A[$((_i + 1))]}" in
                *[!0-9]*) ;;  # never preserved (non-numeric); also keeps a
                              # glob-metachar fd token out of the strip pattern
                *)
                  # Loop until stable — a global //replace can't collapse
                  # adjacent duplicates (" N N" leaves one behind).
                  while [ "${preserve/ ${_A[$((_i + 1))]} / }" != "$preserve" ]; do
                    preserve="${preserve// ${_A[$((_i + 1))]} / }"
                  done ;;
              esac
              preserve="${preserve# }"; preserve="${preserve% }"
              FDROPPED=$((FDROPPED + 1)); _i=$((_i + 3)); continue
            fi ;;
        esac
        _out+=("${_A[@]:$_i:3}"); _i=$((_i + 3)) ;;
      fd1)
        [ "$_pl" = payload ] && [ "$_tok" = "--args" ] && \
          fail "nested --args inside an --args payload cannot be filtered — refusing"
        _out+=("${_A[@]:$_i:2}"); _i=$((_i + 2)) ;;
      a3)  _out+=("${_A[@]:$_i:4}"); _i=$((_i + 4)) ;;  # opt + THREE values —
          # striding 3 would re-scan the last value as an operand and break
          # early, leaving any downstream /proc exposure unfiltered (review C1).
      *)   _out+=("$_tok"); _i=$((_i + 1)) ;;   # other — zero-arg assumption
    esac
  done
  _A=("${_out[@]}")
}

# Recompute boundary / operand / args_pos on the FILTERED outer argv —
# neutralization shifts every index that followed a dropped run, so the
# stage-1 positions cannot be reused for the emit splice or fd renumbering.
rescan_outer() {
  boundary=-1; operand=-1; args_pos=()
  local i=0 n=${#argv[@]} kind
  while [ "$i" -lt "$n" ]; do
    opt_kind "${argv[$i]}"; kind="$OPT_KIND"
    case "$kind" in
      boundary) boundary=$i; return ;;
      operand) operand=$i; return ;;
      fd1|fd2)
        case "${argv[$i]}" in
          --args) case "${argv[$((i + 1))]:-}" in
            ''|*[!0-9]*) ;;
            *) args_pos+=("$((i + 1))") ;;
          esac ;;
        esac
        i=$((i + 1)); [ "$kind" = fd2 ] && i=$((i + 1)) ;;
      a1) i=$((i + 1)) ;;
      a2) i=$((i + 2)) ;;
      a3) i=$((i + 3)) ;;
      other) ;;
    esac
    i=$((i + 1))
  done
}

# Preserve every fd named by PATH in COMMAND-side tokens — the vendored inner
# command execs its own binary as `/proc/self/fd/N` (the apply-seccomp
# multicall) with N carried on the child's fd table via stdio, never as an
# fd-valued option. Scoped to the command side deliberately: an option-value
# match would pin a host fd the sandbox was never meant to keep (the sweep's
# leak direction). Vocabulary is `/proc/self/fd/N` only — `/dev/fd/N` or
# `/proc/<pid>/fd/N` are not the vendored shape and stay swept (loud, not
# silent). One joined scan, not per-token regexes — a match can't span tokens
# and only digits are extracted. Each match lands in BOTH `preserve` (the
# sweep keep-set) and `cmd_fd_refs` (the re-home worklist).
add_cmd_fd_refs() { # add_cmd_fd_refs <tok>…
  local joined=" $* "
  while [[ $joined =~ /proc/self/fd/([0-9]+) ]]; do
    preserve="$preserve ${BASH_REMATCH[1]}"
    cmd_fd_refs="$cmd_fd_refs ${BASH_REMATCH[1]}"
    joined="${joined#*"${BASH_REMATCH[0]}"}"
  done
}

argv=("$@")
argc=$#
preserve=""
cmd_fd_refs=""
args_pos=()   # argv index of every pre-boundary `--args` fd token
boundary=-1   # argv index of the first `--` in option position
operand=-1    # argv index of the first bare operand (the no-`--` command form)
pidns=0       # an OPTION-position --unshare-pid/--unshare-all was seen
userns=0      # an OPTION-position --unshare-user/--unshare-all was seen
expose=0      # the setup stream mounts procfs at /proc (bind-family or --proc,
              # dest OR source side)
have_mask=0   # a `--tmpfs /proc` survives anywhere in the merged stream
i=0
while [ "$i" -lt "$argc" ]; do
  tok="${argv[$i]}"
  opt_kind "$tok"; kind="$OPT_KIND"
  if [ "$kind" = other ]; then case "$tok" in
    --unshare-pid) pidns=1 ;;
    --unshare-user) userns=1 ;;
    --unshare-all) pidns=1; userns=1 ;;
  esac; fi
  case "$kind" in
    boundary) boundary=$i; break ;;
    fd1|fd2)
      case "${argv[$((i + 1))]:-}" in
        ''|*[!0-9]*) ;;  # non-numeric: let real bwrap report it; nothing to keep
        *)
          preserve="$preserve ${argv[$((i + 1))]}"
          [ "$tok" = "--args" ] && args_pos+=("$((i + 1))")
          ;;
      esac
      # fd2's dest/pid arg on top — and for --bind-fd/--ro-bind-fd that arg
      # is a mount DEST: a procfs fd bound at /proc exposes procfs the same
      # way --bind does.
      [ "$kind" = fd2 ] && case "$tok" in
        --bind-fd|--ro-bind-fd)
          proc_dest "${argv[$((i + 2))]:-}" && expose=1 ;;
      esac
      i=$((i + 1))  # the fd VALUE token is consumed too
      [ "$kind" = fd2 ] && i=$((i + 1))
      ;;
    a1)
      [ "$tok" = "--proc" ] && expose=1
      [ "$tok" = "--tmpfs" ] && proc_dest "${argv[$((i + 1))]:-}" && have_mask=1
      i=$((i + 1)) ;;
    a2)
      case "$tok" in
        --bind|--bind-try|--dev-bind|--dev-bind-try|--ro-bind|--ro-bind-try)
          { proc_dest "${argv[$((i + 2))]:-}" || proc_src "${argv[$((i + 1))]:-}"; } && expose=1 ;;
      esac
      i=$((i + 2)) ;;
    a3) i=$((i + 3)) ;;
    operand) operand=$i; break ;;
    other) ;;                # unknown option — the zero-arg assumption above
  esac
  i=$((i + 1))
done

# Command-side fd refs in the OUTER argv (Arm A/C shapes).
if [ "$boundary" -ge 0 ]; then add_cmd_fd_refs "${argv[@]:$((boundary + 1))}"
elif [ "$operand" -ge 0 ]; then add_cmd_fd_refs "${argv[@]:$operand}"
fi

# ---- /proc mask realization (#10032), stage 1: consume --args payloads ----
# The SDK ships the setup argv NUL-separated on each `--args <fd>`. Read every
# PRE-boundary payload NOW — before the fd sweep — so an fd the payload names
# by path (or by fd-valued option) can still be preserved, and so the payload's
# own command-side tokens are scanned for `/proc/self/fd/N`. Read failures and
# EMPTY payloads both refuse: a silent empty re-emit would drop the whole setup
# argv — spawning effectively unmasked.
#
# Re-emit is SELECTIVE: each payload is filtered for procfs mounts at /proc
# right after its marks scan (a payload-internal `--` bounds only that
# payload's options — upstream parse_args_recurse resumes OUTER-argv option
# parsing after a payload ends, verified on bwrap 0.12.0 — so a tail bind
# inside a payload is still a merged-stream exposure). The last setup
# position of the MERGED stream is always in the outer argv — that is where
# any appended mask / re-home mounts go (stage 2).
nread=0
dropped=0     # procfs-mount-at-/proc ops removed across the merged stream
outer_expose=$expose   # stage-1 outer-walk exposure (payload merges below)
if [ "${#args_pos[@]}" -gt 0 ]; then
  for pos in "${args_pos[@]}"; do
    fd="${argv[$pos]}"
    declare -n "pl=pl$nread"
    pl=()
    mapfile -d '' -t pl <&"$fd" || fail "cannot read --args fd $fd"
    [ "${#pl[@]}" -gt 0 ] || fail "empty --args payload on fd $fd"
    eval "exec $fd<&-" 2>/dev/null || true
    read -r pboundary poperand ppidns puserns pexpose pmask pfds <<< "$(setup_marks "${pl[@]}")"
    [ -n "$pfds" ] && preserve="$preserve $pfds"
    [ "$ppidns" = 1 ] && pidns=1
    [ "$puserns" = 1 ] && userns=1
    [ "$pexpose" = 1 ] && expose=1
    [ "$pmask" = 1 ] && have_mask=1
    pcmd=$(( pboundary >= 0 ? pboundary + 1 : poperand >= 0 ? poperand : ${#pl[@]} ))
    [ "$pcmd" -lt "${#pl[@]}" ] && add_cmd_fd_refs "${pl[@]:$pcmd}"
    # Keep consuming: under upstream parse_args_recurse the OUTER parser
    # resumes option parsing after every payload, so a later --args payload
    # is still SETUP — its procfs exposure, namespace flags, and command-side
    # fd refs all count toward the merged stream. (An earlier version broke
    # here, which would have silently passed through a tail payload carrying
    # the very bind this rewrite exists to defeat.)
    # A nested --args inside the payload would recurse into a stream we
    # never filtered (upstream parse_args_recurse) — refuse rather than
    # pass an unfiltered nested stream through (security-review F2).
    for tok in "${pl[@]}"; do
      [ "$tok" = "--args" ] &&         fail "nested --args inside an --args payload cannot be filtered — refusing"
    done
    filter_proc_exposure pl
    dropped=$((dropped + FDROPPED))
    [ "$FMASK" = 1 ] && have_mask=1
    unset -n pl
    nread=$((nread + 1))
  done
fi

# Neutralize the outer argv the same way — only when ITS walk flagged an
# exposure (outer_expose is the stage-1 outer-walk value, before payload
# merges; a payload-only exposure leaves the outer argv unchanged, so the
# filter and the position rescan are both dead walks — perf F6). When the
# filter ran, dropped runs shift every index after them → rescan_outer.
if [ "$outer_expose" = 1 ]; then
  filter_proc_exposure argv
  dropped=$((dropped + FDROPPED))
  rescan_outer
fi

# The rewrite engages when the merged setup mounts procfs at /proc.
# Detection and drop must agree by construction (shared proc_dest); a
# divergence — exposure flagged but nothing removed — is a filter defect,
# refuse rather than trust the flag's complement (review C1 belt).
[ "$expose" = 1 ] && [ "$dropped" -eq 0 ] &&   fail "proc exposure detected but neutralization dropped nothing — detection divergence, refusing"
# An exposed argv we cannot neutralize refuses:
#   - pidns: preserved from the #9723 contract — the vendored shape always
#     carries it; a procfs-mount argv without it is an anomaly worth
#     refusing rather than silently re-shaping.
#   - userns: unprivileged bwrap cannot apply ANY mount (the appended tmpfs
#     or a re-home bind) without a user namespace.
# Command-side /proc/self/fd refs need mounts too — refuse a re-home argv
# that cannot mount. Argvs with neither exposure nor refs (e.g. the deploy
# probe) pass through unmasked.
if [ "$expose" = 1 ]; then
  [ "$pidns" = 1 ] || fail "merged setup argv mounts /proc but lacks --unshare-pid/--unshare-all — refusing a proc exposure rewrite on an anomalous shape"
  [ "$userns" = 1 ] || fail "merged setup argv mounts /proc but lacks --unshare-user/--unshare-all — refusing a proc exposure it cannot neutralize"
fi
[ -n "$cmd_fd_refs" ] && [ "$userns" != 1 ] && \
  fail "command-side /proc/self/fd refs need re-home mounts but the argv lacks --unshare-user/--unshare-all — refusing"

[ -x "$REAL" ] || fail "real bwrap not executable: $REAL"
[ -r "$BPF" ] || fail "seccomp artifact not readable: $BPF"

# Open the filter BEFORE the sweep (auto-allocated fd ≥10, no collision with a
# preserved SDK fd). The `|| fail` arm IS live here — bash runs the fallback on
# a failed `exec` redirection (verified bash 5.2: `exec 9</missing || echo`
# prints) — while `set -e` is absent so the `-r` pre-check stays primary.
exec {bpf_fd}<"$BPF" || fail "cannot open seccomp artifact: $BPF"

# Re-home resolution — BEFORE the sweep, while every command-side fd is still
# open. For each unique N in cmd_fd_refs: readlink /proc/self/fd/N and emit
# the mount tokens for the literal dest. Prod's bwrap 0.8.0 leaves exactly
# one viable rung — --ro-bind of the resolved real path (the vendored
# multicall fd is an /proc/self/exe handle on the CLI binary); --bind-data
# EBADFs at write there, --bind-fd parses but cannot resolve its fd source,
# and binding /proc/self/fd/N itself fails because real bwrap never sees
# that fd. Deleted sources, pipes, sockets, anon inodes, and unreadable or
# absent fds all REFUSE — never a silently-dead multicall path.
rehome=()
declare -A _refseen=()
for n in $cmd_fd_refs; do
  [ -n "${_refseen[$n]:-}" ] && continue
  _refseen[$n]=1
  # A ref naming an fd that is NOT open in the shim cannot be a live
  # vendored multicall ref (its fd is always open) — it is a command-side
  # MENTION (a path inside an arg or -c string). Skip rather than refuse:
  # inside the sandbox it ENOENTs, the same outcome the command had
  # pre-#10032, and refusing every mention is a spawn-DoS (security F5 /
  # agent-native W1). Open-but-unresolvable fds still refuse below.
  tgt="$(readlink "/proc/self/fd/$n" 2>/dev/null)" || continue
  case "$tgt" in
    *" (deleted)")
      fail "command-side /proc/self/fd/$n resolves to a deleted path — no viable re-home rung on bwrap 0.8.0" ;;
    pipe:*|socket:*|anon_inode:*|"")
      fail "command-side /proc/self/fd/$n resolves to ${tgt%%:*} — cannot re-home a non-file fd" ;;
    /proc|/proc/*)
      # A procfs-resident source is never a legitimate re-home target —
      # binding it would carry host procfs content INTO the mask the
      # neutralization just built. Refuse rather than re-expose.
      fail "command-side /proc/self/fd/$n resolves to a procfs path $tgt — refusing to bind host procfs content into the mask" ;;
    /sys|/sys/*)
      fail "command-side /proc/self/fd/$n resolves to a sysfs path $tgt — refusing" ;;
    *)
      # $tgt is canonical at readlink time; real bwrap re-resolves at mount
      # time — the contract trusts the resolved source to be
      # non-tenant-writable (the vendored fd resolves to the CLI binary
      # under image-controlled /app). A tenant-writable tgt path component
      # would be a TOCTOU re-exposure window — refuse is the documented
      # answer if the vendored fd ever resolves under a workspace root
      # (security-review F6).
      [ -r "/proc/self/fd/$n" ] || \
        fail "command-side /proc/self/fd/$n resolves to $tgt but is unreadable — cannot re-home"
      rehome+=(--ro-bind "$tgt" "/proc/self/fd/$n") ;;
  esac
done

# A glob that matches nothing iterates once on the literal `*` and sweeps
# ZERO fds — every inherited fd would leak into the sandbox unfiltered.
# Fail closed rather than silently degrading to no fd hygiene.
[ -d /proc/self/fd ] || fail "cannot enumerate /proc/self/fd"

for p in /proc/self/fd/*; do
  n=${p##*/}
  case "$n" in
    ''|*[!0-9]*) continue ;;
  esac
  [ "$n" -gt 2 ] 2>/dev/null || continue
  [ "$n" = "$bpf_fd" ] && continue
  case " $preserve " in *" $n "*) continue ;; esac
  # The script's own fd must survive the sweep (bash re-reads a long script);
  # -ef compares inode identity in-process — no per-fd readlink fork.
  [ "$p" -ef "$0" ] && continue
  eval "exec $n>&-" 2>/dev/null || true
done

# ---- /proc mask realization (#10032), stage 2: emit + payload re-emit ----
# The emit lands at the LAST setup position of the MERGED stream (outer
# argv): first an appended `--tmpfs /proc` when the stream dropped an
# exposure but carries no mask of its own (a `--ro-bind / /` root would
# otherwise re-expose host procfs), then the re-home mounts — the tmpfs
# must precede them or it would cover their dests (and they must be
# creatable under it). Read payloads are re-emitted on fresh POST-SWEEP
# fds and the argv renumbered — a payload filtered down to NOTHING emits
# zero bytes (a `printf '%s\0'` on the empty array would emit a lone NUL:
# one empty-string token real bwrap would parse as an operand).
emit=()
if [ "$dropped" -gt 0 ] || [ -n "$cmd_fd_refs" ]; then
  [ "$have_mask" -eq 0 ] && emit+=(--tmpfs /proc)
  emit+=("${rehome[@]}")
fi
if [ "${#emit[@]}" -gt 0 ]; then
  if [ "$boundary" -ge 0 ]; then
    argv=("${argv[@]:0:$boundary}" "${emit[@]}" "${argv[@]:$boundary}")
  elif [ "$operand" -ge 0 ]; then
    argv=("${argv[@]:0:$operand}" "${emit[@]}" "${argv[@]:$operand}")
  else
    argv+=("${emit[@]}")
  fi
fi
# INVARIANT: every args_pos entry precedes every splice point (the outer walk
# stops at boundary/operand), so mutating argv before renumbering is safe —
# do not reorder the splice and re-emit blocks.
if [ "$nread" -gt 0 ]; then
  k=0
  while [ "$k" -lt "$nread" ]; do
    declare -n "pl=pl$k"
    if [ "${#pl[@]}" -eq 0 ]; then
      exec {newfd}</dev/null || fail "cannot re-emit --args payload ${args_pos[$k]}"
    else
      exec {newfd}< <(printf '%s\0' "${pl[@]}") || fail "cannot re-emit --args payload ${args_pos[$k]}"
    fi
    argv[${args_pos[$k]}]=$newfd
    unset -n pl
    k=$((k + 1))
  done
fi

exec "$REAL" --add-seccomp-fd "$bpf_fd" "${argv[@]}"
