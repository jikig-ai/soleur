#!/usr/bin/bash
# bwrap PATH shim (#8752) — the Agent SDK spawns PATH-resolved `bwrap` (the
# vendored argv builder's fd-passing contract is set in stone), so this shim
# gives the agent sandbox what we control directly in the C4 chain:
#
#   1. inherited-fd hygiene — every fd above stderr that the argv does not
#      reference is closed before the real bwrap runs (bwrap and libuv close
#      nothing; a leaked socket/secret fd was measured reachable inside the
#      sandbox).
#   2. the shared nested-userns seccomp filter, injected as --add-seccomp-fd
#      (repeatable, stacks with any future SDK filter; a hypothetical SDK
#      --seccomp conflicts loudly at parse time instead of silently
#      last-wins-overriding ours).
#
# Fd-contract notes:
#   * `--args FD` carries the whole setup argv NUL-separated on a pipe. The fd
#     is preserved (it is argv-referenced); its CONTENT is not inspected —
#     reading a pipe would consume it. Any fd-referencing option a future SDK
#     emits inside the payload stays invisible here; the deploy canary's
#     replay is the load-bearing tripwire for that shape change.
#   * The filter fd is auto-allocated (`exec {v}<`) so it cannot collide with
#     an SDK-chosen fd number.
#   * This script's own fd is preserved: bash reads it lazily, and the sweep
#     would truncate the script mid-parse.
#
# Fail-closed: any setup anomaly exits 65 with a `bwrap-shim:` stderr marker —
# never fall back to an unfiltered/unscrubbed spawn.

set -u

REAL=${SOLEUR_BWRAP_REAL:-/usr/bin/bwrap}
BPF=${SOLEUR_BWRAP_SECCOMP_BPF:-/app/infra/bwrap-userns-clone3-deny.bpf}

fail() {
  printf 'bwrap-shim: %s\n' "$1" >&2
  exit 65
}

# Probe passthrough: the SDK checks availability with `bwrap --version`
# (failIfUnavailable). A lone probe builds no sandbox — exec verbatim.
if [ "$#" -le 1 ]; then
  case "${1:-}" in
    --version|--help|"") [ -x "$REAL" ] || fail "real bwrap not executable: $REAL"
                         exec "$REAL" "$@" ;;
  esac
fi

# Preserve-set: fds the outer argv references by number. The scan is
# ARITY-AWARE, not prev-token — a value-position token that happens to equal
# an fd-option name (`--setenv --args 9`) must not preserve an fd, and an
# option must not eat another option's value.
#
#   fd1: arg1 is an fd, nothing else consumed.
#   fd2: arg1 is an fd, arg2 (dest/pid) also consumed.
#   a1/a2/a3: non-fd options consuming 1/2/3 tokens — their values are SKIPPED
#     so a flag-named value can't desync the scan.
#
# Known limits: `--opt=value` equals-forms are invisible to this scan
# (getopt accepts them; a future SDK emitting `--args=5` would strand that
# fd — fail-closed, loudly); an option this table doesn't know can still
# desync after it (over-preserve — the leak direction, so conservative).
# BWRAP_FD_VALUED_OPTS (scripts/sandbox-canary.mjs) mirrors the fd sets —
# asserted byte-identical by sandbox-canary-regression.test.sh §D4.
preserve=""
expect_fd=0
skip=0
extra_skip=0
for tok in "$@"; do
  # Stop at the command boundary: tokens after `--` are the sandboxed
  # command, not options — a literal `--sync-fd 7` there must not pin an
  # fd open (over-preserve IS the leak direction; under-preserve is loud).
  [ "$tok" = "--" ] && break
  if [ "$skip" -gt 0 ]; then skip=$((skip - 1)); continue; fi
  if [ "$expect_fd" = 1 ]; then
    case "$tok" in
      ''|*[!0-9]*) ;;  # non-numeric: let real bwrap report it; nothing to keep
      *) preserve="$preserve $tok" ;;
    esac
    expect_fd=0
    skip=$extra_skip
    extra_skip=0
    continue
  fi
  case "$tok" in
    --args|--seccomp|--add-seccomp-fd|--sync-fd|--info-fd|--json-status-fd|--block-fd|--userns-block-fd|--userns|--pidns) expect_fd=1 ;;
    --file|--bind-data|--ro-bind-data|--bind-fd|--ro-bind-fd|--userns2) expect_fd=1; extra_skip=1 ;;
    --argv0|--uid|--gid|--hostname|--chdir|--unsetenv|--lock-file|--remount-ro|--overlay-src|--tmp-overlay|--ro-overlay|--exec-label|--file-label|--proc|--dev|--tmpfs|--mqueue|--dir|--cap-add|--cap-drop|--perms|--size) skip=1 ;;
    --setenv|--bind|--bind-try|--dev-bind|--dev-bind-try|--ro-bind|--ro-bind-try|--chmod|--symlink|--level-prefix) skip=2 ;;
    --overlay) skip=3 ;;
  esac
done

[ -x "$REAL" ] || fail "real bwrap not executable: $REAL"
[ -r "$BPF" ] || fail "seccomp artifact not readable: $BPF"

# Open the filter BEFORE the sweep (auto-allocated fd ≥10, no collision with a
# preserved SDK fd). The `|| fail` arm IS live here — bash runs the fallback on
# a failed `exec` redirection (verified bash 5.2: `exec 9</missing || echo`
# prints) — while `set -e` is absent so the `-r` pre-check stays primary.
exec {bpf_fd}<"$BPF" || fail "cannot open seccomp artifact: $BPF"

for p in /proc/self/fd/*; do
  n=${p##*/}
  case "$n" in
    ''|*[!0-9]*) continue ;;
  esac
  [ "$n" -gt 2 ] 2>/dev/null || continue
  [ "$n" = "$bpf_fd" ] && continue
  case " $preserve " in *" $n "*) continue ;; esac
  # The script's own fd must survive the sweep (bash re-reads a long script);
  # -ef compares inode identity in-process — no per-fd readlink fork.
  [ "$p" -ef "$0" ] && continue
  eval "exec $n>&-" 2>/dev/null || true
done

exec "$REAL" --add-seccomp-fd "$bpf_fd" "$@"
