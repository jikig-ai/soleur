[Unit]
Description=Inngest cutover flip oneshot (FSM: armed->flipping->done / rollback; #6178)
After=network-online.target
Wants=network-online.target
# (#7228 P0-5) The monotonic re-flush latch lives on the durable Hetzner volume at
# /mnt/data/inngest-cutover/, and the flip timer fires every 30s from boot — so this unit wants
# to run AFTER the mount lands, or a latch written pre-mount would sit on the ephemeral root
# disk looking durable.
#
# ORDERING ONLY, deliberately downgraded from RequiresMountsFor= (#7228 review).
# RequiresMountsFor= is Requires-strength: it makes the WHOLE oneshot un-startable when the
# volume is absent. But cloud-init mounts /mnt/data with `|| true` under fstab `nofail`, i.e. a
# failed mount is an expected-survivable state — and the oneshot's other arms need no volume at
# all. In particular `rollback` only stops the server and writes the flag, and on a host with no
# inbound SSH the flag poll is the ONLY control channel. Requiring the mount therefore deleted
# the operator's sole means of stopping a scheduler on exactly the host that was already
# degraded, and replaced the script's LOUD abort (a latch-unrecordable marker) with a silent
# systemd dependency failure that emits none of the FSM's markers.
# The hazard it was added for — a latch written pre-mount looking durable on the root disk — is
# now gated in-script at the top of run_preflush_flip, before anything destructive, with its own
# reason token. After= keeps the ordering benefit on a healthy boot and costs nothing on a
# broken one.
After=mnt-data.mount

[Service]
Type=oneshot
# BOUNDS AN OTHERWISE UNBOUNDED ONESHOT. Note the direction carefully, because two review
# agents got it backwards and agreed with each other: for Type=oneshot systemd does NOT apply
# DefaultTimeoutStartSec — systemd.service(5) says the timeout is "disabled by default" for
# exactly this type. So the risk here was never that the 240s verify window gets truncated at
# 90s; it is that a hang ANYWHERE in this script (a stalled `doppler secrets set`, a wedged
# `systemctl stop`) leaves the unit in `activating` FOREVER. The 30s timer cannot re-fire while
# the unit is active, so the FSM stops polling with no marker emitted and no terminal flag —
# and op=arm's G6 then reports "no terminal FSM flag within 600s", which is the same
# non-convergence signature #7228 produced.
# 420 clears the 240s window plus the stop/flush/assert work preceding it, so a legitimate slow
# cutover completes while a genuine hang is killed and retried on the next timer tick.
# Every sibling oneshot in this directory bounds itself (cron-egress-firewall 300, git-data-gc
# 3600, container-restart-monitor 120); this unit was the outlier.
# inngest-cutover-flip.test.sh pins window < TimeoutStartSec, extracting both operands by shape.
TimeoutStartSec=420
# Runs as ROOT (no User=): the flip must `systemctl stop/start inngest-server.service`
# and write the /var/lock state slot — a privileged control op, unlike the deploy-scoped
# server/heartbeat units. HOME=/root is set so the Doppler CLI's os.UserHomeDir() init
# does not fail with "$HOME is not defined" (the reason the deploy-user units set User=).
Environment=HOME=/root
# SANDBOXING (#7761). This unit runs as root and wraps `doppler run`, and it was the only
# root-doppler unit in the repo with no sandboxing at all. The shape converges on
# git-data-gc.service:57-66, which this unit had previously copied only the HOME= line from.
#
# ProtectHome is deliberately NOT set: git-data-gc.service:63-64 records that it masks /root
# inside the unit's namespace, which defeats the Environment=HOME=/root above and breaks the
# Doppler CLI's os.UserHomeDir() init.
#
# PrivateTmp is spelled `true`, not the `yes` git-data-gc.service uses. That file is the lone
# `yes` in the repo; every inngest-family unit uses `true`, and inngest.test.sh:232 asserts
# `^PrivateTmp=true$` by regex. /etc/default/inngest-server sets DOPPLER_CONFIG_DIR=/tmp/.doppler,
# and inngest-bootstrap.sh:372-388 records why that path is only safe under a private /tmp.
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=true
# WRITABLE PATHS — the sharp edge of this block, because the obvious spelling is wrong twice.
# The script writes three paths, and neither /var/lib/inngest-cutover nor
# /mnt/data/inngest-cutover exists on a fresh host; their only creators are the lazy `mkdir -p`
# inside the script itself (:247 and :432).
#   * Naming a non-existent directory in ReadWritePaths= makes systemd fail mount-namespace
#     setup, so the unit would die on EVERY 30s fire after a host replace — no marker, on the
#     one host with no other control channel.
#   * `-`-prefixing does not rescue it: the path is then simply not made writable, so under
#     ProtectSystem=strict the script's own `mkdir -p` hits a read-only filesystem and the FSM
#     aborts `latch-unrecordable` on every fire instead.
# So: StateDirectory makes systemd itself create and rw-mount /var/lib/inngest-cutover (the
# DONE_OWNER_MARKER dir at :240), and ReadWritePaths names the MOUNTS — /var/lock for the state
# slot at :62, /mnt/data for the flip-done latch at :387 — never the subdirectories the script
# creates inside them. /mnt/data is created unconditionally by cloud-init-inngest.yml:323
# (`mkdir -p /mnt/data`, before the `nofail` mount), so it resolves even when the volume is absent.
StateDirectory=inngest-cutover
ReadWritePaths=/var/lock /mnt/data
# EnvironmentFile carries DOPPLER_TOKEN + DOPPLER_CONFIG_DIR so `doppler run` (and the
# script's `doppler secrets set` flag transitions) authenticate against soleur-inngest/prd.
EnvironmentFile=/etc/default/inngest-server
# doppler run injects INNGEST_CUTOVER_FLIP (the FSM flag) + INNGEST_REDIS_PASSWORD (for
# the loopback redis-cli FLUSHALL/DBSIZE) into the script's env. The Doppler project is
# resolved from DOPPLER_PROJECT in EnvironmentFile=/etc/default/inngest-server (#6555; the
# dedicated host sets soleur-inngest) — no --project flag.
#
# --only-secrets IS THE PRIMARY CONTROL FOR #7761, not hygiene. A bare `doppler run` injects the
# WHOLE soleur-inngest/prd config, so any name in that config lands in the environment of a
# root script — which made Doppler *config-write access* equivalent to arbitrary command
# execution as root here, at the next 30s poll, inside the same unit that performs the
# irreversible FLUSHALL. The script's argv gate (--fixture-seams) closes the seams the script
# itself reads; only this flag reaches the names bash honours WITHOUT the script ever naming
# them — BASH_ENV, PATH, LD_PRELOAD, IFS — because it filters before exec rather than after.
# Measured against live Doppler 2026-09-03: bare injects 10 names including INNGEST_POSTGRES_URI
# (the production DSN); this form injects exactly INNGEST_CUTOVER_FLIP + INNGEST_REDIS_PASSWORD
# (plus the DOPPLER_PROJECT/CONFIG/ENVIRONMENT trio doppler sets itself regardless of the flag).
#
# --no-exit-on-missing-only-secrets DIVERGES FROM HOUSE CONVENTION ON PURPOSE, and the reason is
# `noop-unset`. INNGEST_CUTOVER_FLIP is legitimately ABSENT on a pre-arm host — that is a
# designed FSM state, not an error. Measured: without this flag doppler exits 1 on a
# listed-but-absent name, which would stop the 30-second poll dead on exactly the hosts that
# have not been armed yet. Deleting this flag as hygiene breaks the FSM. The trade is that a
# MIS-AUTHORED list degrades quietly rather than loudly, which is why the list above is authored
# and commented rather than derived — see the plan's Guard 2 section. It is not wholly silent:
# doppler still emits a `Warning:` naming the missing secret, which rides journald to Better Stack.
#
# The on-disk encrypted fallback cache is deliberately left ENABLED (see the plan's Alternatives
# row H). The flag that would disable it is NOT written here, and this comment deliberately does
# not spell that flag: a body-grep sees comments too, so naming it in prose would false-trip the
# very assertion that checks it is absent (cq-assert-anchor-not-bare-token).
# All flags sit AFTER `--config prd` so inngest.test.sh:1570-1571's contiguous-substring
# assertion on `doppler run --config prd` still matches, and BEFORE the `--` so they are
# doppler's flags rather than the script's arguments.
ExecStart=/usr/bin/doppler run --config prd \
  --only-secrets INNGEST_CUTOVER_FLIP \
  --only-secrets INNGEST_REDIS_PASSWORD \
  --no-exit-on-missing-only-secrets \
  -- /usr/local/bin/inngest-cutover-flip.sh

[Install]
WantedBy=multi-user.target
