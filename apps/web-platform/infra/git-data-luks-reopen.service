[Unit]
# (#8210) Reopen the git-data LUKS mapper from a Doppler-delivered key on EVERY boot. The
# birth heredoc opens it once per instance (cloud-init runcmd) and the fstab line is `nofail`,
# so without this unit a reboot left /mnt/git-data-luks without its backing device, silently.
# ADR-115 amendment: this oneshot is the accepted equivalent of the crypttab/keyscript the
# blocker named; ADR-198 amendment: the passphrase is fetched at boot, never baked.
Description=Reopen the git-data LUKS mapper from Doppler on every boot (#8210)
Documentation=https://github.com/jikig-ai/soleur/issues/8210
Wants=network-online.target
After=network-online.target
# A [Unit] directive (git-data-gc.service records the verify-caught misplacement). Fires ONCE,
# when the unit reaches its FINAL failed state after the bounded restarts below — BECAUSE OF
# RestartMode=direct in [Service], not by default. An earlier revision of this comment said
# service_enter_dead() suppresses OnFailure while an auto-restart is pending; measured on 261
# (review), the DEFAULT RestartMode=normal does the opposite: the unit passes through `failed`
# before every auto-restart and OnFailure fires on EVERY attempt plus the terminal one — six
# fatals per exhausted ladder, and a transient blip that recovered on attempt 2 still paged.
# systemd 254 added RestartMode=direct precisely so "OnSuccess=/OnFailure= units will not be
# triggered until the service state has converged" (NEWS); Ubuntu 24.04 ships 255.
OnFailure=git-data-luks-reopen-failure.service
# Five attempts in an hour absorb a transient Doppler/DNS blip at boot without an in-script
# retry loop (a retrying guard hides its instrument fault); the sixth is the terminal failure
# the reporter ships.
StartLimitIntervalSec=1h
StartLimitBurst=5

[Service]
Type=oneshot
RemainAfterExit=yes
# Allowed for Type=oneshot: systemd's service.c rejects only always|on-success. Measured on
# 255 and 261: Result/ExecMainStatus/ExecMainCode/NRestarts all survive start-limit-hit.
Restart=on-failure
# direct: no failed/inactive transit between attempts, so OnFailure= fires exactly once, at
# convergence (measured on 261: 1 reporter run per ladder vs 3 for a 2-burst ladder under the
# default). Two consequences the rest of the payload is shaped around: (1) the unit reads
# `activating` for the WHOLE ladder, so the arm item starts it with --no-block and
# git-data-bootstrap.sh's 420 s `activating` wait is the single bound on the boot path;
# (2) a tick from git-data-luks-reopen.timer inside the still-open StartLimitIntervalSec is
# refused as start-limit-hit on an already-failed unit and fires NOTHING (also measured), so
# recovery granularity is that window, not the tick.
RestartMode=direct
RestartSec=60
# The emit phase's STRUCTURAL refusal (git-data-luks-reopen.sh exits 3 when the success
# emitter is absent, not executable, or reports its own structural fault) must not be
# retried: attempt 2 would find the store open and mounted, take the silent noop branch, exit
# 0, and leave the unit active(exited) — the fault erased, the boolean reading yes. Measured
# on 261: with this directive the unit goes `failed` at once, NRestarts=0, ExecMainStatus=3.
RestartPreventExitStatus=3
# HOME is REQUIRED for `doppler run` under a root unit (the CLI dies "$HOME is not defined").
Environment=HOME=/root
# TMPDIR on tmpfs, load-bearing: git-data-emit's _devalue writes the sed-escaped passphrase to
# mktemp before rm -f. On a disk-backed /tmp that is a root-disk write of the key, and
# PrivateTmp only bind-mounts a subdirectory of the same device. The RuntimeDirectory below
# is tmpfs by construction.
Environment=TMPDIR=/run/git-data-luks-reopen
# EnvironmentFile=- not `. <file>`: an absent token file fails inside `doppler run`, which the
# reporter reports; a failed dot-source in dash kills the shell first. The file carries
# DOPPLER_TOKEN (the read-only service token scoped to this host's own config),
# GIT_DATA_LUKS_DEV (the by-id pin) and GIT_DATA_DOPPLER_CONFIG (templated: the rung-2
# rehearsal scopes its token to a per-run scratch config, so a hardcoded production config
# name here would exit 1 with the key absent on every rehearsal reboot). The config name is
# deliberately absent from this file as a LITERAL, comments included — git-data-luks.test.sh's
# config-scope census is not line-anchored, so a name in prose is a name in the census.
EnvironmentFile=-/etc/default/git-data-doppler
# The script's phase file + stderr log live here. RuntimeDirectoryPreserve=yes is MANDATORY:
# measured on 255, systemd removes the directory when the unit reaches its final failed
# state — BEFORE OnFailure= runs — so without it the reporter reads nothing and every failure
# class collapses to action=unit.
RuntimeDirectory=git-data-luks-reopen
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=yes
# cryptsetup holds the passphrase and doppler holds the resolved secret set; a crash under
# apport would write process memory to /var/crash on the ROOT DISK. Free to close (review).
LimitCORE=0
# Per-attempt reset so a mixed-cause restart sequence (attempt 1 dies at open, attempts 2-5
# die inside doppler run) reports the FINAL cause, not a stale first one.
ExecStartPre=/bin/rm -f /run/git-data-luks-reopen/action /run/git-data-luks-reopen/log
# The git-data-gc.service shape: /bin/sh keeps `systemd-analyze verify` green on runners
# without doppler; the inner path is absolute. --only-secrets (repeated form) narrows the
# injected env to the two names the script and the emitter read; --no-fallback declines
# Doppler's on-disk encrypted fallback cache, which would otherwise write the resolved
# passphrase under $DOPPLER_CONFIG_DIR on the root disk. --config is the templated name.
ExecStart=/bin/sh -c 'exec /usr/local/bin/doppler run --project soleur --config "$GIT_DATA_DOPPLER_CONFIG" --only-secrets GIT_DATA_LUKS_KEY --only-secrets BETTERSTACK_LOGS_TOKEN --no-fallback -- /usr/local/bin/git-data-luks-reopen.sh'
# Doppler at boot + a 30 s device wait + the mount job, PER ATTEMPT. On the boot path nothing
# blocks on this: the arm item starts the unit with --no-block and the bootstrap's 420 s
# `activating` wait is the only bound (review found the earlier "at most this long" claim
# stacked with that wait to 720 s against a ~610 s birth poll). After a hard reset the fstab
# `pass=2` fsck runs inside this bound too: a forced full e2fsck on a large, error-flagged
# volume that exceeds it reports action=mount result=timeout while PID 1's mount completes
# — the runbook's mount row names that reading.
TimeoutStartSec=300
TimeoutStopSec=30
# Confines /tmp/.doppler. NOT ProtectSystem=strict: cryptsetup needs /run/cryptsetup and the
# reporter reads /run/git-data-luks-reopen; both would need ReadWritePaths= on a unit whose
# script writes nothing else.
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
