node_modules
.env*
# The deps stage runs `npm ci` BEFORE `COPY . .`, and no dependency-resolving npm
# command runs after it — so .npmrc's release-age floor never applies inside the image.
# That invariant was previously unguarded (Dockerfile:10 is `COPY . .`, which would
# otherwise copy .npmrc in); this line makes it explicit rather than incidental.
.npmrc

# Terraform configs, not needed at runtime
infra/
# Re-include the GitHub App manifest (#4115) — page.tsx at
# /internal/github-app-init statically imports it at build time via
# `import manifest from "@/infra/github-app-manifest.json"`. The drift-guard
# cron is the runtime source of truth for divergence; the build-time inline
# guarantees the page always renders the committed manifest, not a runtime
# FS read. Excluding the JSON file shrinks the build context by 28 lines —
# leaving it in is harmless to the runtime image.
!infra/github-app-manifest.json
# Re-include the faithful sandbox canary argv fixture (#5875 / ADR-079). The
# Dockerfile runner stage bakes it in (`COPY --from=builder
# /app/infra/sandbox-canary-argv.json`) so ci-deploy.sh's in-container replay
# can read it with no network; without this re-include the builder-stage
# `COPY . .` drops it and the runner COPY fails the image build.
!infra/sandbox-canary-argv.json
# Re-include the host-bootstrap scripts baked into the image (#5921 / ADR-080).
# The Dockerfile runner stage bakes these into /opt/soleur/host-scripts/ via
# `COPY --from=builder /app/infra/<file>` so cloud-init can `docker cp` the set
# onto a fresh Hetzner host (externalized out of the 32 KB user_data cap). The
# `infra/` exclude above drops them from the builder-stage `COPY . .`, so each
# baked file MUST be re-included here or the runner COPY fails the image build
# (the #5922 release break). Keep this list in lockstep with the Dockerfile
# baked-set COPY and the server.tf host-scripts set — the
# cloud-init-user-data-size.test.ts guard asserts the three stay in parity.
!infra/ci-deploy.sh
!infra/ci-deploy-wrapper.sh
!infra/cat-deploy-state.sh
!infra/canary-bundle-claim-check.sh
!infra/disk-monitor.sh
!infra/resource-monitor.sh
!infra/container-restart-monitor.sh
!infra/container-restart-monitor.service
!infra/container-restart-monitor.timer
!infra/infra-config-apply.sh
!infra/infra-config-install.sh
!infra/cat-infra-config-state.sh
!infra/cron-egress-nftables.sh
!infra/cron-egress-resolve.sh
!infra/cron-egress-alarm.sh
!infra/cron-egress-allowlist.txt
!infra/cron-egress-allowlist-cidr.txt
!infra/cron-egress-firewall.service
!infra/cron-egress-resolve.service
!infra/cron-egress-resolve.timer
!infra/cron-egress-alarm@.service
!infra/cron-egress-postapply-assert.sh
!infra/cron-egress-enforce-probe.sh
!infra/hooks.json.tmpl
!infra/journald-soleur.conf
!infra/soleur-host-bootstrap.sh
!infra/cosign-trusted-root.json
!infra/vector.toml
!infra/seccomp-bwrap.json
!infra/apparmor-soleur-bwrap.profile
!infra/orphan-reaper.sh
!infra/orphan-reaper.service
!infra/orphan-reaper.timer
!infra/99-bwrap-userns.conf
!infra/bwrap-userns-sysctl.service
!infra/web-private-nic-guard.sh
!infra/web-private-nic-guard.service
!infra/web-private-nic-guard.timer
!infra/web-zot-consumer-probe.sh
!infra/web-zot-consumer-probe.service
!infra/web-zot-consumer-probe.timer
!infra/web-git-data-probe.sh
!infra/web-git-data-probe.service
!infra/web-git-data-probe.timer
!infra/web-probe-envwrite.sh
# (#7228) Consumer-side detection for the dark-bind outage. Three coupled surfaces must agree
# or the probe ships undelivered: server.tf's baked set, the Dockerfile COPY, and this
# re-include — `COPY . .` drops anything the ignore file excludes, so a file baked in the two
# places above and missing here is silently absent from the image.
!infra/inngest-consumer-probe.sh
!infra/inngest-consumer-probe.service
!infra/inngest-consumer-probe.timer
!infra/inngest-registry-probe.sh
scripts/
# Allow the post-build dev-signin grep gate (R3 / feat-dev-signin-bypass).
# The Dockerfile builder stage runs `bash scripts/assert-dev-signin-eliminated.sh`
# immediately after `npm run build`; without this re-include the script is
# excluded from the build context and the RUN step exits 127 (file not
# found), failing the prd image build. The runner stage is a separate
# `FROM` so this re-include does NOT bloat the runtime image.
!scripts/assert-dev-signin-eliminated.sh
# Re-include the faithful sandbox canary payload (#5875 / ADR-079). The
# Dockerfile runner stage bakes it in (`COPY --from=builder
# /app/scripts/sandbox-canary.mjs`) so ci-deploy.sh can `docker exec` it inside
# the canary container; without this re-include the builder-stage `COPY . .`
# drops it and the runner COPY fails the image build (the #5890 release break).
!scripts/sandbox-canary.mjs

.git
.gitignore
*.md

test/
# ...but vitest.config.ts is NOT excluded, it sits at the context root, and
# `next build` type-checks it. Since #7666 it imports ./test/repo-wide-suites,
# so pruning the whole directory left a build-INCLUDED file importing a
# build-EXCLUDED module: `Cannot find module './test/repo-wide-suites'`.
#
# Local `tsc` and the CI `test` job both see a complete tree and pass; only the
# image build sees the pruned one. That asymmetry is why this cleared every
# pre-merge gate and still failed 8 consecutive releases (2026-08-20 -> 08-26),
# leaving prod on a stale build for six days.
#
# Same shape and same remedy as !scripts/sandbox-canary.mjs above (#5890).
# The file is an 84-line pure-data manifest with zero imports, so re-including
# it cannot cascade. test/docker-context-import-containment.test.ts asserts this
# re-include stays in step with what vitest.config.ts actually imports.
!test/repo-wide-suites.ts

# Migrations/templates not needed at runtime
supabase/

.next/
out/

*.pem
*.tsbuildinfo
next-env.d.ts

Dockerfile
.dockerignore
docker-compose*.yml

# Vendored plugin tree (#3045) — allowlist specific file types only.
#
# `!_plugin-vendored/` (bare directory bang) is a *recursive* re-include in
# Docker .dockerignore semantics: it pulls in ALL children regardless of
# extension, so the per-extension lines below it become no-ops. The Bun-
# specific `import.meta.path` in plugins/soleur/skills/ux-audit/scripts/
# bot-fixture.ts then trips Next.js's strict TS pass during `npm run build`
# — the 1edf7a62 release failed for exactly this reason.
#
# Correct allowlist pattern: exclude everything inside the dir first, then
# bang specific patterns we ship. Children of an excluded dir are reachable
# only when the dir itself is also banged back in (`!_plugin-vendored/`).
_plugin-vendored/**
!_plugin-vendored/
!_plugin-vendored/**/.claude-plugin/
!_plugin-vendored/**/.claude-plugin/**
!_plugin-vendored/**/*.md
!_plugin-vendored/**/*.json
!_plugin-vendored/**/*.njk
!_plugin-vendored/**/*.yml
!_plugin-vendored/**/*.yaml
!_plugin-vendored/**/*.sh
!_plugin-vendored/**/*.txt
